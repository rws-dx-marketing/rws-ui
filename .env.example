# Public Mapbox token (pk.…) for the office maps at /about/offices/. Ships to the
# browser — Astro inlines every PUBLIC_-prefixed var into the client bundle — so
# keep it read-only and add URL restrictions in the Mapbox account settings.
PUBLIC_MAPBOX_TOKEN=

# Secret Mapbox token (sk.…) for account admin only: uploading and deleting the
# Articulat CF faces the map style depends on, via the Fonts API. Never rename
# this with a PUBLIC_ prefix — without one it stays out of the client bundle.
SECRET_MAPBOX_TOKEN=
