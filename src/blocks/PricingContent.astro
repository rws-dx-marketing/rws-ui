---
// @ts-nocheck
export interface Props {
	// When set, the page is locked to a single audience segment: the segment
	// picker is hidden and only that segment's products/columns are rendered.
	// Accepts the segment's key or its sub-text (e.g. "LSPs & teams") — either is
	// resolved to the derived key, so pages needn't know the slug format.
	lockSegment?: string
}
const { lockSegment } = Astro.props

// ── Data ───────────────────────────────────────────────────────────────────
// `segments` (the radio group) and `products` are derived from the CMS payload
// in src/data/pricing.js. The backend emits pricing segment-first, with shared
// products duplicated per segment; that module folds it back into this
// product-keyed model so shared cards render once and morph between segments.
import { segments, products, slugify } from '../data/pricing.js'

// Resolve the locked segment to a real key: match by key first, else slugify
// whatever was passed (so "LSPs & teams" and "lsps-and-teams" both work).
const lockKey = lockSegment ? (segments.find((s) => s.key === lockSegment)?.key ?? slugify(lockSegment)) : undefined
const DEFAULT_SEGMENT = lockKey ?? segments[Math.floor(segments.length / 2)]?.key

// `order` fixes the DOM order so each segment's products stay contiguous and in
// the right sequence once the others are hidden. Locked pages only render the
// products that belong to that segment.
const fullOrder = ['go', 'freelance', 'pro', 'team', 'business', 'enterprise', 'edge']

const order = lockKey ? fullOrder.filter((id) => products[id].segments.includes(lockKey)) : fullOrder

// Cards get a little roomier when the active segment has only a couple of them.
// The count drives a --card-width variable (static CSS reads it); the script
// updates it on segment switch. Rendered here so the first paint is correct.
const activeCount = order.filter((id) => products[id].segments.includes(DEFAULT_SEGMENT)).length
const cardWidth = activeCount <= 2 ? '20rem' : '17.375rem'

// Tokens used by the segment show/hide CSS (a product can live in several segments).
const segmentTokens = Object.fromEntries(order.map((id) => [id, products[id].segments.join(' ')]))

// A card owns which segment(s) it's the popular one in (empty for most) — read
// off each segment's card via its CMS `productBadgeLabel`.
const popularTokens = Object.fromEntries(order.map((id) => [id, products[id].segments.filter((s) => products[id].cards[s].productBadgeLabel === 'Most popular').join(' ')]))

const splitName = (name) => (name.startsWith('Trados ') ? ['Trados', name.slice(7)] : ['', name])

// ── Comparison matrix ──────────────────────────────────────────────────────
const matrix = [
	{
		title: 'Capacity',
		rows: [
			{ label: 'Languages', vals: { go: 'Unlimited', freelance: 'Unlimited', pro: 'Unlimited', team: 'Unlimited', business: 'Unlimited', enterprise: 'Unlimited', edge: 'Unlimited' } },
			{ label: 'Cloud throughput (words / yr)', id: 'cloud-throughput', tooltip: 'Cloud translation throughput is the total number of target words that can be processed through Trados cloud per year.', vals: { go: '1M', freelance: '1M', pro: '5M', team: 'Unlimited', business: 'Unlimited', enterprise: 'Unlimited', edge: 'Unlimited' } },
			{ label: 'Desktop throughput', id: 'desktop-throughput', tooltip: 'Desktop translation throughput is the total number of target words that can be processed through the Trados desktop application per year.', vals: { go: false, freelance: 'Unlimited', pro: 'Unlimited', team: false, business: 'Unlimited', enterprise: 'Unlimited', edge: 'Unlimited' } },
			{ label: 'Users included', vals: { go: '1', freelance: '1', pro: '1', team: 'Up to 10', business: 'Custom', enterprise: 'Unlimited', edge: 'Custom' } },
		],
	},
	{
		title: 'Translation features',
		rows: [
			{ label: 'Online (browser) editor', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Desktop editor (Trados Studio)', vals: { go: false, freelance: true, pro: true, team: 'Add-on', business: true, enterprise: true, edge: true } },
			{ label: 'Translation memory & engines', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{
				label: 'Terminology management',
				id: 'terminology-management',
				valueTooltip: {
					match: 'MultiTerm',
					text: '<a href="https://www.trados.com/product/multiterm/" target="_blank">MultiTerm</a> provides a central location to store and manage multilingual terminology, helping you to deliver consistent, high-quality content from source through to translation. MultiTerm is included with all Trados Freelance subscription packages, and is available to download and install from your <a href="http://account.rws.com/" target="_blank">Trados subscription account</a>. In addition, terminology management is available in the browser giving you the flexibility to choose how you want to work.',
				},
				vals: { go: 'Browser', freelance: 'MultiTerm', pro: 'MultiTerm', team: 'Browser', business: true, enterprise: true, edge: true },
			},
			{ label: 'Quality assurance checks', vals: { go: false, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Customize with AppStore apps', vals: { go: '10+', freelance: '150+', pro: '150+', team: '50+', business: '150+', enterprise: '150+', edge: '150+' } },
		],
	},
	{
		title: 'Linguistic AI',
		rows: [
			{ label: 'Smart Help (AI assistant)', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'AI Assistant in desktop', vals: { go: false, freelance: true, pro: true, team: false, business: true, enterprise: true, edge: true } },
			{ label: 'Language Weaver generative MT', lw: true, vals: { go: 'Add-on', freelance: 'Add-on', pro: 'Add-on', team: 'Add-on', business: 'Included', enterprise: 'Included', edge: 'Edge' } },
			{ label: '3rd-party MT & LLM providers', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
		],
	},
	{
		title: 'Collaboration & workflow',
		rows: [
			{ label: 'Cloud projects', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Real-time collaboration', vals: { go: false, freelance: false, pro: false, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Workflow automation', vals: { go: false, freelance: false, pro: 'Basic', team: 'Basic', business: true, enterprise: 'Advanced', edge: true } },
			{
				label: 'Vendor & supply-chain management',
				id: 'vendor-supply-chain',
				valueTooltip: {
					match: true,
					products: ['business'],
					text: 'Placeholder tooltip copy describing vendor and supply-chain management for Trados Business.',
				},
				vals: { go: false, freelance: false, pro: false, team: false, business: true, enterprise: true, edge: true },
			},
			{ label: 'Roles & permissions', vals: { go: false, freelance: false, pro: false, team: 'Basic', business: true, enterprise: 'Advanced', edge: true } },
		],
	},
	{
		title: 'Integrations & security',
		rows: [
			{ label: 'API access', vals: { go: false, freelance: false, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Built-in cloud connectors', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'CMS & content connectors', vals: { go: false, freelance: false, pro: false, team: false, business: true, enterprise: true, edge: true } },
			{ label: 'SSO & advanced security', vals: { go: false, freelance: false, pro: false, team: false, business: false, enterprise: true, edge: true } },
			{ label: 'On-premise / private cloud', vals: { go: false, freelance: false, pro: false, team: false, business: false, enterprise: 'Option', edge: true } },
		],
	},
	{
		title: 'Support & onboarding',
		rows: [
			{ label: 'Community & Knowledge Base', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Standard support', vals: { go: 'Add-on', freelance: 'Add-on', pro: true, team: true, business: true, enterprise: true, edge: true } },
			{ label: 'Dedicated success manager', vals: { go: false, freelance: false, pro: false, team: false, business: 'Option', enterprise: true, edge: true } },
			{ label: 'Guided onboarding & tours', vals: { go: true, freelance: true, pro: true, team: true, business: true, enterprise: true, edge: true } },
		],
	},
]
---

<section class={`pt-16 md:pt-20 lg:pt-24 ${lockSegment ? 'pb-16 md:pb-20 lg:pb-24' : 'pb-0'}`} data-theme="default">
	<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
		<span class="mb-8 inline-flex items-center justify-between rounded-full border border-accent-soft bg-accent-softer px-4 py-1 text-center text-sm" role="alert">
			<span class="py-1 text-sm font-bold tracking-wider text-accent uppercase">Summer discount - 10% off</span>
		</span>

		<h1 class="mx-auto mb-5 max-w-[16ch] text-4xl font-bold tracking-tight md:text-5xl xl:text-6xl">
			<p>Trados <em>Pricing.</em></p>
		</h1>

		{
			lockSegment && (
				<div class="mx-auto prose prose-xl max-w-[56ch] text-foreground-muted md:prose-2xl">
					{segments.map((s) => (
						<p data-segment data-segments={s.key}>
							{s.subtitle}
						</p>
					))}
				</div>
			)
		}
	</div>
</section>

<div class="group" data-pricing data-active-segment={DEFAULT_SEGMENT} data-segment-order={segments.map((s) => s.key).join(' ')} style={`--card-width:${cardWidth}`}>
	{
		/* Segment control (radio group) — omitted on segment-locked pages, whose
	     subtitle moved up into the hero above since there's no picker to sit under. */
	}
	{
		!lockSegment && (
			<section class="pt-2 pb-8 md:pt-4 md:pb-12 lg:pt-6 lg:pb-16" data-theme="default">
				<div class="mx-auto max-w-screen-xl px-8 text-center">
					<div class="mb-5 flex justify-center">
						<fieldset role="radiogroup" aria-label="Which best describes you?" class="relative inline-flex w-full max-w-xl flex-col rounded-[2rem] border p-1.5 sm:flex-row sm:rounded-full" data-card>
							<span data-segment-indicator aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-0 w-0 rounded-full bg-linear-to-br from-primary to-tertiary shadow-xl transition-[transform,width,height] duration-300 ease-out motion-reduce:transition-none" style="view-transition-name:segment-pill" />
							{segments.map((s) => (
								<label class="relative z-1 flex flex-1 cursor-pointer flex-col items-center rounded-full px-3 py-2 text-center text-foreground-muted transition-colors select-none has-[:checked]:text-white" style={`view-transition-name:segment-option-${s.key};view-transition-class:segment-option`}>
									<input type="radio" name="segment" value={s.key} class="sr-only" checked={s.key === DEFAULT_SEGMENT} />
									<span class="text-sm leading-tight font-semibold sm:text-base">{s.label}</span>

									<span class="mt-0.5 flex items-center gap-1.5">
										{s.icon === 'user' && (
											<svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
												<circle cx="12" cy="7" r="4" />
											</svg>
										)}
										{s.icon === 'users' && (
											<svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
												<path d="M16 3.128a4 4 0 0 1 0 7.744" />
												<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
												<circle cx="9" cy="7" r="4" />
											</svg>
										)}
										{s.icon === 'building' && (
											<svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M10 12h4" />
												<path d="M10 8h4" />
												<path d="M14 21v-3a2 2 0 0 0-4 0v3" />
												<path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2" />
												<path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" />
											</svg>
										)}

										<span class="text-xs opacity-80">{s.sub}</span>
									</span>
								</label>
							))}
						</fieldset>
					</div>

					<div class="text-foreground-muted">
						{segments.map((s) => (
							<p data-segment data-segments={s.key}>
								{s.subtitle}
							</p>
						))}
					</div>
				</div>
			</section>
		)
	}

	{/* Cards */}
	<section class="pt-8 pb-8 md:pt-12 md:pb-12 lg:pt-16 lg:pb-16" data-theme="dots">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="flex flex-wrap justify-center gap-x-6 gap-y-10">
				{
					order.map((id) => {
						const p = products[id]
						const plan = p.base.pricingPlans?.[0]
						const hasPricing = p.base.hasPricingPlans && plan
						const ctas = p.base.annualCTA?.length ? p.base.annualCTA : p.base.monthlyCTA
						const addon = p.base.productAddons?.[0]
						const [brand, productName] = splitName(p.base.productTitle)
						return (
							<div class="flex w-full max-w-sm flex-col sm:max-w-none" data-product={id} data-segment data-segments={segmentTokens[id]} data-popular-in={popularTokens[id] || undefined} style={`view-transition-name:card-${id}`}>
								<div data-card class="group/card relative flex w-full flex-1 flex-col rounded-lg border p-6 data-highlighted:glow-animate data-highlighted:border-accent">
									<span data-popular-badge class="absolute -top-3 left-1/2 z-10 hidden -translate-x-1/2 items-center gap-1 rounded-full bg-linear-to-br from-primary to-secondary px-3 py-1 text-xs font-bold whitespace-nowrap text-white shadow group-data-popular/card:inline-flex">
										<svg class="size-2.5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
											<>
												<rect width="256" height="256" fill="none" />
												<path d="M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z" />
											</>
										</svg>
										Most popular
									</span>

									{hasPricing && (
										<div class="absolute top-4 right-4">
											<button class="btn btn-outline btn-icon-both btn-xs w-full rounded-full bg-background px-2 font-bold tracking-wider text-foreground-subtle" id={`currency-button-${id}`} popovertarget={`currency-popover-${id}`} popovertargetaction="toggle" type="button" style={`anchor-name: --currency-anchor-${id};`}>
												<span class="flex-1 text-left" data-currency-label>
													GBP
												</span>
												<svg class="ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
													<rect width="256" height="256" fill="none" />
													<polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" />
												</svg>
											</button>

											<div data-card id={`currency-popover-${id}`} popover="auto" role="menu" aria-labelledby={`currency-button-${id}`} class="dropdown z-10 mt-1 w-fit rounded border shadow-lg" style={`position-anchor: --currency-anchor-${id}; position-area: bottom span-left;`}>
												<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-xs font-bold tracking-wider select-none">
													{[
														['GBP', '£'],
														['USD', '$'],
														['EUR', '€'],
													].map(([code, sym]) => (
														<li>
															<label class="inline-flex w-full cursor-pointer items-center gap-2 rounded px-2 py-1.5 transition-colors hover:bg-accent-softer has-checked:bg-accent-softest hover:has-checked:bg-accent-softer">
																<input hidden data-currency-option type="radio" value={code} name={`currency-${id}`} class="input input-radio" checked={code === 'GBP'} />
																{sym} {code}
															</label>
														</li>
													))}
												</ul>
											</div>
										</div>
									)}

									<span class="-mt-0.5 text-xs font-bold tracking-wider text-primary uppercase">{p.base.productTagline}</span>

									<h3 class="mt-2 text-2xl font-bold tracking-tight">
										<span>{brand}</span> <span class="text-secondary">{productName}</span>
									</h3>

									<hr class="my-4" />

									{hasPricing && (
										<>
											<div class="mb-3 flex items-center gap-2">
												<div class="grid w-fit grid-cols-2 rounded-full border bg-foreground-softest p-0.5">
													<button type="button" data-billing="monthly" class="btn btn-xs transition-all">
														Monthly
													</button>
													<button type="button" data-billing="annual" class="btn btn-xs transition-all">
														Annual
													</button>
												</div>

												<span class="text-[0.625rem]/none font-bold tracking-wider text-foreground-subtle uppercase">Contract duration</span>
											</div>

											<div data-annual-pill hidden class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-500/12 px-3 py-1 text-xs font-semibold text-emerald-600">
												<svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
													<rect width="256" height="256" fill="none" />
													<rect x="32" y="80" width="192" height="48" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													<path d="M208,128v72a8,8,0,0,1-8,8H56a8,8,0,0,1-8-8V128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													<line x1="128" y1="80" x2="128" y2="208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													<path d="M176.79,31.21c9.34,9.34,9.89,25.06,0,33.82C159.88,80,128,80,128,80s0-31.88,15-48.79C151.73,21.32,167.45,21.87,176.79,31.21Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													<path d="M79.21,31.21c-9.34,9.34-9.89,25.06,0,33.82C96.12,80,128,80,128,80s0-31.88-15-48.79C104.27,21.32,88.55,21.87,79.21,31.21Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
												</svg>
												{p.base.annualRibbonText}
											</div>

											<div class="mb-4">
												<div class="flex items-baseline gap-2">
													<span data-was data-was-yearly={plan.hasAnnualOfferPrice ? plan.annualPrice : ''} data-was-monthly={plan.monthlyPrice} hidden class="text-lg text-foreground-subtle line-through">
														£{plan.hasAnnualOfferPrice ? plan.annualPrice : ''}
													</span>

													<span class="text-4xl font-bold tracking-tight" data-price data-monthly-gbp={plan.monthlyPrice} data-annual-gbp={plan.billedPrice} data-annual-monthly-gbp={plan.annualSaverPrice}>
														£{plan.billedPrice}
													</span>
												</div>

												<p class="mt-1 text-sm text-foreground-subtle">
													<span data-billing-note>
														<span data-note-rolling hidden>
															per user / month · billed monthly
														</span>
														<span data-note-annual>
															per user / month · <span data-year-total>£240 </span>billed&nbsp;
															<button type="button" data-cadence-trigger id={`cadence-button-${id}`} popovertarget={`cadence-popover-${id}`} popovertargetaction="toggle" style={`anchor-name: --cadence-anchor-${id};`} class="cursor-pointer font-semibold text-primary underline decoration-dotted underline-offset-2">
																<span data-cadence-label>yearly</span>
															</button>
														</span>
													</span>
												</p>

												<div data-card id={`cadence-popover-${id}`} popover="auto" role="menu" aria-labelledby={`cadence-button-${id}`} class="dropdown z-10 mt-1 w-max rounded border shadow-lg" style={`position-anchor: --cadence-anchor-${id}; position-area: bottom span-left;`}>
													<ul class="grid gap-px p-2 text-sm select-none">
														{[
															['yearly', 'Billed yearly (annual contract)'],
															['monthly', 'Billed monthly (annual contract)'],
														].map(([val, label]) => (
															<li>
																<label class="inline-flex w-full cursor-pointer items-center gap-2 rounded px-2 py-1.5 whitespace-nowrap transition-colors hover:bg-accent-softer has-checked:bg-accent-softest hover:has-checked:bg-accent-softer">
																	<input hidden data-cadence-option type="radio" value={val} name={`cadence-${id}`} class="input input-radio" checked={val === 'yearly'} />
																	{label}
																</label>
															</li>
														))}
													</ul>
												</div>
											</div>
										</>
									)}

									{p.segments.map((segment) => (
										<p data-segment data-segments={segment} class="text-sm/relaxed text-pretty text-foreground-muted">
											{p.cards[segment].productDescription}
										</p>
									))}

									<hr class="my-4" />

									{p.segments.map((segment) => (
										<ul data-segment data-segments={segment} role="list" class="flex flex-1 flex-col gap-3 text-left">
											{p.cards[segment].features.map((f) => (
												<li class="flex items-start gap-2.5">
													<span class="mt-0.25 flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent-softer text-accent">
														<svg class="size-2.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
															<rect width="256" height="256" fill="none" />
															<polyline points="40 144 96 200 224 72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="40" />
														</svg>
													</span>
													<span class="text-sm/snug text-foreground-muted">{f.featureTitle}</span>
												</li>
											))}
										</ul>
									))}

									<div class="mt-5 flex flex-col gap-2.5">
										{ctas.map((c, i) => (
											<a href="#" class={`btn w-full text-sm ${i === 0 ? 'btn-tertiary from-secondary to-tertiary bg-origin-border group-data-highlighted/card:bg-linear-to-br' : 'btn-outline'}`}>
												{c.text}
											</a>
										))}
									</div>
								</div>

								<div class="relative">
									<div class="grid h-10 place-items-center">
										<span class="h-full w-0.5 bg-linear-to-br from-primary-soft to-secondary-soft [grid-area:1/1]" />

										<span class="flex size-6 items-center justify-center rounded-full border-2 border-primary bg-background text-base font-bold text-primary shadow [grid-area:1/1]">
											<svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
												<rect width="256" height="256" fill="none" />
												<line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="40" />
												<line x1="128" y1="40" x2="128" y2="216" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="40" />
											</svg>
										</span>
									</div>

									<div class="rounded-lg" data-card>
										<div class="rounded-lg border border-primary-soft bg-linear-to-br from-primary-softest to-secondary-softest p-4 text-left">
											<div class="flex items-center gap-2">
												<span class="flex size-5 items-center justify-center rounded-sm bg-linear-to-br from-primary to-secondary text-white">
													<svg class="size-3 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
														<rect width="256" height="256" fill="none" />
														<path d="M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z" />
													</svg>
												</span>
												<span class="text-sm font-semibold text-tertiary">{addon.addonTitle}</span>
												<span class="mt-1 ml-auto text-xs text-[0.625rem] font-bold tracking-wide text-accent-muted uppercase">Add-on</span>
											</div>
											<p class="mt-1.5 text-xs/snug text-pretty text-foreground-muted">{addon.addonDescription}</p>
										</div>
									</div>
								</div>
							</div>
						)
					})
				}
			</div>

			<p class="mx-auto mt-8 max-w-4xl text-center text-xs/relaxed text-pretty text-foreground-subtle">*New Trados subscriptions only. Get instant access to Studio 2024, plus Studio 2026 at launch. Applies to first-year annual plans. Prices exclude VAT.</p>
		</div>
	</section>

	{/* Comparison table */}
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center *:mx-auto lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>Compare plans</p>
			</div>

			<h2 class="mb-6 max-w-[24ch] text-3xl font-bold tracking-tight text-pretty xl:text-4xl">
				<p>Compare every feature</p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				{segments.map((s) => (
					<p data-segment data-segments={s.key}>
						See exactly what's included across the “{s.label}” plans.
					</p>
				))}
			</div>
		</div>
	</section>

	<section class="pb-16 md:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="overflow-x-auto lg:overflow-visible">
				<div class="min-w-[56rem] overflow-clip rounded-lg border" data-accordion data-accordion-multi>
					{/* Column header */}
					<div class="sticky top-(--content-top) z-20 transition-[top] duration-300">
						<div data-comparison data-comparison-header class="grid items-start rounded-t-lg border-b bg-background/50 backdrop-blur stuck:rounded-t-none">
							<div></div>
							{
								order.map((id) => {
									const p = products[id]
									const [brand, productName] = splitName(p.base.productTitle)
									const plan = p.base.pricingPlans?.[0]
									const hasPricing = p.base.hasPricingPlans && plan
									const cta = (p.base.annualCTA?.length ? p.base.annualCTA : p.base.monthlyCTA)[0]
									return (
										<div data-segment data-segments={segmentTokens[id]} class="flex flex-col items-center px-3 py-5 text-center">
											<span class="text-base leading-tight font-semibold">
												<span>{brand} </span>
												<span class="text-secondary">{productName}</span>
											</span>
											<span class="mt-1 text-xs text-foreground-subtle">
												{hasPricing && (
													<span data-price data-monthly-gbp={plan.monthlyPrice} data-annual-gbp={plan.billedPrice} data-annual-monthly-gbp={plan.annualSaverPrice}>
														£{plan.billedPrice}
													</span>
												)}
											</span>
											<a href="#" class="btn btn-tertiary btn-xs mt-3 whitespace-nowrap">
												{cta.text}
											</a>
										</div>
									)
								})
							}
						</div>
					</div>

					{/* Sections */}
					{
						matrix.map((sec) => (
							<details class="group/sec" open>
								<summary class="flex cursor-pointer list-none items-center justify-between border-b bg-foreground-softest px-4 py-3 group-[&:last-child:not([open])]/sec:border-b-0">
									<h4 class="text-base font-semibold transition-colors">{sec.title}</h4>
									<svg class="size-5 shrink-0 text-foreground-subtle transition-[color,rotate] group-data-[open]/sec:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
										<rect width="256" height="256" fill="none" />
										<polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
									</svg>
								</summary>
								<div>
									{sec.rows.map((r) => (
										<div data-comparison class="grid border-b group-last/sec:last:border-b-0">
											<div class="flex items-center px-4 py-4 text-sm">
												{r.tooltip ? (
													<>
														<span class="relative block w-fit">
															{r.label}
															<button type="button" popovertarget={`tooltip-${r.id}`} popovertargetaction="toggle" class="absolute top-1/2 left-full translate-x-2 -translate-y-1/2 text-foreground" aria-label={`More information about ${r.label}`}>
																<svg class="-mb-0.5 size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
																	<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />{' '}
																</svg>
															</button>
														</span>
														<div id={`tooltip-${r.id}`} popover="auto" role="tooltip" class="tooltip">
															<p set:html={r.tooltip} />
														</div>
													</>
												) : (
													r.label
												)}
											</div>
											{order.map((id) => {
												const v = r.vals[id]
												return (
													<div data-segment data-segments={segmentTokens[id]} class="flex items-center justify-center border-l border-foreground-softest px-3 py-4 text-center">
														{v === true && (
															<span class="relative flex size-5 items-center justify-center rounded-full bg-accent-softer text-accent">
																<svg class="size-2.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true">
																	<rect width="256" height="256" fill="none" />
																	<polyline points="40 144 96 200 224 72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="40" />
																</svg>
																{r.valueTooltip && v === r.valueTooltip.match && (!r.valueTooltip.products || r.valueTooltip.products.includes(id)) && (
																	<>
																		<button type="button" popovertarget={`tooltip-${r.id}-${id}`} popovertargetaction="toggle" class="absolute top-1/2 left-full translate-x-2 -translate-y-1/2 text-foreground" aria-label={`More information about ${r.label}`}>
																			<svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
																				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />{' '}
																			</svg>
																		</button>
																		<div id={`tooltip-${r.id}-${id}`} popover="auto" role="tooltip" class="tooltip">
																			<p set:html={r.valueTooltip.text} />
																		</div>
																	</>
																)}
															</span>
														)}
														{(v === false || v == null) && (
															<span class="text-foreground-subtle" aria-label="Not included">
																–
															</span>
														)}
														{typeof v === 'string' && (
															<span class="flex items-center gap-3">
																{r.valueTooltip && v === r.valueTooltip.match ? (
																	<>
																		<span class="relative w-fit">
																			<span class="text-sm">{v}</span>
																			<button type="button" popovertarget={`tooltip-${r.id}-${id}`} popovertargetaction="toggle" class="absolute top-1/2 left-full translate-x-2 -translate-y-1/2 text-foreground" aria-label={`More information about ${v}`}>
																				<svg class="-mb-0.5 size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
																					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />{' '}
																				</svg>
																			</button>
																		</span>
																		<div id={`tooltip-${r.id}-${id}`} popover="auto" role="tooltip" class="tooltip">
																			<p set:html={r.valueTooltip.text} />
																		</div>
																	</>
																) : (
																	<span class="text-sm">{v}</span>
																)}
																{r.lw && v === 'Add-on' && (
																	<span class="inline-flex items-center gap-1 rounded-full border border-primary-soft bg-primary-softest px-2 py-0.5 text-[0.6rem] font-bold tracking-wide text-primary uppercase">
																		<svg class="size-2 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
																			<rect width="256" height="256" fill="none" />
																			<path d="M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z" />
																		</svg>
																		LW Pro
																	</span>
																)}
															</span>
														)}
													</div>
												)
											})}
										</div>
									))}
								</div>
							</details>
						))
					}
				</div>
			</div>

			<p class="mx-auto mt-8 max-w-3xl text-center text-xs/relaxed text-pretty text-foreground-subtle">Trados Go and Trados Freelance prices reflect per-user list pricing (excluding VAT). Studio Pro, Team, Business, Enterprise and Edge / GroupShare are tailored to your needs — speak to sales for a quote. Prices are set in GBP; other currencies are indicative conversions.</p>
		</div>
	</section>
</div>
