											<input id="modal-quantity" data-qty-input type="number" class="field-sizing-content min-w-12 [appearance:textfield] rounded-sm border-foreground/10 text-center tabular-nums [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" min="1" max="100" value="1" />
