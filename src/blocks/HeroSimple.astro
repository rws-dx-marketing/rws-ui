	<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
		<!-- Announcement -->
		<a href="#" class="mb-8 inline-flex items-center justify-between rounded-full bg-foreground/5 p-1 pr-4 text-center text-sm transition-colors hover:bg-foreground/10" role="alert">
			<!-- Label -->
			<span class="mr-3 shrink-0 rounded-full bg-accent px-3 py-1.5 text-xs font-semibold text-accent-foreground">New</span>

			<!-- Message -->
			<span class="text-sm font-semibold">Something is happening. Check it out now</span>

			<!-- Icon -->
			<div class="svg-current mt-0.5 ml-[0.375em] size-3.5 shrink-0">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
			</div>
		</a>

