---
// @ts-nocheck
import Section from '../components/Section.astro'
import Heading from '../components/Heading.astro'
---

<!-- <style is:global>
	@media (min-width: 1024px) {
		html:has([data-split-steps]) {
			scroll-snap-type: y proximity;
		}
	}
</style> -->
<Section theme="pale" top={false} bottom={false} container={false} data-split-steps="" data-active-step="1">
	<!-- Mobile animation (hidden on lg+) -->
	<div class="mx-auto max-w-screen-xl px-8 pt-12 lg:hidden">
		<div data-scene-anim data-scene="1" data-animation-status="play" class="mx-auto aspect-square w-1/2"></div>
	</div>

	<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
		<div class="lg:grid lg:grid-cols-12 lg:gap-16 xl:gap-20">
			<!-- Scrolling steps -->
			<div class="lg:col-span-6">
				<!-- Step 1 -->
				<div class="flex min-h-screen items-center py-20 lg:snap-center" data-step="1">
					<div class="intersect-once intersect:motion-preset-fade-up">
						<p class="mb-3 font-bold text-foreground-muted xl:text-lg">Step one</p>

						<Heading as="h2" size="xs" class="mb-6 font-bold tracking-tight">
							Lorem ipsum dolor sit amet <em>adipiscing elitera</em> consectetur
						</Heading>

						<div class="prose text-foreground-muted md:prose-lg">
							<p>Donec ut cursus est. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse luctus tortor placerat erat consequat.</p>
						</div>

						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a href="#" class="btn btn-primary btn-icon-right">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								Find out more
							</a>
						</div>
					</div>
				</div>

				<!-- Step 2 -->
				<div class="flex min-h-screen items-center py-20 lg:snap-center" data-step="2">
					<div class="intersect-once intersect:motion-preset-fade-up">
						<p class="mb-3 font-bold text-foreground-muted xl:text-lg">Step two</p>

						<Heading as="h2" size="xs" class="mb-6 font-bold tracking-tight">
							Suspendisse luctus <em>tortor placerat</em> erat consequat
						</Heading>

						<div class="prose text-foreground-muted md:prose-lg">
							<p>Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum tortor quam, feugiat vitae, ultricies eget.</p>
						</div>

						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a href="#" class="btn btn-secondary btn-icon-right">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								Find out more
							</a>
						</div>
					</div>
				</div>

				<!-- Step 3 -->
				<div class="flex min-h-screen items-center py-20 lg:snap-center" data-step="3">
					<div class="intersect-once intersect:motion-preset-fade-up">
						<p class="mb-3 font-bold text-foreground-muted xl:text-lg">Step three</p>

						<Heading as="h2" size="xs" class="mb-6 font-bold tracking-tight">
							Pellentesque habitant <em>morbi tristique</em> senectus et netus
						</Heading>

						<div class="prose text-foreground-muted md:prose-lg">
							<p>Integer in feugiat lorem. Nulla facilisi. Maecenas aliquam turpis at ex malesuada, vitae hendrerit velit sodales. Duis nec risus at enim commodo tincidunt.</p>
						</div>

						<div class="mt-8 flex flex-wrap items-center gap-4">
							<a href="#" class="btn btn-tertiary btn-icon-right">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								Find out more
							</a>
							<!-- <a href="#" class="btn btn-secondary btn-icon-right">
								<svg xmlns="http://www.w3.org/2000/svg" fill="black" viewBox="0 0 256 256"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"></path></svg>
								External link
							</a> -->
						</div>
					</div>
				</div>
			</div>

			<!-- Sticky animation (lg+) -->
			<div class="hidden lg:col-span-6 lg:block">
				<div class="sticky top-0 flex h-screen items-center justify-center">
					<div data-scene-anim data-scene="1" data-animation-status="play" class="aspect-square w-full max-w-[600px]"></div>
				</div>
			</div>
		</div>
	</div>
</Section>

<script>
	const section = document.querySelector('[data-split-steps]')
	if (section) {
		const sceneAnims = section.querySelectorAll('[data-scene-anim]')
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						const step = entry.target.getAttribute('data-step') ?? ''
						section.setAttribute('data-active-step', step)
						sceneAnims.forEach((el) => el.setAttribute('data-scene', step))
					}
				}
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		)
		section.querySelectorAll('[data-step]').forEach((step) => observer.observe(step))
	}
</script>

