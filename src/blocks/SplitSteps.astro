<script>
	const section = document.querySelector('[data-split-steps]')
	if (section) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						section.setAttribute('data-active-step', entry.target.getAttribute('data-step') ?? '')
					}
				}
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		)
		section.querySelectorAll('[data-step]').forEach((panel) => observer.observe(panel))
	}
</script>
