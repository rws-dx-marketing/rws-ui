---
import type { Theme } from '../data/themes'

// Variants: 'four-card' | 'three-card'
type Variant = 'four-card' | 'three-card'

interface Props {
	variant?: Variant
	theme?: Theme
}

const { variant = 'four-card', theme = 'default' } = Astro.props
---

{
	variant === 'four-card' && (
		<section class="bg-background pt-12 pb-12 text-foreground md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme={theme}>
			<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
				<div class="grid gap-6 rounded-[1px] bg-accent-softest outline-24 outline-accent-softest sm:grid-cols-2 lg:grid-cols-4">
					{/* CARD 1: Large left card (half width, full height) */}
					<article class="group relative isolate overflow-hidden rounded-lg border border-accent-soft bg-background sm:col-span-2 lg:row-span-2">
						<div class="relative isolate flex h-96 justify-end overflow-hidden">
							<img src="https://placehold.co/720x620" alt="Placeholder" class="size-full object-cover object-top" />
							<div class="absolute top-1/2 right-0 bottom-0 left-0 bg-linear-to-b from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-5 max-w-[20ch] text-gradient text-4xl font-semibold">
								<p>
									<a href="#">
										1 Trillion+
										<span class="absolute inset-0 rounded-lg" />
									</a>
								</p>
							</h3>

							<div class="prose prose-lg font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis nisi aliquam nemo possimus commodi!</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>

					{/* CARD 2: Top-right, small */}
					<article class="group relative isolate overflow-hidden rounded-lg border border-accent-soft bg-background lg:col-start-3 lg:row-start-1">
						<div class="relative isolate flex h-40 justify-center">
							<img src="https://placehold.co/400" alt="Placeholder" class="h-full object-cover" />
							<div class="absolute top-1/2 right-0 bottom-0 left-0 bg-linear-to-b from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-4 text-gradient text-2xl font-semibold text-balance">
								<a href="#">
									45+ AI patents
									<span class="absolute inset-0 rounded-lg" />
								</a>
							</h3>

							<div class="prose font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit.</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>

					{/* CARD 3: Top-right, small (far right) */}
					<article class="group relative isolate overflow-hidden rounded-lg border border-accent-soft bg-background lg:col-start-4 lg:row-start-1">
						<div class="relative isolate flex h-40 justify-center">
							<div class="aspect-3/1 h-full bg-gray-300" />
							<div class="absolute top-1/2 right-0 bottom-0 left-0 bg-linear-to-b from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-4 text-gradient text-2xl font-semibold">
								<a href="#">
									200+ connectors
									<span class="absolute inset-0 rounded-lg" />
								</a>
							</h3>

							<div class="prose font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit.</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>

					{/* CARD 4: Bottom-right, medium (spans both right columns) */}
					<article class="group relative isolate flex items-end overflow-hidden rounded-lg border border-accent-soft bg-background sm:col-span-2 lg:col-start-3 lg:row-start-2">
						<div class="order-last mb-[10%] ml-auto hidden w-48 shrink-0 self-start sm:block">
							<img src="https://placehold.co/400" alt="Placeholder" class="object-cover" />
						</div>

						<div class="sm:mt-[10%]- p-6 lg:p-8">
							<h3 class="mb-4 text-gradient text-2xl font-semibold text-balance">
								<a href="#">
									43k+ language experts 200k AI data specialists
									<span class="absolute inset-0 rounded-lg" />
								</a>
							</h3>

							<div class="prose font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis nisi aliquam nemo.</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>
				</div>
			</div>
		</section>
	)
}

{
	variant === 'three-card' && (
		<section class="bg-background pt-12 pb-12 text-foreground md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme={theme}>
			<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
				<div class="grid gap-6 rounded-[1px] bg-accent-softest outline-24 outline-accent-softest sm:grid-cols-2 lg:grid-cols-4">
					{/* CARD 1: Large left card (half width, full height) */}
					<article class="group relative isolate overflow-hidden rounded-lg border border-accent-soft bg-background sm:col-span-2 lg:row-span-2">
						<div class="relative isolate flex h-96 justify-end overflow-hidden">
							<img src="https://placehold.co/720x620" alt="Placeholder" class="size-full object-cover object-top" />
							<div class="absolute top-1/2 right-0 bottom-0 left-0 bg-linear-to-b from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-5 max-w-[20ch] text-gradient text-4xl font-semibold">
								<p>
									<a href="#">
										1 Trillion+
										<span class="absolute inset-0 rounded-lg" />
									</a>
								</p>
							</h3>

							<div class="prose prose-lg font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis nisi aliquam nemo possimus commodi!</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>

					{/* CARD 2: Top-right wide with side image */}
					<article class="group relative isolate flex overflow-hidden rounded-lg border border-accent-soft bg-background sm:col-span-2 lg:col-start-3 lg:row-start-1">
						<div class="relative isolate flex w-56 shrink-0 justify-center">
							<img src="https://placehold.co/400" alt="Placeholder" class="h-full object-cover" />
							<div class="absolute top-0 right-0 bottom-0 left-1/2 bg-linear-to-r from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-4 text-gradient text-2xl font-semibold text-balance">
								<a href="#">
									45+ AI patents
									<span class="absolute inset-0 rounded-lg" />
								</a>
							</h3>

							<div class="prose font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis nisi aliquam nemo possimus commodi!</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>

					{/* CARD 3: Bottom-right wide with side image (image on right) */}
					<article class="group relative isolate flex overflow-hidden rounded-lg border border-accent-soft bg-background sm:col-span-2 lg:col-start-3 lg:row-start-2">
						<div class="relative isolate order-last flex w-56 shrink-0 justify-center">
							<img src="https://placehold.co/400" alt="Placeholder" class="h-full object-cover" />
							<div class="absolute top-0 right-1/2 bottom-0 left-0 bg-linear-to-l from-transparent to-background opacity-100 transition-opacity group-hover:opacity-0" />
						</div>

						<div class="p-6 lg:p-8">
							<h3 class="mb-4 text-gradient text-2xl font-semibold text-balance">
								<a href="#">
									200+ connectors
									<span class="absolute inset-0 rounded-lg" />
								</a>
							</h3>

							<div class="prose font-medium text-foreground-muted">
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis nisi aliquam nemo possimus commodi!</p>
							</div>
						</div>

						<div class="absolute inset-0 -z-1 bg-linear-to-r from-accent-softer to-background opacity-0 transition-opacity group-hover:opacity-100" />
					</article>
				</div>
			</div>
		</section>
	)
}
