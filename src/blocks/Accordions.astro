								<div class="relative mx-auto w-1/2 translate-y-1/2">
									<div class="aspect-square animate-spin bg-accent [animation-duration:5s]" />
									<div class="absolute top-0 aspect-square size-full animate-ping rounded-full bg-accent [animation-duration:2s]" />
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	)
}
