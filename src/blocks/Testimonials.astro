								)}
							</figure>
						</div>
					))
				}
			</div>
		</div>

		<div class="pointer-events-none absolute top-1/2 left-1/2 hidden w-full max-w-screen-xl -translate-x-1/2 -translate-y-[calc(50%+var(--spacing)*6)] justify-between px-8 lg:flex lg:px-12">
			<button data-carousel="prev" class="pointer-events-auto transition-opacity disabled:opacity-50">
				<span class="sr-only">Scroll to prev</span>
				<svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="160 208 80 128 160 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
			</button>

			<button data-carousel="next" class="pointer-events-auto transition-opacity disabled:opacity-50">
				<span class="sr-only">Scroll to next</span>
				<svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="96 48 176 128 96 208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
			</button>
		</div>

		<div data-carousel="dots" class="mt-12 flex items-center justify-center gap-3"></div>

		<script type="text/template" data-carousel="dot-template">
			<button data-carousel="dot" class="size-3 rounded-full bg-current text-accent opacity-50 transition-opacity data-selected:opacity-100"></button>
		</script>
	</div>
</section>

