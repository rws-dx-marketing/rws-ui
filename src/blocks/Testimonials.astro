---
// @ts-nocheck
import { dotIcons } from '../data/carousel-icons'
import Section from '../components/Section.astro'

const {
	variant = 'morphing-dots',
	theme = 'default',
	testimonials = [
		{
			quote: 'Nunc sit amet est semper ligula lacinia faucibus scelerisque sed elit. Quisque sagittis, urna sed elementum tempus, dolor dolor mollis nulla, at gravida orci sapien quis felis. In pulvinar metus sed tellus ornare porta.',
			avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/michael-gouch.png',
			author: 'Michael Gough',
			role: 'CEO at Canva',
			link: '/resources/case-study',
			logo: '/logos/canva.svg',
		},
		{
			quote: 'Donec quis viverra ante, tempus convallis mauris. Mauris tempor orci sit amet mi accumsan ultricies. Phasellus cursus massa felis, id volutpat lectus suscipit sit amet. Aenean eleifend orci at est iaculis rutrum.',
			logo: '/logos/alibaba.svg',
		},
		{
			quote: 'Donec quis viverra ante, tempus convallis mauris. Mauris tempor orci sit amet mi accumsan ultricies. Phasellus cursus massa felis, id volutpat lectus suscipit sit amet. Aenean eleifend orci at est iaculis rutrum.',
			author: 'John Doe',
			link: '/resources/case-study',
		},
		{
			quote: 'Donec quis viverra ante, tempus convallis mauris. Mauris tempor orci sit amet mi accumsan ultricies. Phasellus cursus massa felis, id volutpat lectus suscipit sit amet. Aenean eleifend orci at est iaculis rutrum.',
		},
		{
			quote: 'Sed cursus eu ex eu vestibulum pellentesque porta gravida nunc, id vulputate sem etiam dapibus sapien. Mauris tempor orci sit amet mi accumsan ultricies.',
		},
	],
} = Astro.props
---

<Section theme={theme} top="md" bottom={false} container={false} class="overflow-hidden pb-15 md:pb-19 lg:pb-23">
	<div data-carousel class="relative">
		<div data-carousel="viewport" class="transition-[height]-">
			<div data-carousel="container" class="flex touch-pan-y touch-pinch-zoom items-center">
				{
					testimonials.map((t) => (
						<div data-carousel="slide" class="min-w-0 shrink-0 basis-full">
							<figure class="mx-auto max-w-3xl px-8 text-center lg:px-12">
								<div class="intersect svg-current mx-auto mb-5 size-12 text-accent intersect:motion-preset-rebound-up" style="--motion-delay: 200ms">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 393 285">
										<g fill="currentColor" fill-opacity=".5" clip-path="url(#a)">
											<path d="M392.995 118.048C392.995 52.851 339.942 0 274.497 0S156 52.85 156 118.048c0 65.196 53.052 118.047 118.497 118.047v48.823l81.26-80.952c22.926-21.525 37.235-52.057 37.235-85.918z" />
											<path d="M236.995 118.506C236.995 53.31 183.942.459 118.497.459S0 53.309 0 118.506s53.052 118.048 118.497 118.048v48.823l81.26-80.952c22.926-21.525 37.235-52.057 37.235-85.919z" />
										</g>
										<defs>
											<clipPath id="a">
												<path fill="#fff" d="M0 0h393v285H0z" />
											</clipPath>
										</defs>
									</svg>
								</div>

								<blockquote class="space-y-[0.5em] text-center text-2xl text-pretty *:first:before:content-['“'] *:last:after:content-['”']">
									<p>{t.quote}</p>
								</blockquote>

								{t.author && (
									<figcaption class="mt-6 flex items-center justify-center">
										{t.avatar && <img class="size-6 rounded-full" src={t.avatar} alt="" />}
										<div class="flex items-center divide-x divide-foreground-subtle">
											<div class="px-3 font-semibold">{t.author}</div>
											{t.role && <div class="px-3 text-foreground-muted">{t.role}</div>}
											{t.link && (
												<div class="px-3 text-foreground-muted transition-colors hover:text-accent">
													<a href={t.link} class="inline-flex items-center">
														Read case study
														<svg class="mt-0.25 ml-1 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
															<rect width="256" height="256" fill="none" />
															<line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="17" />
															<polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="17" />
														</svg>
													</a>
												</div>
											)}
										</div>
									</figcaption>
								)}

								{t.logo && (
									<div class="mt-6 flex items-center justify-center">
										<img class="max-h-14 object-contain" src={t.logo} draggable="false" />
									</div>
								)}
							</figure>
						</div>
					))
				}
			</div>
		</div>

		<div class="pointer-events-none absolute top-1/2 left-1/2 hidden w-full max-w-screen-xl -translate-x-1/2 -translate-y-[calc(50%+var(--spacing)*6)] justify-between px-8 lg:flex lg:px-12">
			<button data-carousel="prev" class="pointer-events-auto transition-opacity disabled:opacity-50">
				<span class="sr-only">Scroll to prev</span>
				<svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="160 208 80 128 160 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
			</button>

			<button data-carousel="next" class="pointer-events-auto transition-opacity disabled:opacity-50">
				<span class="sr-only">Scroll to next</span>
				<svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="96 48 176 128 96 208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
			</button>
		</div>

		<div data-carousel="dots" class="mt-12 flex items-center justify-center gap-3"></div>

		{
			variant === 'morphing-dots' && (
				<script type="text/template" data-carousel="dot-template">
					<button data-carousel="dot" class="relative -mb-3 size-3 text-accent transition-[translate] has-[~[data-selected]]:-translate-x-1 [[data-selected]~&]:translate-x-1">
						<span class="intersect-once absolute inset-0 intersect:motion-preset-rebound-down">
							<span class="absolute inset-0 rounded-full bg-current opacity-50 transition-all in-data-selected:scale-0 in-data-selected:opacity-0"></span>
							<span data-carousel="dot-icon" class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-50 opacity-0 transition-all in-data-selected:scale-100 in-data-selected:opacity-100 [&>svg]:size-full"></span>
						</span>
					</button>
				</script>
			)
		}

		{
			variant === 'morphing-dots' && (
				<div hidden>
					{dotIcons.map((icon) => (
						<div data-carousel="dot-icon-source" set:html={icon} />
					))}
				</div>
			)
		}

		{
			variant === 'simple-dots' && (
				<script type="text/template" data-carousel="dot-template">
					<button data-carousel="dot" class="size-3 rounded-full bg-current text-accent opacity-50 transition-opacity data-selected:opacity-100"></button>
				</script>
			)
		}
	</div>
</Section>
