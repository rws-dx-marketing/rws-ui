---
// @ts-nocheck
import Layout from '../layouts/Layout.astro'
import Section from '../components/Section.astro'
import Heading from '../components/Heading.astro'

// Countdown end, as a wall-clock time in the named zone. The instant is
// resolved here at build time with the zone's own offset on that date, so
// BST and GMT need no thought; the page then ships one UTC instant and every
// visitor counts down to it.
const launch = zoned('2026-11-10T09:00', 'Europe/London')

function zoned(local, zone) {
	const guess = new Date(local + 'Z')
	const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' })
	const p = Object.fromEntries(fmt.formatToParts(guess).map(({ type, value }) => [type, value]))
	// What the guess reads as on that zone's wall clock; the difference is the offset.
	const wall = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second)
	return new Date(guess.getTime() - (wall - guess.getTime())).toISOString()
}
const units = [
	['days', 'Days'],
	['hours', 'Hours'],
	['minutes', 'Mins'],
	['seconds', 'Secs'],
]

// @{
//   var london = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
//   var launchUtc = TimeZoneInfo.ConvertTimeToUtc(Model.LaunchLocal, london);
// }
// <div data-countdown="@launchUtc.ToString("o")" ...>

// Teaser: the black hole skin, zoomed in on the mark so only a stretch of its edge shows. Blob settings — the shared params and the skin's own controls.
// These are the script's current defaults; change them here and the page
// passes them to blob.js through [data-blob-settings].
const blob = {
	amp: 0, // edge wobble amplitude
	freq: 0, // wobble frequency along the edge
	speed: 0.33, // wobble and pulse time scale
	hover: 0.5, // the light under the pointer: its radius and how far beams swell and brighten; nothing moves
	inertia: 0.5, // the band of light scroll sends across the beams: how bright, and how hard scroll kicks the spring that paces it; matches hover at the same value
	controls: {
		spacing: 0.166, // beam spacing (0.02–0.3)
		width: 2, // beam width in pixels (0.3–4)
		glow: 0.1, // glow round each beam (0–1.5)
		squeeze: 0.15, // how tightly beams hug the edge; smaller is tighter (0.05–1)
		flow: 3, // pulse speed along the beams (0–10)
		streak: 0.3, // pulse contrast (0–1)
		halo: 0, // glow hugging the outline (0–1.5)
		reach: 4, // how far beams and ground spread from the mark; 1.5 fills a square host, 12 fills any hero (1–12)
		backdrop: 0, // dark ground behind the beams; 0 for an already dark page (0–1)
		pull: 1.1, // how strongly beams are drawn toward the mark's centre line before the edge repels them (0–3)
		pullReach: 1, // how far out the pull acts, in mark units (0.05–2)
		scale: 1, // multiplies the fitted mark size; pushed well past 1 so the outline runs off the viewport and the mark is not immediately readable (0.3–2 on the panel)
	},
}
---

<Layout title="Coming soon – RWS UI">
	<!-- Hero: the blob fills the whole section, the copy sits inside the hole.
	     The background seed is the shader's ground, tertiary scaled to 12% in linear light (blob.js uHole), so nothing shifts when the scene loads in -->
	<Section theme="tertiary" top="xl" bottom="xl" container={false} class="relative overflow-clip [--background-seed:color-mix(in_srgb-linear,var(--color-tertiary)_12%,black)]">
		<!-- Blob: a layer the size of the section, canvas the same size, so the beams run edge to edge -->
		<div class="absolute inset-0 touch-pan-y [&>canvas]:pointer-events-none [&>canvas]:absolute [&>canvas]:inset-0 [&>canvas]:block [&>canvas]:size-full" data-blob="hole" data-blob-settings={JSON.stringify(blob)} aria-hidden="true"></div>

		<!-- Copy: pointer events pass through to the blob except on the buttons -->
		<div class="pointer-events-none relative z-10 mx-auto flex max-w-screen-xl flex-col items-center justify-center px-8 text-center lg:px-12 [&_a]:pointer-events-auto">
			<!-- The hole is sized to clear this box by the gap in pixels: tighter on phones, where the copy is tall and the mark would otherwise swallow the section -->
			<div class="flex flex-col items-center [--blob-gap:16px] md:[--blob-gap:36px] xl:[--blob-gap:48px]" data-blob-fit="36">
				<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
					<p>Something big is coming&hellip;</p>
				</div>

				<!-- Countdown: cells are filled by countdown.js; the markup ships dashes so nothing wrong flashes before it runs -->
				<div class="mb-6 flex gap-5 sm:gap-8" role="timer" aria-live="off" aria-label="Time until launch" data-countdown={launch}>
					{
						units.map(([unit, label]) => (
							<div class="flex flex-col items-center">
								<Heading as="span" size="md" class="font-bold tracking-tight tabular-nums" data-countdown-unit={unit}>
									––
								</Heading>
								<span class="mt-1 text-xs font-bold tracking-widest text-foreground-muted uppercase sm:text-sm">{label}</span>
							</div>
						))
					}
				</div>

				<div class="prose prose-lg max-w-[36ch] text-foreground-muted not-last:mb-8 md:prose-xl">
					<p>Be the first to know when we lift the lid.</p>
				</div>

				<div class="flex flex-col gap-4 sm:flex-row">
					<a href="#" class="btn btn-primary btn-lg">Register interest</a>
					<!-- <a href="#" class="btn btn-ghost btn-lg">Learn more</a> -->
				</div>
			</div>
		</div>
	</Section>

	<section class="h-screen"></section>
</Layout>
