---
// @ts-nocheck
import Layout from '../layouts/Layout.astro'
import FormMultiStepMock from '../components/FormMultiStepMock.astro'
// Plain CSS, not utilities, so the markup below works pasted into a CMS code block
import '../../cms/t2.css'

// Pre-launch hero. The black-hole version, which shows the mark, is held back for launch at /t2-launch.

// Countdown end: same instant as /t2-launch, resolved the same way.
const launch = zoned('2026-11-10T09:00', 'Europe/London')

function zoned(local, zone) {
	const guess = new Date(local + 'Z')
	const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' })
	const p = Object.fromEntries(fmt.formatToParts(guess).map(({ type, value }) => [type, value]))
	const wall = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second)
	return new Date(guess.getTime() - (wall - guess.getTime())).toISOString()
}
const units = [
	['days', 'Days'],
	['hours', 'Hours'],
	['minutes', 'Mins'],
	['seconds', 'Secs'],
]

// Goo: satellites merging as they orbit. These are goo.js's own defaults; change
// them here and the page passes them to the script through [data-goo-settings]. Ranges in the script.
const goo = {
	count: 5, // number of spheres
	roam: 0.65, // how far they orbit from the centre
	size: 1, // sphere size
	speed: 0.7, // orbit speed
	goo: 0.9, // how readily they merge
	rim: 0, // fresnel rim light
	edge: 0, // width of the dark outer edge
	light: 1, // how far the highlight follows the cursor
	inertia: 1, // how hard scroll kicks the spring
	tilt: 5, // how far the scene leans toward the cursor
}
---

<Layout title="Coming soon – RWS UI">
	<section class="t2" data-theme="dots">
		<div class="t2-inner">
			<div>
				<h1 class="t2-eyebrow">Something big is coming&hellip;</h1>

				<!-- Cells are filled by countdown.js; the markup ships dashes so nothing wrong flashes before it runs -->
				<div class="t2-countdown" role="timer" aria-live="off" aria-label="Time until launch" data-countdown={launch}>
					<div class="t2-digits">{units.map(([unit]) => <span data-countdown-unit={unit}>––</span>)}</div>
					<div class="t2-labels">{units.map(([, label]) => <span>{label}</span>)}</div>
				</div>

				<p class="t2-lede">Global content is about to work differently.<br />Watch this space for the unveiling.<br /><strong>November 10.</strong></p>
			</div>

			<div class="t2-aside">
				<div class="t2-goo" data-goo data-goo-settings={JSON.stringify(goo)} aria-hidden="true"></div>

				<div class="t2-card" data-card>
					<h2 class="t2-card-heading">We're paving the way for how global businesses will work.</h2>

					<p class="t2-card-copy">Curious? Register your interest and you'll be first to know what comes next.</p>

					<!-- Stand-in for the HubSpot form embed -->
					<FormMultiStepMock idPrefix="t2" submitText="Register interest" />
				</div>
			</div>
		</div>
	</section>

	<section class="h-screen"></section>
</Layout>
