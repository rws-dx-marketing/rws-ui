---
// @ts-nocheck
import Layout from '../layouts/Layout.astro'
import Section from '../components/Section.astro'
import Heading from '../components/Heading.astro'
import FormMultiStepMock from '../components/FormMultiStepMock.astro'

// Pre-launch hero. The black-hole version, which shows the mark, is held back for launch at /t2-launch.

// Countdown end: same instant as /t2-launch, resolved the same way.
const launch = zoned('2026-11-10T09:00', 'Europe/London')

function zoned(local, zone) {
	const guess = new Date(local + 'Z')
	const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' })
	const p = Object.fromEntries(fmt.formatToParts(guess).map(({ type, value }) => [type, value]))
	const wall = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second)
	return new Date(guess.getTime() - (wall - guess.getTime())).toISOString()
}
const units = [
	['days', 'Days'],
	['hours', 'Hours'],
	['minutes', 'Mins'],
	['seconds', 'Secs'],
]

// Goo: satellites merging as they orbit. These are goo.js's own defaults; change
// them here and the page passes them to the script through [data-goo-settings]. Ranges in the script.
const goo = {
	count: 5, // number of spheres
	roam: 0.65, // how far they orbit from the centre
	size: 1, // sphere size
	speed: 0.7, // orbit speed
	goo: 0.9, // how readily they merge
	rim: 0, // fresnel rim light
	edge: 0, // width of the dark outer edge
	light: 1, // how far the highlight follows the cursor
	inertia: 1, // how hard scroll kicks the spring
	tilt: 5, // how far the scene leans toward the cursor
}
---

<Layout title="Coming soon – RWS UI">
	<Section theme="dots" top="lg" bottom="lg" container={false} class="relative grid min-h-[min(calc(100svh-var(--chrome-height)),56rem)] place-items-center overflow-clip">
		<div class="relative mx-auto grid w-full max-w-screen-xl items-center gap-12 px-8 lg:grid-cols-12 lg:px-12 xl:gap-16">
			<div class="lg:col-span-6">
				<h1 class="mb-6 font-bold text-foreground-muted xl:text-lg">Something big is coming&hellip;</h1>

				<div class="mb-8 grid w-fit grid-cols-[repeat(4,auto)] gap-x-6 sm:gap-x-8" role="timer" aria-live="off" aria-label="Time until launch" data-countdown={launch}>
					<div class="col-span-full grid grid-cols-subgrid justify-items-center text-gradient">
						{
							units.map(([unit]) => (
								<Heading as="span" size="lg" class="font-bold tracking-tight tabular-nums" data-countdown-unit={unit}>
									––
								</Heading>
							))
						}
					</div>
					<div class="col-span-full mt-1 grid grid-cols-subgrid justify-items-center text-xs font-bold tracking-widest text-foreground-muted uppercase sm:text-sm">{units.map(([, label]) => <span>{label}</span>)}</div>
				</div>

				<div class="prose prose-xl max-w-[40ch] text-foreground-muted md:prose-2xl">
					<p>Global content is about to work differently.<br />Watch this space for the unveiling.<br /><strong>November 10.</strong></p>
				</div>
			</div>

			<div class="relative lg:col-span-6">
				<div class="absolute top-1/2 left-1/2 aspect-square w-[125%] max-w-xl -translate-1/2 touch-pan-y [&>canvas]:pointer-events-none [&>canvas]:absolute [&>canvas]:top-1/2 [&>canvas]:left-1/2 [&>canvas]:block [&>canvas]:size-[200%] [&>canvas]:-translate-1/2" data-goo data-goo-settings={JSON.stringify(goo)} aria-hidden="true"></div>

				<div class="relative rounded-lg border bg-background/66 p-8 backdrop-blur-2xl" data-card>
					<h2 class="mb-4 text-2xl font-semibold">
						<p>We're paving the way for how global businesses will work.</p>
					</h2>

					<div class="prose mb-6 text-foreground-muted">
						<p>Curious? Register your interest and you'll be first to know what comes next.</p>
					</div>

					<FormMultiStepMock idPrefix="t2" submitText="Register interest" />
				</div>
			</div>
		</div>
	</Section>

	<section class="h-screen"></section>
</Layout>
