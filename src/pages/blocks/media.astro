---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'
import MediaGrid from '../../blocks/MediaGrid.astro'
import { themes } from '../../data/themes'

const orientations = ['columns', 'rows']
---

<Layout title="Media – RWS UI">
	<section class="border-b border-foreground-softest pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<h2 class="mb-6 max-w-[24ch] text-4xl font-bold tracking-tight text-pretty xl:text-5xl">
				<p>Media</p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				<p>A fluid alternative to Bento — author-defined groups laid out with flex as equal-width columns or full-width rows. Optional accent CTA card appended to the last group.</p>
			</div>
		</div>
	</section>

	{
		orientations.map((orientation) =>
			themes.map((theme, ti) =>
				ti === 0 ? (
					<>
						<div id={orientation} />
						<MediaGrid orientation={orientation} theme={theme} />
					</>
				) : (
					<MediaGrid orientation={orientation} theme={theme} />
				),
			),
		)
	}
</Layout>
