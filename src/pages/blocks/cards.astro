---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'
import Cards from '../../blocks/Cards.astro'
import { themes } from '../../data/themes'
---

<Layout title="Cards – RWS UI">
	<section class="border-b border-foreground-softest pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<h2 class="mb-6 max-w-[24ch] text-4xl font-bold tracking-tight text-pretty xl:text-5xl">
				<p>Cards</p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque venenatis felis posuere. Nullam lectus orci, maximus vel nibh vel, congue sodales ex. Integer auctor nulla vel leo.</p>
			</div>

			<div hidden class="mt-8 flex flex-wrap items-center gap-4">
				<a href="/reference" class="btn btn-outline btn-icon-left">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="216" y1="128" x2="40" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="88 80 40 128 88 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
					Reference
				</a>
			</div>
		</div>
	</section>

	{themes.map((theme) => <Cards theme={theme} />)}
</Layout>
