										</label>
									</li>
									<li>
										<label class="inline-flex w-full items-center gap-2 rounded p-2 transition-colors hover:bg-foreground/5 has-checked:bg-accent/10">
											<input id="dropdown-checkbox-3" data-filter-input type="checkbox" value="default-checkbox-3" class="input input-checkbox" />
											Default checkbox 3
										</label>
									</li>
								</ul>
								<div data-filter-clear hidden class="mt-1 border-t border-foreground/10 pt-1">
									<button type="button" class="px-2 py-1 text-left text-sm font-semibold text-foreground/66 transition-colors hover:text-accent">Clear selected</button>
								</div>
							</div>
						</div>

						<div data-filter data-filter-id="partners-radios" data-filter-mode="single">
							<button class="btn btn-outline btn-icon-right bg-input font-medium" id="partners-radios-button" popovertarget="partners-radios-popover" popovertargetaction="toggle" type="button">
