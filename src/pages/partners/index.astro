						<div data-filter data-filter-id="partners-checkboxes" data-filter-mode="multiple">
							<button class="btn btn-outline btn-icon-right bg-input font-medium" id="partners-checkboxes-button" popovertarget="partners-checkboxes-popover" popovertargetaction="toggle" type="button">
								Dropdown checkboxes
								<span class="ml-1 rounded-full bg-accent/10 px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							</button>

