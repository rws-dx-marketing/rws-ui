								</ul>
								<div data-filter-clear hidden class="mt-1 border-t border-foreground/10 pt-1">
									<button type="button" class="px-2 py-1 text-left text-sm font-semibold text-foreground/66 transition-colors hover:text-accent">Clear selected</button>
								</div>
							</div>
