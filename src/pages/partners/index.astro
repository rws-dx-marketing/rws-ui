										<label class="inline-flex w-full items-center gap-2 rounded p-2 transition-colors hover:bg-foreground/5 has-checked:bg-accent/10">
											<input id="dropdown-checkbox-0" data-filter-input type="checkbox" value="default-checkbox-0" class="input input-checkbox" />
