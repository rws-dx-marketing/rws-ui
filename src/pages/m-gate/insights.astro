---
import Layout from '../../layouts/Layout.astro'
import Image from '../../components/Image.astro'

const cards = [1, 2, 3, 4, 5, 6]
---

<Layout title="Insights – M-GATE">
	<!-- Hero -->
	<section class="grid- min-h-[min(calc(100svh-16rem),48rem)]- place-items-center- pt-16 pb-12 md:pt-20 md:pb-16 lg:pt-24 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>Consectetur adipiscing elit</p>
			</div>

			<h1 class="mx-auto mb-6 max-w-[16ch] text-4xl font-bold tracking-tight md:text-5xl xl:text-6xl">
				<p>Insights</p>
			</h1>

			<div class="mx-auto prose prose-xl max-w-[56ch] text-foreground-muted md:prose-2xl">
				<p>What happened when the latest model dropped? Lorem ipsum dolor sit, amet consectetur adipisicing elit vitae quo animi suspendisse luctus tortor.</p>
			</div>

			<div hidden class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="#" class="btn btn-primary btn-xl">View leaderboard</a>
				<a href="#" class="btn btn-outline btn-xl">Read methodology</a>
			</div>
		</div>
	</section>

	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="grid max-w-[80ch] gap-8 sm:grid-cols-2 lg:max-w-none lg:grid-cols-3">
				{
					cards.map((card) => (
						<>
							<article class="group relative overflow-clip rounded-lg border text-left" data-card>
								<div class="flex h-full flex-col">
									<div class="p-4">
										<div class="mb-5 block overflow-hidden rounded">
											<Image class="aspect-video object-cover transition-transform group-hover:scale-110" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png" alt="office laptop working" />
										</div>

										<span class="mb-3 inline-block rounded-full border bg-foreground-softest px-2 py-0.5 text-xs font-semibold text-foreground-muted"> Article </span>

										<h2 class="mb-2 text-2xl font-bold">
											<p>
												<a href="/resources/blog-1/">
													This is an article title
													<span class="absolute inset-0" />
												</a>
											</p>
										</h2>

										<div class="prose line-clamp-3 text-pretty text-foreground-muted">
											<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque.</p>
										</div>
									</div>

									<div class="mt-auto px-4 pb-4">
										<div class="flex items-center space-x-4">
											<Image class="h-10 w-10 rounded-full" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/jese-leos.png" alt="Jese Leos avatar" />
											<div>
												<div class="font-semibold">Jese Leos</div>
												<div class="text-sm text-foreground-muted">Aug 15, 2021 • 16 min read</div>
											</div>
										</div>
									</div>
								</div>
							</article>
						</>
					))
				}
			</div>
		</div>
	</section>
</Layout>
