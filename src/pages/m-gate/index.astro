								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 20%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 40%;"></span>
