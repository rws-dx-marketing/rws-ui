									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(17, 17, 17);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 43.6436%; background: rgb(17, 17, 17);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 83.6436%;">0.44</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
