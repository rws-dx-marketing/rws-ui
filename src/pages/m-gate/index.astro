									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 22.7836%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 62.7836%;">0.23</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemini 3.5 Flash</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 5.48357%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 45.4836%;">0.05</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Mistral Medium 3.1</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(255, 112, 0);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 4.82805%; background: rgb(255, 112, 0);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 44.828%;">0.05</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemini 3 Flash Preview</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 4.45435%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 44.4544%;">0.04</span>
