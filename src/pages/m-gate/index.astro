									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 2.37624%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 42.3762%;">0.02</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Mistral Medium 3.5</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(255, 112, 0);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 1.2%; background: rgb(255, 112, 0);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 40%;">0.00</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">GPT-5</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(16, 163, 127);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 35.9709%; width: 4.02911%; background: rgb(16, 163, 127);"></div>
									<span class="absolute top-1/2 -translate-x-full -translate-y-1/2 pr-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 35.9709%;">-0.04</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Command A Translate</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(57, 89, 76);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 35.4117%; width: 4.58831%; background: rgb(57, 89, 76);"></div>
									<span class="absolute top-1/2 -translate-x-full -translate-y-1/2 pr-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 35.4117%;">-0.05</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">GLM 5.2</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(14, 165, 233);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 6.94303%; width: 33.057%; background: rgb(14, 165, 233);"></div>
									<span class="absolute top-1/2 -translate-x-full -translate-y-1/2 pr-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style="left: 6.94303%;">-0.33</span>
								</div>
							</div>
						</div>
						<div class="relative mt-0.5 h-4" style="margin-left: calc(184px); margin-right: 40px;">
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 0%;">-0.40</span>
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 20%;">-0.20</span>
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 40%;">0.00</span>
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 60%;">0.20</span>
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 80%;">0.40</span>
							<span class="absolute -translate-x-1/2 text-[10px] whitespace-nowrap text-foreground-subtle" style="left: 100%;">0.60</span>
						</div>
						<p class="mt-1.5 text-center text-[11px] text-foreground-subtle">MCC</p>
					</div>
				</div>
				<div class="border-t px-6 py-3">
					<a class="text-[13px] font-semibold text-accent no-underline hover:underline" href="#methodology">How we measure this — methodology &amp; metric definitions →</a>
				</div>

				<!-- Overlay -->
				<div class="absolute inset-0 grid place-content-center bg-background/75 backdrop-blur *:pointer-events-auto *:select-auto" data-card>
					<div class="max-w-[42ch] px-6 text-center">
						<h3 class="mb-3 text-xl font-semibold text-balance">Unlock the full dataset</h3>

						<p class="mb-6 text-base text-pretty text-foreground-muted">Every model, language and metric — including detailed per-language and per-domain breakdowns.</p>

						<a href="/m-gate/register" class="btn btn-primary btn-icon-right">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							Get access now
						</a>

						<p class="mt-4 text-xs text-foreground-subtle">Free — takes about 2 minutes</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Gating patterns -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="mb-10 max-w-[60ch]">
				<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
					<p>Gating patterns</p>
				</div>
				<h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">Other ways to tease the data</h2>
				<p class="text-lg text-pretty text-foreground-muted">Alternatives to the blur overlay above. Each one withholds the value on the server rather than hiding it with CSS, so nothing sensitive ships to the browser.</p>
			</div>

			<div class="grid items-start gap-8 lg:grid-cols-2">
				<!-- 1. Truncate and fade -->
				<div class="overflow-hidden rounded-lg border bg-background-softest">
					<div class="border-b px-6 py-4">
						<h3 class="m-0 text-base font-bold">1 — Truncate and fade</h3>
						<p class="mt-1 mb-0 text-xs text-foreground-subtle">Real rows, honestly counted. The rest are never rendered.</p>
					</div>

					<div class="relative">
						<div class="p-6">
							{
								gateRows.map((row) => (
									<div class="mb-1.5 flex items-center gap-3.5">
										<div class="flex w-[150px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
											<span class="overflow-hidden text-ellipsis whitespace-nowrap">{row.name}</span>
											<span class="h-2 w-2 flex-none rounded-full" style={`background: ${row.color};`} />
										</div>
										<div class="relative mr-10 h-6 flex-1">
											<div class="absolute top-0 h-full rounded-[5px]" style={`left: ${row.left}%; width: ${row.width}%; background: ${row.color};`} />
											<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground/80" style={`left: ${row.left + row.width}%;`}>
												{row.score}
											</span>
										</div>
									</div>
								))
							}
						</div>
						<div class="pointer-events-none absolute inset-x-0 bottom-0 h-full bg-linear-to-t from-background-softest to-transparent"></div>
					</div>

					<div class="flex flex-wrap items-center justify-between gap-3 border-t px-6 py-4">
						<p class="m-0 text-sm text-foreground-muted">Showing <span class="font-semibold text-foreground tabular-nums">5</span> of <span class="font-semibold text-foreground tabular-nums">34</span> models</p>
						<a href="/m-gate/register" class="btn btn-primary btn-sm">See all 34</a>
					</div>
				</div>

				<!-- 2. Round the answer down -->
				<div class="overflow-hidden rounded-lg border bg-background-softest">
					<div class="border-b px-6 py-4">
						<h3 class="m-0 text-base font-bold">2 — Round the answer down</h3>
						<p class="mt-1 mb-0 text-xs text-foreground-subtle">A band gives you the shape. The exact score is what you register for.</p>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead class="border-b text-xs text-foreground-subtle">
								<tr>
									<th scope="col" class="px-6 py-3 font-semibold">Language</th>
									<th scope="col" class="px-6 py-3 font-semibold">Best model</th>
									<th scope="col" class="px-6 py-3 font-semibold">Grammar</th>
									<th scope="col" class="px-6 py-3 text-right font-semibold">Exact MCC</th>
								</tr>
							</thead>
							<tbody>
								{
									gateBands.map((row) => (
										<tr class="border-b last:border-0">
											<td class="px-6 py-3 font-semibold">{row.language}</td>
											<td class="px-6 py-3 text-foreground-muted">{row.model}</td>
											<td class="px-6 py-3">
												<span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-bold ${bandTones[row.tone]}`}>{row.band}</span>
											</td>
											<td class="px-6 py-3 text-right text-foreground-subtle">
												<span aria-hidden="true">••••</span>
												<span class="sr-only">Locked — register to view</span>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>

					<div class="flex flex-wrap items-center justify-between gap-3 border-t px-6 py-4">
						<p class="m-0 text-sm text-foreground-muted">Exact scores for all <span class="font-semibold text-foreground tabular-nums">30</span> languages</p>
						<a href="/m-gate/register" class="btn btn-primary btn-icon-left btn-sm">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
								<rect width="256" height="256" fill="none"></rect>
								<rect x="40" y="88" width="176" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect>
								<path d="M88,88V56a40,40,0,0,1,80,0V88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path>
							</svg>
							Unlock scores
						</a>
					</div>
				</div>

				<!-- 3. Keep the headers, empty the cells -->
				<div class="overflow-hidden rounded-lg border bg-background-softest">
					<div class="border-b px-6 py-4">
						<h3 class="m-0 text-base font-bold">3 — Keep the headers, empty the cells</h3>
						<p class="mt-1 mb-0 text-xs text-foreground-subtle">You always know exactly what you're missing.</p>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead class="border-b text-xs text-foreground-subtle">
								<tr>
									<th scope="col" class="px-6 py-3 font-semibold">Language</th>
									<th scope="col" class="px-6 py-3 text-right font-semibold">Models</th>
									<th scope="col" class="px-6 py-3 font-semibold">Best model</th>
									<th scope="col" class="px-6 py-3 text-right font-semibold">Tokenizer cost</th>
								</tr>
							</thead>
							<tbody>
								{
									gateMatrix.map((row) => (
										<tr class="border-b last:border-0">
											<td class="px-6 py-3 font-semibold">{row.language}</td>
											<td class="px-6 py-3 text-right text-foreground-muted tabular-nums">{row.models}</td>
											<td class="px-6 py-3 text-foreground-muted">{row.best}</td>
											<td class="px-6 py-3">
												<span class="ml-auto flex h-4 w-4 text-foreground-subtle" aria-hidden="true">
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
														<rect width="256" height="256" fill="none" />
														<rect x="40" y="88" width="176" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
														<path d="M88,88V56a40,40,0,0,1,80,0V88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													</svg>
												</span>
												<span class="sr-only">Locked — register to view</span>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>

					<div class="flex flex-wrap items-center justify-between gap-3 border-t px-6 py-4">
						<p class="m-0 text-sm text-foreground-muted"><span class="font-semibold text-foreground tabular-nums">1</span> of <span class="font-semibold text-foreground tabular-nums">4</span> columns locked</p>
						<a href="/m-gate/register" class="btn btn-primary btn-icon-left btn-sm">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
								<rect width="256" height="256" fill="none"></rect>
								<rect x="40" y="88" width="176" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect>
								<path d="M88,88V56a40,40,0,0,1,80,0V88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path>
							</svg>
							Unlock columns
						</a>
					</div>
				</div>

				<!-- 4. Shape without the scale -->
				<div class="overflow-hidden rounded-lg border bg-background-softest">
					<div class="border-b px-6 py-4">
						<h3 class="m-0 text-base font-bold">4 — Shape without the scale</h3>
						<p class="mt-1 mb-0 text-xs text-foreground-subtle">The ranking is readable. The axis that would let you quote it is not.</p>
					</div>

					<div class="px-6 pt-5 pb-4">
						{
							gateRows.map((row) => (
								<div class="mb-1.5 flex items-center gap-3.5">
									<div class="flex w-[150px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
										<span class="overflow-hidden text-ellipsis whitespace-nowrap">{row.name}</span>
										<span class="h-2 w-2 flex-none rounded-full" style={`background: ${row.color};`} />
									</div>
									<div class="relative h-6 flex-1">
										<div class="absolute top-0 h-full rounded-[5px] opacity-60" style={`left: ${row.left}%; width: ${row.width}%; background: ${row.color};`} />
									</div>
								</div>
							))
						}
						<div class="relative mt-0.5 ml-[164px] h-4">
							{
								[0, 20, 40, 60, 80, 100].map((left) => (
									<span class="absolute -translate-x-1/2 text-[10px] text-foreground-subtle" style={`left: ${left}%;`} aria-hidden="true">
										••
									</span>
								))
							}
						</div>
						<p class="mt-1.5 text-center text-[11px] text-foreground-subtle">MCC — values hidden</p>
					</div>

					<div class="flex flex-wrap items-center justify-between gap-3 border-t px-6 py-4">
						<p class="m-0 text-sm text-foreground-muted">Ranking shown, exact scores hidden</p>
						<a href="/m-gate/register" class="btn btn-primary btn-icon-right btn-sm">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M128,56C48,56,16,128,16,128s32,72,112,72,112-72,112-72S208,56,128,56Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><circle cx="128" cy="128" r="32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle></svg>
							Show values
						</a>
					</div>
				</div>

				<!-- 5. Gate the export, not the view -->
				<div hidden class="overflow-hidden rounded-lg border bg-background-softest lg:col-span-2">
					<div class="border-b px-6 py-4">
						<h3 class="m-0 text-base font-bold">5 — Gate the export, not the view</h3>
						<p class="mt-1 mb-0 text-xs text-foreground-subtle">Everything on screen stays open and indexable. Registering buys the data in a form you can actually work with.</p>
					</div>

					<div class="flex flex-wrap items-center gap-3 px-6 py-5">
						{
							['Download CSV', 'API access', 'Custom chart', 'Full PDF report'].map((label) => (
								<a href="/m-gate/register" class="btn btn-outline btn-icon-left btn-sm">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
										<rect width="256" height="256" fill="none" />
										<rect x="40" y="88" width="176" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
										<path d="M88,88V56a40,40,0,0,1,80,0V88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
									</svg>
									{label}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
