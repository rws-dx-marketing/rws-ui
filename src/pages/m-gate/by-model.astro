---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="By model – M-GATE">
	<!-- Hero -->
	<section class="grid- min-h-[min(calc(100svh-16rem),48rem)]- place-items-center- pb-20- md:pb-24- lg:pb-32- pt-16 md:pt-20 lg:pt-24" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>Consectetur adipiscing elit</p>
			</div>

			<h1 class="mx-auto mb-6 max-w-[16ch] text-4xl font-bold tracking-tight md:text-5xl xl:text-6xl">
				<p>By model</p>
			</h1>

			<div class="mx-auto prose prose-xl max-w-[56ch] text-foreground-muted md:prose-2xl">
				<p>How does this specific model perform across languages and tasks? Lorem ipsum dolor sit, amet consectetur adipisicing elit vitae quo animi.</p>
			</div>

			<div hidden class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="#" class="btn btn-primary btn-xl">View leaderboard</a>
				<a href="#" class="btn btn-outline btn-xl">Read methodology</a>
			</div>
		</div>
	</section>

	<!-- Filters + charts -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Filters -->
			<div class="top-[calc(var(--content-top)+1rem)] z-999 rounded-lg border bg-background/75 backdrop-blur-sm transition-[top] duration-300 lg:sticky">
				<div class="flex flex-col items-center justify-between gap-4 p-4 md:flex-row">
					<div class="flex gap-8">
						<!-- Model -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" id="model-filter-button" popovertarget="model-filter-popover" popovertargetaction="toggle" type="button" style="anchor-name: --model-filter-anchor;">
								<span class="flex-1 text-left">claude-opus-4.6</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg class="ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							</button>

							<div id="model-filter-popover" popover="auto" role="menu" aria-labelledby="model-filter-button" class="dropdown z-10 mt-1 w-60 rounded border shadow-lg" style="position-anchor: --model-filter-anchor; position-area: bottom span-right;">
								<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-sm select-none" aria-labelledby="model-filter-button">
									{
										['claude-opus-4.6', 'claude-sonnet-4.6', 'jamba-2', 'claude-haiku-4.6', 'deepseek-v3.2', 'grok-4.20', 'llama-4-scout', 'deepseek-r2', 'gpt-5-mini', 'gemini-3-flash-preview', 'yi-2-large', 'qwen-3-72b', 'gemini-3-pro-preview', 'mistral-medium-3', 'command-r-plus', 'gpt-5.4', 'gpt-5', 'llama-4-maverick', 'gpt-5-nano', 'phi-5', 'mistral-large-3', 'qwen-3-235b', 'gemini-3-pro', 'command-r', 'kimi-k2.6'].map((model) => (
											<li>
												<label class="inline-flex w-full items-center gap-2 rounded px-2 py-1.5 transition-colors hover:bg-accent-softer has-checked:bg-accent-softest hover:has-checked:bg-accent-softer">
													<input data-filter-input type="radio" value={model} name="model" class="input input-radio" />
													{model}
												</label>
											</li>
										))
									}
								</ul>
							</div>
						</div>

						<div class="flex items-center gap-8">
							<div class="flex gap-3">
								<span>Frontier</span>
								<span>&bull;</span>
								<span>Variants: default, thinking, adaptive</span>
							</div>
						</div>
					</div>

					<div hidden class="-my-1.25 -ml-1.25 flex gap-0.5 rounded bg-foreground-softer p-1.25">
						<button class="btn btn-ghost rounded-sm text-foreground-muted data-[active]:bg-background data-[active]:text-foreground" data-active>Grammar</button>
						<button class="btn btn-ghost rounded-sm text-foreground-muted">Translation</button>
						<button class="btn btn-ghost rounded-sm text-foreground-muted">Tokenizer</button>
					</div>

					<div class="flex gap-4">
						<!-- Languages -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" id="language-filter-button" popovertarget="language-filter-popover" popovertargetaction="toggle" type="button" style="anchor-name: --language-filter-anchor;">
								<span class="flex-1 text-left">Languages</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg class="ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							</button>

							<div id="language-filter-popover" popover="auto" role="menu" aria-labelledby="language-filter-button" class="dropdown z-10 mt-1 w-56 rounded border shadow-lg" style="position-anchor: --language-filter-anchor; position-area: bottom span-left;">
								<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-sm select-none" aria-labelledby="language-filter-button">
									{
										['Albanian', 'Arabic', 'Assamese', 'Basque', 'Czech', 'English', 'Fijian', 'Finnish', 'French', 'German', 'Greek', 'Hebrew', 'Hindi', 'Hungarian', 'Icelandic', 'Japanese', 'Khmer', 'Kinyarwanda', 'Korean', 'Kyrgyz', 'Nepali', 'Polish', 'Russian', 'Simplified Chinese', 'Spanish', 'Swahili', 'Tagalog', 'Tamil', 'Thai', 'Turkish', 'Vietnamese', 'Welsh', 'Zulu'].map((lang) => (
											<li>
												<label class="inline-flex w-full items-center gap-2 rounded px-2 py-1.5 transition-colors hover:bg-accent-softer has-checked:bg-accent-softest hover:has-checked:bg-accent-softer">
													<input data-filter-input type="checkbox" value={lang.toLowerCase().replace(/\s+/g, '-')} name="language" class="input input-checkbox" />
													{lang}
												</label>
											</li>
										))
									}
								</ul>
								<div data-filter-clear hidden class="mx-2 border-t pt-1 pb-2"><button type="button" class="px-2 py-1 text-left text-sm font-semibold text-foreground-subtle transition-colors hover:text-accent" disabled>Clear selected</button></div>
							</div>
						</div>

						<!-- Filters -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" type="button">
								<span class="flex-1 text-left">Filters</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="64" y1="136" x2="192" y2="136" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="24" y1="88" x2="232" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="104" y1="184" x2="152" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Stats -->
			<div class="mt-8 grid gap-8 sm:data-[count='3']:grid-cols-3 sm:data-[count='4']:grid-cols-2 sm:data-[count='5']:grid-cols-2 lg:data-[count='4']:grid-cols-4 lg:data-[count='5']:grid-cols-5" data-count="5">
				<div class="@container grid place-content-center rounded-lg border p-6 text-center" data-card>
					<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 200ms" data-count-up>#4</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 200ms">
						<p class="text-lg/tight font-bold">Grammar</p>
						<!-- <p>for new customers</p> -->
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg border p-6 text-center" data-card>
					<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 300ms" data-count-up>#6</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 300ms">
						<p class="text-lg/tight font-bold">Translation</p>
						<!-- <p>across multiple regions</p> -->
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg border p-6 text-center" data-card>
					<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 400ms" data-count-up>#38</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 400ms">
						<p class="text-lg/tight font-bold">Tokenizer</p>
						<!-- <p>of continual growth</p> -->
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg border p-6 text-center" data-card>
					<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 500ms" data-count-up>8.2s</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 500ms">
						<p class="text-lg/tight font-bold">Latency</p>
						<!-- <p>of continual growth</p> -->
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg border p-6 text-center" data-card>
					<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 600ms" data-count-up>$25</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 600ms">
						<p class="text-lg/tight font-bold">Cost/1M</p>
						<!-- <p>of continual growth</p> -->
					</div>
				</div>
			</div>

			<!-- Charts -->
			<div class="mt-8 aspect-2/1 rounded-lg border bg-background-softest p-8">
				<h3 class="mb-4 text-xl font-bold text-foreground-muted">Heatmap – grammar MCC across languages</h3>
				<ul class="text-foreground-muted">
					<li>Single-model row from the full heatmap, all languages shown, color coded, sorted by language</li>
				</ul>
			</div>

			<div class="mt-8 aspect-2/1 rounded-lg border bg-background-softest p-8">
				<h3 class="mb-4 text-xl font-bold text-foreground-muted">Heatmap – translation MCC across languages</h3>
				<ul class="text-foreground-muted">
					<li>Single-model row from the full heatmap, all languages shown, color coded, sorted by language</li>
				</ul>
			</div>

			<div class="mt-8 aspect-2/1 rounded-lg border bg-background-softest p-8">
				<h3 class="mb-4 text-xl font-bold text-foreground-muted">Heatmap – characters per token across languages</h3>
				<ul class="text-foreground-muted">
					<li>Single-model row from the full heatmap, all languages shown, color coded, sorted by language</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
