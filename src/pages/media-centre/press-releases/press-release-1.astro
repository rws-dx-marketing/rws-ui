---
// @ts-nocheck
// Press release detail. A copy of the blog article template
// (/resources/blog-1/) with the byline swapped for a dateline and the author
// bio block swapped for the standard "About RWS" boilerplate — everything else
// (sticky sidebar, scrollspy TOC, pull quote, tags, related grid, contact form)
// is the same furniture the article page uses.
//
// One hand-authored prototype; in the real build this becomes a [slug] route.
import Layout from '../../../layouts/Layout.astro'
import ResourceHero from '../../../blocks/ResourceHero.astro'
import Form from '../../../components/Form.astro'
import { pressReleases } from '../../../data/media-centre/press-releases'

const related = pressReleases.slice(1, 4)
---

<Layout title="RWS opens AI language research hub in Lisbon – Press releases – RWS UI">
	<ResourceHero title="RWS opens AI language research hub in Lisbon" date="14 July 2026" location="Lisbon, Portugal" readTime="4 min read" image={{ src: 'https://www.rws.com/media/dynamic/images/hallucinations_tcm228-295285.webp?original=.png&v=20260402100433', alt: 'Placeholder' }} description="The new facility brings together linguists, data specialists and engineers to advance evaluation methods for multilingual AI." share />

	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto grid max-w-screen-xl gap-8 px-8 lg:grid-cols-12 lg:px-12 xl:gap-12">
			<aside class="hidden lg:col-span-4 lg:block">
				<div class="grid gap-8 transition-[top] duration-300 lg:sticky lg:top-[calc(var(--content-top)+4rem)] xl:gap-12">
					<div class="relative rounded-lg border p-10" data-card hidden>
						<h4 class="mb-6 text-lg font-bold">Table of contents</h4>

						<nav class="relative flex flex-col gap-3 pl-6" data-scrollspy-nav>
							<span aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-full w-1 bg-foreground-softer"></span>
							<span aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-(--post-nav-active-height) w-1 bg-accent transition-[height] duration-1000" data-scrollspy-rail></span>
							<a href="#" class="hidden text-pretty text-foreground-subtle transition-colors hover:text-foreground data-[nav-active=true]:text-foreground" data-scrollspy-link-template aria-hidden="true">Template nav link</a>

							<div class="relative" data-scrollspy-end>
								<div class="absolute -left-5.5 -translate-x-1/2 rounded-full bg-background outline-2 outline-background">
									<svg class="size-6 text-foreground-soft delay-350 data-[nav-active=true]:text-accent" data-scrollspy-end-icon data-nav-active="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path fill="currentColor" d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
								</div>

								<span class="text-foreground-subtle transition-colors data-[nav-active=true]:text-foreground" data-scrollspy-end-label>You’ve reached the end</span>
							</div>
						</nav>

						<canvas aria-hidden="true" class="pointer-events-none absolute inset-0 size-full rounded-lg" data-scrollspy-confetti-canvas></canvas>
					</div>

					<div class="rounded-lg border p-6" data-card>
						<div class="flex items-start gap-6">
							<div class="w-1/3 max-w-20 shrink-0">
								<img src="https://placehold.co/200" alt="Placeholder" class="aspect-square size-full rounded object-cover" />
							</div>

							<div>
								<h4 class="text-lg font-semibold">Media enquiries</h4>

								<div class="prose text-sm/normal text-foreground-muted not-first:mt-2">
									<p>For interview requests, images or comment, contact the RWS press office.</p>
								</div>

								<a href="mailto:ddavies@rws.com?subject=Media%20centre%20enquiry" class="btn btn-secondary btn-sm not-first:mt-4">Get in touch</a>
							</div>
						</div>
					</div>
				</div>
			</aside>

			<article class="col-span-full grid gap-8 lg:col-span-8 xl:gap-12 [&_h2[id]]:scroll-mt-20">
				<div class="rounded-lg border p-6 lg:p-10" data-card data-scrollspy-content>
					<div class="prose max-w-none text-pretty lg:text-lg">
						<p class="lead">RWS, the world-leading provider of technology-enabled language, content and intellectual property services, today announced the opening of a dedicated AI language research hub in Lisbon.</p>
						<p>The facility brings together linguists, data specialists and machine learning engineers in one location, with a remit to advance how multilingual AI systems are measured. Its first programmes focus on evaluation: how to tell, reliably and repeatably, whether a model performs as well in Portuguese, Japanese or Arabic as it does in English.</p>
						<p>The hub will work alongside the company’s existing engineering centres and its global community of more than 43,000 language experts, whose judgements provide the human reference points that automated metrics are calibrated against.</p>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque venenatis felis posuere. Nullam lectus orci, maximus vel nibh vel, congue sodales ex. Integer auctor nulla vel leo, sed vestibulum ligula tempor id.</p>
					</div>
				</div>

				<div>
					<img src="https://placehold.co/1024x768" alt="Placeholder" class="aspect-video size-full rounded object-cover" />
				</div>

				<div class="rounded-lg border p-6 lg:p-10" data-card data-scrollspy-content>
					<div class="prose max-w-none text-pretty lg:text-lg">
						<h2>Why evaluation, and why now</h2>
						<p>Buyers increasingly ask a question that benchmark leaderboards do not answer: will this model behave the same way for my customers, in their language, in my regulatory context?</p>
						<p>Answering it requires evaluation designed language by language rather than translated wholesale from English. The hub’s early work covers three areas:</p>
						<ul>
							<li>Reference sets built by native speakers rather than machine-translated from English originals</li>
							<li>Task definitions that make cultural and regulatory constraints explicit instead of assumed</li>
							<li>Scoring methods that report uncertainty rather than collapsing it into a single number</li>
						</ul>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque venenatis felis posuere. Nullam lectus orci, maximus vel nibh vel, congue sodales ex.</p>
					</div>
				</div>

				<figure class="rounded-lg p-6 lg:p-10" data-theme="primary">
					<div class="svg-current mx-auto mb-2 size-12 text-accent">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M116,72v88a48.05,48.05,0,0,1-48,48,8,8,0,0,1,0-16,32,32,0,0,0,32-32v-8H40a16,16,0,0,1-16-16V72A16,16,0,0,1,40,56h60A16,16,0,0,1,116,72ZM216,56H156a16,16,0,0,0-16,16v64a16,16,0,0,0,16,16h60v8a32,32,0,0,1-32,32,8,8,0,0,0,0,16,48.05,48.05,0,0,0,48-48V72A16,16,0,0,0,216,56Z"></path></svg>
					</div>

					<blockquote class="space-y-[0.5em] text-center text-2xl text-pretty *:first:before:content-['“'] *:last:after:content-['”']">
						<p>Every organization deploying AI eventually hits the same wall: it works in English and nobody can say with confidence what it does anywhere else.</p>
						<p>This hub exists to close that gap, with methods our clients can inspect and reproduce rather than take on trust.</p>
					</blockquote>

					<figcaption class="mt-6 flex items-center justify-center space-x-3">
						<img class="size-6 rounded-full" src="https://www.rws.com/media/fallback/images/executive-group-240x240-rws-Maria-Schnell_tcm228-197638.png?v=20260729092253" alt="Maria Schnell" />

						<div class="flex items-center divide-x divide-foreground-subtle">
							<div class="pr-3">Maria Schnell</div>
							<div class="pl-3 text-foreground-muted">Chief Language Officer, RWS</div>
						</div>
					</figcaption>
				</figure>

				<div class="rounded-lg border p-6 lg:p-10" data-card data-scrollspy-content>
					<div class="prose max-w-none text-pretty lg:text-lg">
						<h2>Notes to editors</h2>
						<p>The Lisbon hub is expected to reach full headcount during the 2027 financial year. Images and executive headshots are available on request from the press office.</p>
						<blockquote>
							<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Recusandae, necessitatibus. Impedit id qui suscipit, quas unde dolorum eveniet odio ullam tenetur ipsa expedita vero maiores excepturi rerum ipsam repudiandae doloremque!</p>
						</blockquote>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque venenatis felis posuere.</p>
					</div>
				</div>

				<div class="rounded-lg border p-6 lg:p-10" data-card>
					<div class="flex flex-wrap gap-x-6 gap-y-2">
						<div class="flex flex-wrap gap-x-4 gap-y-1.5">
							<h3 class="font-bold">Tags:</h3>
							<a href="#" class="font-semibold transition-colors hover:text-accent">Company news</a>
							<a href="#" class="font-semibold transition-colors hover:text-accent">Artificial Intelligence (AI)</a>
							<a href="#" class="font-semibold transition-colors hover:text-accent">Language &amp; Culture</a>
						</div>
					</div>
				</div>

				<div class="rounded-lg p-6 lg:p-10" data-theme="tertiary">
					<p class="mb-3 text-sm/none font-semibold text-accent sm:text-base/none">About RWS</p>
					<p class="text-2xl/none font-bold sm:text-3xl/none">RWS Holdings plc</p>

					<div class="prose mt-6 max-w-none text-pretty lg:text-lg">
						<p>RWS is a world-leading provider of technology-enabled services that help organizations generate, transform and protect content and ideas. Working with over 80 of the world’s top 100 brands, RWS combines AI-powered technology with the expertise of a global community of language and subject-matter specialists.</p>
						<p>RWS is headquartered in the UK and listed on AIM, a market operated by the London Stock Exchange (RWS.L).</p>
					</div>

					<a href="/media-centre/press-releases/" class="btn btn-secondary btn-icon-right mt-6">
						All press releases
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
					</a>
				</div>
			</article>
		</div>
	</section>

	<!-- Related press releases -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<h2 class="mb-6 max-w-[24ch] text-4xl font-bold tracking-tight text-pretty xl:text-5xl">
				<p>Related <em>press releases</em></p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				<p>More announcements from across the RWS group.</p>
			</div>

			<div class="mt-12 grid max-w-[80ch] gap-8 sm:grid-cols-2 lg:mt-16 lg:max-w-none lg:grid-cols-3">
				{
					related.map((release) => (
						<article class="group relative rounded-lg border text-left" data-card>
							<div class="flex h-full flex-col">
								<div class="p-4">
									<div class="mb-5 block overflow-hidden rounded">
										<img class="aspect-video w-full object-cover transition-transform group-hover:scale-110" src={release.image} alt={release.name} />
									</div>

									<span class="mb-3 inline-block rounded-full border bg-foreground-softest px-2 py-0.5 text-xs font-semibold text-foreground-muted">{release.type}</span>

									<h3 class="mb-2 text-2xl font-bold">
										<p>
											<a href={release.href}>
												{release.name}
												<span class="absolute inset-0" />
											</a>
										</p>
									</h3>

									<div class="mb-3 flex items-center gap-1.5 text-sm font-semibold text-foreground-muted">
										<span>{release.date}</span>
									</div>

									<div class="prose line-clamp-3 text-pretty text-foreground-muted">
										<Fragment set:html={release.description} />
									</div>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Press office contact -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="pale">
		<div class="mx-auto grid max-w-screen-xl items-center gap-12 px-8 lg:grid-cols-12 lg:px-12 xl:gap-16">
			<div class="lg:col-span-7">
				<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
					<p>Press office</p>
				</div>

				<h2 class="mb-6 text-4xl font-bold tracking-tight xl:text-5xl">
					<p>Working on a story?</p>
				</h2>

				<div class="prose text-foreground-muted md:prose-lg">
					<p>The RWS press office can help with interviews, images, data and background briefings. We aim to respond within one working day.</p>

					<ul>
						<li>
							<p>Executive interviews and expert commentary</p>
						</li>
						<li>
							<p>High-resolution headshots, logos and product imagery</p>
						</li>
						<li>
							<p>Research data and report embargo copies</p>
						</li>
					</ul>

					<p>For investor enquiries, please contact the investor relations team instead.</p>
				</div>

				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a href="/media-centre/media-resources/" class="btn btn-secondary btn-icon-right">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
						Media resources
					</a>
				</div>
			</div>

			<div class="h-full lg:col-span-5">
				<div class="rounded-lg border p-8" data-card>
					<h3 class="mb-4 text-2xl font-semibold">
						<p>Contact the press office</p>
					</h3>

					<div class="prose mb-6 text-foreground-muted">
						<p>Tell us what you’re working on and when you need it by, and we’ll come back to you.</p>
					</div>

					<Form />
				</div>
			</div>
		</div>
	</section>
</Layout>
