		</div>
	</dialog>

	<footer class="footer grid min-h-[min(50svh,48rem)] place-items-center bg-background py-8 text-foreground/80" data-theme="tertiary">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="flex gap-4">
				<button type="button" class="btn btn-primary" commandfor="report-dialog" command="show-modal">Launch modal</button>
			</div>
		</div>
	</footer>
</Layout>

<script>
	// @ts-nocheck
	if (typeof window !== 'undefined') {
		const dialog = document.querySelector('#report-dialog')
		const footer = document.querySelector('.footer')

		if (dialog) {
			let savedOverflow = null

			const lockScroll = () => {
				if (savedOverflow !== null) return
				savedOverflow = document.documentElement.style.overflow || ''
				document.documentElement.style.overflow = 'hidden'
			}

			const unlockScroll = () => {
				if (savedOverflow === null) return
				document.documentElement.style.overflow = savedOverflow
				savedOverflow = null
			}

			const openDialog = () => {
				if (dialog.open) return

				dialog.showModal?.() ?? dialog.setAttribute('open', 'true')
			}

			const setupObserver = () => {
				if (!('IntersectionObserver' in window)) return
				if (!footer) return

				let canAutoOpen = true

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) {
								canAutoOpen = true
								continue
							}

							if (!canAutoOpen) continue

							canAutoOpen = false
							openDialog()
							break
						}
					},
					{
						root: null,
						threshold: 0,
					},
				)

				observer.observe(footer)
			}

			dialog.addEventListener('click', (e) => {
				if (e.target === dialog) dialog.close()
			})

			dialog.addEventListener('toggle', (event) => {
				if (event.newState === 'open') {
					lockScroll()
				} else if (event.newState === 'closed') {
					unlockScroll()
				}
			})

			setupObserver()
		}
	}
</script>
