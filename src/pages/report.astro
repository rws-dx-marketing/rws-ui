									<div class="w-1/3 shrink-0">
										<a href="#" tabindex="-1">
											<img src="/images/placeholder-1.png" alt="Placeholder" class="aspect-4/3 rounded-sm object-cover" />
										</a>
									</div>
									<div>
										<h4 class="text-lg font-semibold xl:text-xl">
											<a href="#">Article A title goes here</a>
										</h4>
