---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/Section.astro'
import Heading from '../../components/Heading.astro'

// Background image for the hero. Set on the section as --bg-image and applied
// with Tailwind's bg-(image:--bg-image) utility.
const bgImage = '/images/skyline-1.jpg'

// Goo blob settings — the shared params and the goo skin's own controls.
// These are the script's current defaults; change them here and the page
// passes them to blob.js through [data-blob-settings].
const blob = {
	amp: 0, // displacement amplitude
	freq: 0, // noise frequency across the surface
	speed: 0.35, // noise scroll through time
	hover: 0.4, // bulge height under the pointer
	inertia: 1, // how hard scroll kicks the spring
	tilt: 1, // how far the mark leans toward the cursor (0 = none, 1 ≈ 3°, 2 ≈ 6°)
	controls: {
		count: 3, // satellites (0–9)
		roam: 0.7, // how far they orbit (0–0.8)
		size: 0.7, // satellite size (0.2–2.5)
		core: 1, // body size (0.3–2.5)
		speed: 3, // orbit speed (0–8)
		goo: 0.4, // gooeyness: the smooth-min blend radius (0.02–0.6)
		rim: 0, // rim light (0–1.5)
		light: 0.5, // how far the key light follows the cursor (0 = fixed, 2 = exaggerated)
	},
}
---

<Layout title="Goo – RWS UI">
	<!-- Hero: split layout over a full-bleed background image -->
	<Section theme="tertiary" top="lg" bottom="lg" container={false} class="relative overflow-x-clip bg-(image:--bg-image) bg-cover bg-center bg-no-repeat" style={`--bg-image: url('${bgImage}')`} data-blob-lab data-blob-settings={JSON.stringify(blob)}>
		<!-- Tint so the copy stays legible over any image -->
		<div class="absolute inset-0 bg-linear-to-r from-background/80 to-background/20" aria-hidden="true"></div>

		<div class="relative mx-auto grid w-full max-w-screen-xl items-center gap-12 px-8 lg:grid-cols-12 lg:px-12 xl:gap-16">
			<!-- Copy -->
			<div class="lg:col-span-6">
				<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
					<p>weava world of possibility</p>
				</div>

				<Heading as="h1" size="md" class="mb-6 max-w-[16ch] font-bold tracking-tight text-pretty">
					<p>Stop translating.<br />Start transforming.</p>
				</Heading>

				<div class="prose prose-xl max-w-[48ch] text-foreground-muted not-last:mb-8 md:prose-2xl">
					<p>Designed for real markets, real people, real impact.</p>
				</div>

				<div class="flex flex-col gap-4 sm:flex-row">
					<a href="#" class="btn btn-primary btn-xl">Get started</a>
					<a href="#" class="btn btn-ghost btn-xl">Find a solution</a>
				</div>
			</div>

			<!-- Blob -->
			<div class="lg:col-span-6">
				<div class="relative aspect-square w-full touch-none [&>canvas]:pointer-events-none [&>canvas]:absolute [&>canvas]:top-1/2 [&>canvas]:left-1/2 [&>canvas]:block [&>canvas]:size-[200%] [&>canvas]:-translate-1/2" data-blob="goo" aria-hidden="true"></div>
			</div>
		</div>
	</Section>

	<section class="h-screen"></section>
</Layout>
