			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-icon-right btn-md">
					<!-- external link -->
					<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"></path></svg>
					<!-- arrow  -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Groups</h3>

			<div class="mt-6 flex items-center gap-4">
				<div class="btn-group" role="group">
					<button type="button" class="btn btn-primary">Button 1</button>
					<button type="button" class="btn btn-outline">Button 2</button>
					<button type="button" class="btn btn-outline">Button 3</button>
				</div>
				<div class="btn-group" role="group">
					<button type="button" class="btn btn-outline">Button 1</button>
					<button type="button" class="btn btn-secondary">Button 2</button>
					<button type="button" class="btn btn-outline">Button 3</button>
				</div>
				<div class="btn-group" role="group">
					<button type="button" class="btn btn-outline">Button 1</button>
					<button type="button" class="btn btn-outline">Button 2</button>
					<button type="button" class="btn btn-tertiary">Button 3</button>
				</div>
			</div>

			<div class="mt-6 flex items-center gap-4">
				<div class="btn-group" role="group">
					<button class="btn btn-primary border-foreground-soft">Button 1</button>
					<button class="btn btn-primary border-foreground-soft">Button 2</button>
					<button class="btn btn-primary border-foreground-soft">Button 3</button>
				</div>
			</div>

			<div class="mt-6 flex items-center gap-4">
				<div class="btn-group" role="group">
					<button class="btn btn-outline btn-lg rounded-sm">Button 1</button>
					<button class="btn btn-outline btn-lg rounded-sm">Button 2</button>
					<button class="btn btn-outline btn-lg rounded-sm">Button 3</button>
					<button class="btn btn-outline btn-lg rounded-sm">Button 4</button>
					<button class="btn btn-outline btn-lg rounded-sm">Button 5</button>
				</div>
			</div>
		</section>

		<section class="mt-24 mb-12 space-y-6">
			<h3 class="text-2xl font-semibold">Themes</h3>

			{
				themeVariants.map((variant) => (
					<div class="isolate p-12" data-theme={variant.theme}>
						<h4 class="text-lg font-bold">{variant.name}</h4>
						<p class="text-foreground-muted">Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>

						<div class="mt-6 flex gap-4">
							<button class="btn btn-primary">Primary</button>
							<button class="btn btn-secondary">Secondary</button>
							<button class="btn btn-tertiary">Tertiary</button>
							<button class="btn btn-quaternary">Quaternary</button>
							<button class="btn btn-outline">Outline</button>
							{/* <button class="btn btn-outline-primary">Primary</button>
							<button class="btn btn-outline-secondary">Secondary</button>
							<button class="btn btn-outline-tertiary">Tertiary</button> */}
							<button class="btn btn-ghost">Ghost</button>
							<button class="btn btn-link">Link</button>
						</div>
					</div>
				))
			}
		</section>

		<header class="mt-24 mb-10 space-y-2">
			<h2 class="text-2xl font-semibold">Typography</h2>
		</header>

		<div class="grid gap-x-12 gap-y-12 lg:grid-cols-2">
			<section class="space-y-6">
				<h3 class="text-xl font-semibold">Type scale</h3>
				<div class="mt-6 divide-y divide-gray-200 dark:divide-gray-700">
					{
						textScale.map((t) => (
							<div class="flex items-center gap-6 py-4">
								<div class="w-44 shrink-0 space-y-0.5">
									<code class="block text-sm font-semibold">{t.name}</code>
									<span class="text-body-subtle block text-xs">
										{t.rem} · {t.px}px
									</span>
								</div>
								<p class={`${t.name} -mt-[0.1lh] mb-[0.1lh]`}>Ag</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="space-y-6">
				<h3 class="text-xl font-semibold">Font weights</h3>
				<!-- <p class="text-body-subtle text-sm">
					Body text defaults to <code class="font-semibold text-foreground">font-medium</code>. Use <code class="font-semibold text-foreground">font-semibold</code> and
					<code class="font-semibold text-foreground">font-bold</code> for emphasis and headings.
				</p> -->
				<div class="mt-6 space-y-3">
					{
						fontWeights.map((w) =>
							w.note ? (
								<div class="flex items-baseline gap-6">
									<div class="w-44 shrink-0 space-y-0.5">
										<code class="block text-sm font-semibold">{w.name}</code>
										<span class="text-body-subtle block text-xs">
											{w.weight} · {w.note}
										</span>
									</div>
									<p class={`${w.name} min-w-0 truncate text-xl leading-tight`}>The quick brown fox</p>
								</div>
							) : (
								<div class="flex items-baseline gap-6">
									<div class="w-44 shrink-0 space-y-0.5">
										<code class="block text-sm">{w.name}</code>
										<span class="text-body-subtle block text-xs">{w.weight}</span>
									</div>
									<p class={`${w.name} min-w-0 truncate text-xl leading-tight`}>The quick brown fox</p>
								</div>
							),
						)
					}
				</div>
			</section>
		</div>

		<section class="mt-12 mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Heading sizes</h3>
			<!-- <p class="text-body-subtle text-sm">
				Responsive presets from <code class="font-semibold text-foreground">src/utils/heading-size.js</code>. Use these for page and section headings rather than raw
				<code class="font-semibold text-foreground">text-*</code> sizes — they scale across breakpoints automatically.
			</p> -->
			<div class="mt-6 divide-y divide-gray-200 dark:divide-gray-700">
				{
					Object.entries(headingSize).map(([key, cls]) => (
						<div class="space-y-2 py-5">
							<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
								<code class="text-sm font-semibold">{key}</code>
								<code class="text-body-subtle text-xs">{cls}</code>
							</div>
							<p class={`${cls} leading-tight font-bold`}>The quick brown fox</p>
						</div>
					))
				}
			</div>
		</section>

		<header class="mt-24 mb-10 space-y-2">
			<h2 class="text-2xl font-semibold">Forms</h2>
		</header>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Text inputs</h3>
			<div class="mt-6 max-w-sm space-y-4">
				<div>
					<label for="guide-name" class="mb-2 inline-block text-sm/none font-semibold text-foreground-muted">Full name</label>
					<input id="guide-name" type="text" class="input input-text" placeholder="Jane Doe" />
				</div>
				<div>
					<label for="guide-email" class="mb-2 inline-block text-sm/none font-semibold text-foreground-muted">Email address</label>
					<input id="guide-email" type="email" class="input input-text" placeholder="jane@example.com" />
				</div>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Select</h3>
			<div class="mt-6 max-w-sm">
				<select class="input input-select">
					<option value="" disabled selected>Please select</option>
					<option>United Kingdom</option>
					<option>United States</option>
					<option>Germany</option>
				</select>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Textarea</h3>
			<div class="mt-6 max-w-sm">
				<textarea rows="4" class="input input-textarea" placeholder="Type your message…"></textarea>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Checkbox</h3>
			<div class="mt-6 space-y-2">
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="guide-checkbox" checked class="input input-checkbox" />
					<span>Option one</span>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="guide-checkbox" class="input input-checkbox" />
					<span>Option two</span>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="guide-checkbox" class="input input-checkbox" />
					<span>Option three</span>
				</label>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Radio</h3>
			<div class="mt-6 space-y-2">
				<label class="flex items-center gap-2 text-sm">
					<input type="radio" name="guide-radio" checked class="input input-radio" />
					<span>Option one</span>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="radio" name="guide-radio" class="input input-radio" />
					<span>Option two</span>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="radio" name="guide-radio" class="input input-radio" />
					<span>Option three</span>
				</label>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">File</h3>
			<div class="mt-6 max-w-sm">
				<input type="file" class="input-file" />
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Sizes</h3>
			<div class="mt-6 grid max-w-3xl gap-6 sm:grid-cols-3">
				<div class="space-y-4">
					<input type="text" class="input input-text input-sm" placeholder="Small (sm)" />
					<input type="text" class="input input-text input-md" placeholder="Medium (md)" />
					<input type="text" class="input input-text input-lg" placeholder="Large (lg)" />
				</div>

				<div class="space-y-4">
					<select class="input input-select input-sm">
						<option value="" disabled selected>Small (sm)</option>
						<option>Option one</option>
						<option>Option two</option>
					</select>
					<select class="input input-select input-md">
						<option value="" disabled selected>Medium (md)</option>
						<option>Option one</option>
						<option>Option two</option>
					</select>
					<select class="input input-select input-lg">
						<option value="" disabled selected>Large (lg)</option>
						<option>Option one</option>
						<option>Option two</option>
					</select>
				</div>

				<div class="space-y-4">
					<textarea rows="2" class="input input-textarea input-sm" placeholder="Small (sm)"></textarea>
					<textarea rows="2" class="input input-textarea input-md" placeholder="Medium (md)"></textarea>
					<textarea rows="2" class="input input-textarea input-lg" placeholder="Large (lg)"></textarea>
				</div>
			</div>
		</section>

		<header class="mt-24 mb-10 space-y-2">
			<h2 class="text-2xl font-semibold">Ornaments</h2>
		</header>

		<section class="mb-12 space-y-6">
			<div class="mt-6">
				<h3 class="text-xl font-semibold">Divider</h3>
				<div class="mt-6">
					<div class="divider-top divider-bottom aspect-5/1" data-theme="tertiary"></div>
				</div>
			</div>

			<div class="mt-12">
				<h3 class="text-xl font-semibold">Glow</h3>
				<div class="mt-6 grid grid-cols-2 gap-12">
					<div class="glow aspect-5/1 rounded-lg" data-card></div>
					<div class="glow-animate aspect-5/1 rounded-lg" data-card></div>
				</div>
			</div>
		</section>

		<section class="mt-12 mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Gradient</h3>

			<div class="grid grid-cols-2 gap-12">
				<p class="text-gradient text-2xl font-bold">Lorem ipsum dolor sit amet</p>
				<p class="text-gradient-animate text-2xl font-bold">Lorem ipsum dolor sit amet</p>
			</div>

			<div class="mt-12 grid grid-cols-2 gap-12">
				<div class="aspect-5/1 bg-gradient"></div>
				<div class="aspect-5/1 bg-gradient-animate"></div>
			</div>
		</section>
	</main>
</Layout>
