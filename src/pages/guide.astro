---
import Layout from '../layouts/Layout.astro'
import { themes } from '../data/themes'
import { headingSize } from '../utils/heading-size'

const textScale = [
	{ name: 'text-2xs', rem: '0.625rem', px: 10 },
	{ name: 'text-xs', rem: '0.75rem', px: 12 },
	{ name: 'text-sm', rem: '0.875rem', px: 14 },
	{ name: 'text-base', rem: '1rem', px: 16 },
	{ name: 'text-lg', rem: '1.125rem', px: 18 },
	{ name: 'text-xl', rem: '1.25rem', px: 20 },
	{ name: 'text-2xl', rem: '1.5rem', px: 24 },
	{ name: 'text-3xl', rem: '1.875rem', px: 30 },
	{ name: 'text-4xl', rem: '2.25rem', px: 36 },
	{ name: 'text-5xl', rem: '3rem', px: 48 },
	{ name: 'text-6xl', rem: '3.75rem', px: 60 },
	{ name: 'text-7xl', rem: '4.5rem', px: 72 },
	{ name: 'text-8xl', rem: '6rem', px: 96 },
	{ name: 'text-9xl', rem: '8rem', px: 128 },
]

const fontWeights = [
	{ name: 'font-thin', weight: 100 },
	{ name: 'font-extralight', weight: 200 },
	{ name: 'font-light', weight: 300 },
	{ name: 'font-normal', weight: 400 },
	{ name: 'font-medium', weight: 500, note: 'Body default' },
	{ name: 'font-semibold', weight: 600, note: 'Emphasis' },
	{ name: 'font-bold', weight: 700, note: 'Headings' },
	{ name: 'font-extrabold', weight: 800 },
	// { name: 'font-black', weight: 900 },
]

const semanticPrimary = [
	{ name: 'primary-softest', hex: '#faf9ff', className: 'bg-primary-softest' },
	{ name: 'primary-softer', hex: '#f0eeff', className: 'bg-primary-softer' },
	{ name: 'primary-soft', hex: '#e2ddff', className: 'bg-primary-soft' },
	{ name: 'primary-subtle', hex: '#af9eff', className: 'bg-primary-subtle' },
	{ name: 'primary-muted', hex: '#977cff', className: 'bg-primary-muted' },
	{ name: 'primary', hex: '#8353fd', className: 'bg-primary' },
	{ name: 'primary-strong', hex: '#603bbc', className: 'bg-primary-strong' },
]

const semanticSecondary = [
	{ name: 'secondary-softest', hex: '#fff7f8', className: 'bg-secondary-softest' },
	{ name: 'secondary-softer', hex: '#ffe9ea', className: 'bg-secondary-softer' },
	{ name: 'secondary-soft', hex: '#ffd2d6', className: 'bg-secondary-soft' },
	{ name: 'secondary-subtle', hex: '#fa8795', className: 'bg-secondary-subtle' },
	{ name: 'secondary-muted', hex: '#f15875', className: 'bg-secondary-muted' },
	{ name: 'secondary', hex: '#e60054', className: 'bg-secondary' },
	{ name: 'secondary-strong', hex: '#aa013c', className: 'bg-secondary-strong' },
]

const semanticTertiary = [
	{ name: 'tertiary-softest', hex: '#fbf9ff', className: 'bg-tertiary-softest' },
	{ name: 'tertiary-softer', hex: '#f4edff', className: 'bg-tertiary-softer' },
	{ name: 'tertiary-soft', hex: '#e9ddfe', className: 'bg-tertiary-soft' },
	{ name: 'tertiary-subtle', hex: '#856dab', className: 'bg-tertiary-subtle' },
	{ name: 'tertiary-muted', hex: '#603e8d', className: 'bg-tertiary-muted' },
	{ name: 'tertiary', hex: '#3e016f', className: 'bg-tertiary' },
	{ name: 'tertiary-strong', hex: '#2b0050', className: 'bg-tertiary-strong' },
]

const semanticQuaternary = [
	{ name: 'quaternary-softest', hex: '#fffbeb', className: 'bg-quaternary-softest' },
	{ name: 'quaternary-softer', hex: '#fff3c9', className: 'bg-quaternary-softer' },
	{ name: 'quaternary-soft', hex: '#ffeba3', className: 'bg-quaternary-soft' },
	{ name: 'quaternary-subtle', hex: '#ffe27d', className: 'bg-quaternary-subtle' },
	{ name: 'quaternary-muted', hex: '#ffd74a', className: 'bg-quaternary-muted' },
	{ name: 'quaternary', hex: '#ffc700', className: 'bg-quaternary' },
	{ name: 'quaternary-strong', hex: '#e6b300', className: 'bg-quaternary-strong' },
]

const semanticNeutral = [
	{ name: 'foreground-softest', hex: '#f7f7f7', className: 'bg-foreground-softest' },
	{ name: 'foreground-softer', hex: '#efefef', className: 'bg-foreground-softer' },
	{ name: 'foreground-soft', hex: '#e0dfdf', className: 'bg-foreground-soft' },
	{ name: 'foreground-subtle', hex: '#6a6966', className: 'bg-foreground-subtle' },
	{ name: 'foreground-muted', hex: '#3e3d3b', className: 'bg-foreground-muted' },
	{ name: 'foreground', hex: '#181514', className: 'bg-foreground' },
	{ name: 'foreground-strong', hex: '#000000', className: 'bg-foreground-strong' },
]

const themeVariants = themes.map((theme) => ({
	theme,
	name: theme
		.split('-')
		.map((w) => w[0].toUpperCase() + w.slice(1))
		.join(' '),
}))
---

<Layout title="Style guide – RWS UI">
	<main class="mx-auto max-w-screen-xl px-6 py-16" data-theme="default">
		<header class="mb-10 space-y-2">
			<h1 class="text-3xl font-semibold">Style guide</h1>
			<!-- <p class="text-body">Semantic aliases and the full colour scale.</p> -->
		</header>

		<section class="mb-12 space-y-6">
			<h2 class="text-2xl font-semibold">Colours</h2>
			<h3 class="text-xl font-semibold">Primary / Hidcote Blue</h3>
			<!-- <p class="mt-2 text-body-subtle">Named tokens mapped to the primary palette.</p> -->
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticPrimary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="text-body mt-3 space-y-1 text-sm">
								<span class="block text-center font-semibold">{item.name.replace('primary-', '')}</span>
								<code class="text-body-subtle block text-center text-xs">{item.hex}</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Secondary / Hillier Pink</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticSecondary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="text-body mt-3 space-y-1 text-sm">
								<span class="block text-center font-semibold">{item.name.replace('secondary-', '')}</span>
								<code class="text-body-subtle block text-center text-xs">{item.hex}</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Tertiary / Galaxy Purple</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticTertiary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="text-body mt-3 space-y-1 text-sm">
								<span class="block text-center font-semibold">{item.name.replace('tertiary-', '')}</span>
								<code class="text-body-subtle block text-center text-xs">{item.hex}</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Quaternary / Saffron</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticQuaternary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="text-body mt-3 space-y-1 text-sm">
								<span class="block text-center font-semibold">{item.name.replace('quaternary-', '')}</span>
								<code class="text-body-subtle block text-center text-xs">{item.hex}</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Neutral</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticNeutral.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="text-body mt-3 space-y-1 text-sm">
								<span class="block text-center font-semibold">{item.name.replace('foreground-', '')}</span>
								<code class="text-body-subtle block text-center text-xs">{item.hex}</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<header class="mt-24 mb-10 space-y-2">
			<h2 class="text-2xl font-semibold">Buttons</h2>
		</header>
		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Brand</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-primary">Primary</button>
				<button class="btn btn-secondary">Secondary</button>
				<button class="btn btn-tertiary">Tertiary</button>
				<button class="btn btn-quaternary">Quaternary</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Outline</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-outline">Outline</button>
				<!-- <button class="btn btn-outline-primary">Primary</button>
				<button class="btn btn-outline-secondary">Secondary</button>
				<button class="btn btn-outline-tertiary">Tertiary</button> -->
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Ghost</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-ghost">Ghost</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Link</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-link">Link</button>
			</div>
		</section>

		<section hidden class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Widths</h3>
			<di class="mt-6 flex gap-4">
				<button class="btn btn-primary w-full sm:w-auto">Full</button>
			</di>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-primary w-full">Full</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Sizes</h3>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-xs">Button text</button>
				<button class="btn btn-primary btn-sm">Button text</button>
				<button class="btn btn-primary btn-md">Button text</button>
				<button class="btn btn-primary btn-lg">Button text</button>
				<button class="btn btn-primary btn-xl">Button text</button>
			</div>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-link btn-xs">Button text</button>
				<button class="btn btn-link btn-sm">Button text</button>
				<button class="btn btn-link btn-md">Button text</button>
				<button class="btn btn-link btn-lg">Button text</button>
				<button class="btn btn-link btn-xl">Button text</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Icons</h3>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-icon-right btn-md">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-secondary btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-tertiary btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-ghost btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-link btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
			</div>

			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-outline btn-icon-left btn-xs">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-sm">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-md">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-lg">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-xl">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
