---
import Layout from '../layouts/Layout.astro'

const semanticPrimary = [
	{ name: 'primary-lightest', className: 'bg-primary-lightest' },
	{ name: 'primary-lighter', className: 'bg-primary-lighter' },
	{ name: 'primary-light', className: 'bg-primary-light' },
	{ name: 'primary', className: 'bg-primary' },
	{ name: 'primary-dark', className: 'bg-primary-dark' },
	{ name: 'primary-darker', className: 'bg-primary-darker' },
	{ name: 'primary-darkest', className: 'bg-primary-darkest' },
]

const semanticSecondary = [
	{ name: 'secondary-lightest', className: 'bg-secondary-lightest' },
	{ name: 'secondary-lighter', className: 'bg-secondary-lighter' },
	{ name: 'secondary-light', className: 'bg-secondary-light' },
	{ name: 'secondary', className: 'bg-secondary' },
	{ name: 'secondary-dark', className: 'bg-secondary-dark' },
	{ name: 'secondary-darker', className: 'bg-secondary-darker' },
	{ name: 'secondary-darkest', className: 'bg-secondary-darkest' },
]

const semanticTertiary = [
	{ name: 'tertiary-lightest', className: 'bg-tertiary-lightest' },
	{ name: 'tertiary-lighter', className: 'bg-tertiary-lighter' },
	{ name: 'tertiary-light', className: 'bg-tertiary-light' },
	{ name: 'tertiary', className: 'bg-tertiary' },
	{ name: 'tertiary-dark', className: 'bg-tertiary-dark' },
	{ name: 'tertiary-darker', className: 'bg-tertiary-darker' },
	{ name: 'tertiary-darkest', className: 'bg-tertiary-darkest' },
]

const semanticGray = [
	{ name: 'gray-lightest', className: 'bg-gray-50' },
	{ name: 'gray-lighter', className: 'bg-gray-200' },
	{ name: 'gray-light', className: 'bg-gray-400' },
	{ name: 'gray', className: 'bg-gray-500' },
	{ name: 'gray-dark', className: 'bg-gray-600' },
	{ name: 'gray-darker', className: 'bg-gray-800' },
	{ name: 'gray-darkest', className: 'bg-gray-950' },
]

const primaryScale = [
	{ value: 50, className: 'bg-primary-50' },
	{ value: 100, className: 'bg-primary-100' },
	{ value: 200, className: 'bg-primary-200' },
	{ value: 300, className: 'bg-primary-300' },
	{ value: 400, className: 'bg-primary-400' },
	{ value: 500, className: 'bg-primary-500' },
	{ value: 600, className: 'bg-primary-600' },
	{ value: 700, className: 'bg-primary-700' },
	{ value: 800, className: 'bg-primary-800' },
	{ value: 900, className: 'bg-primary-900' },
	{ value: 950, className: 'bg-primary-950' },
]

const secondaryScale = [
	{ value: 50, className: 'bg-secondary-50' },
	{ value: 100, className: 'bg-secondary-100' },
	{ value: 200, className: 'bg-secondary-200' },
	{ value: 300, className: 'bg-secondary-300' },
	{ value: 400, className: 'bg-secondary-400' },
	{ value: 500, className: 'bg-secondary-500' },
	{ value: 600, className: 'bg-secondary-600' },
	{ value: 700, className: 'bg-secondary-700' },
	{ value: 800, className: 'bg-secondary-800' },
	{ value: 900, className: 'bg-secondary-900' },
	{ value: 950, className: 'bg-secondary-950' },
]

const tertiaryScale = [
	{ value: 50, className: 'bg-tertiary-50' },
	{ value: 100, className: 'bg-tertiary-100' },
	{ value: 200, className: 'bg-tertiary-200' },
	{ value: 300, className: 'bg-tertiary-300' },
	{ value: 400, className: 'bg-tertiary-400' },
	{ value: 500, className: 'bg-tertiary-500' },
	{ value: 600, className: 'bg-tertiary-600' },
	{ value: 700, className: 'bg-tertiary-700' },
	{ value: 800, className: 'bg-tertiary-800' },
	{ value: 900, className: 'bg-tertiary-900' },
	{ value: 950, className: 'bg-tertiary-950' },
]

const grayScale = [
	{ value: 50, className: 'bg-gray-50' },
	{ value: 100, className: 'bg-gray-100' },
	{ value: 200, className: 'bg-gray-200' },
	{ value: 300, className: 'bg-gray-300' },
	{ value: 400, className: 'bg-gray-400' },
	{ value: 500, className: 'bg-gray-500' },
	{ value: 600, className: 'bg-gray-600' },
	{ value: 700, className: 'bg-gray-700' },
	{ value: 800, className: 'bg-gray-800' },
	{ value: 900, className: 'bg-gray-900' },
	{ value: 950, className: 'bg-gray-950' },
]

const themeVariants = [
	{ name: 'Default', theme: 'default' },
	{ name: 'Pale', theme: 'pale' },
	{ name: 'Primary', theme: 'primary' },
	{ name: 'Secondary', theme: 'secondary' },
	{ name: 'Tertiary', theme: 'tertiary' },
]
---

<Layout>
	<main class="mx-auto max-w-screen-xl px-6 py-16">
		<header class="mb-10 space-y-2">
			<h1 class="text-3xl font-semibold">Style guide</h1>
			<!-- <p class="text-body">Semantic aliases and the full colour scale.</p> -->
		</header>

		<section class="mb-12 space-y-6">
			<h2 class="text-2xl font-semibold">Colours</h2>
			<h3 class="text-xl font-semibold">Primary / Hidcote Blue</h3>
			<!-- <p class="mt-2 text-body-subtle">Named tokens mapped to the primary palette.</p> -->
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticPrimary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="mt-3 space-y-1 text-sm text-body">
								<span class="block text-center font-semibold">{item.name.replace('primary-', '')}</span>
								{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
							</div>
						</div>
					))
				}
			</div>
			<!-- <h3 class="text-xl font-semibold ">Full scale</h3> -->
			<!-- <p class="mt-2 text-body-subtle">All primary values from 50 to 950.</p> -->
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-11">
				{
					primaryScale.map((item) => {
						return (
							<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
								<div class:list={['aspect-square', 'w-full', 'rounded', item.className]} />
								<div class="mt-3 space-y-1 text-sm text-body">
									<span class="block text-center font-semibold">{item.value}</span>
									{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
								</div>
							</div>
						)
					})
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Secondary / Hillier Pink</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticSecondary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="mt-3 space-y-1 text-sm text-body">
								<span class="block text-center font-semibold">{item.name.replace('secondary-', '')}</span>
								{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
							</div>
						</div>
					))
				}
			</div>

			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-11">
				{
					secondaryScale.map((item) => {
						return (
							<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
								<div class:list={['aspect-square', 'w-full', 'rounded', item.className]} />
								<div class="mt-3 space-y-1 text-sm text-body">
									<span class="block text-center font-semibold">{item.value}</span>
									{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
								</div>
							</div>
						)
					})
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Tertiary / Galaxy Purple</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticTertiary.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="mt-3 space-y-1 text-sm text-body">
								<span class="block text-center font-semibold">{item.name.replace('tertiary-', '')}</span>
								{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
							</div>
						</div>
					))
				}
			</div>

			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-11">
				{
					tertiaryScale.map((item) => {
						return (
							<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
								<div class:list={['aspect-square', 'w-full', 'rounded', item.className]} />
								<div class="mt-3 space-y-1 text-sm text-body">
									<span class="block text-center font-semibold">{item.value}</span>
									{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
								</div>
							</div>
						)
					})
				}
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Gray</h3>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
				{
					semanticGray.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
							<div class={`aspect-video w-full rounded ${item.className}`} />
							<div class="mt-3 space-y-1 text-sm text-body">
								<span class="block text-center font-semibold">{item.name.replace('gray-', '')}</span>
								{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
							</div>
						</div>
					))
				}
			</div>
			<!-- <h3 class="text-xl font-semibold ">Full scale</h3> -->
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-11">
				{
					grayScale.map((item) => {
						return (
							<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-900">
								<div class:list={['aspect-square', 'w-full', 'rounded', item.className]} />
								<div class="mt-3 space-y-1 text-sm text-body">
									<span class="block text-center font-semibold">{item.value}</span>
									{/* <code class="text-xs text-body-subtle">{item.className}</code> */}
								</div>
							</div>
						)
					})
				}
			</div>
		</section>

		<header class="mt-24 mb-10 space-y-2">
			<h2 class="text-2xl font-semibold">Buttons</h2>
		</header>
		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Brand</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-primary">Primary</button>
				<button class="btn btn-secondary">Secondary</button>
				<button class="btn btn-tertiary">Tertiary</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Outline</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-outline">Outline</button>
				<!-- <button class="btn btn-outline-primary">Primary</button>
				<button class="btn btn-outline-secondary">Secondary</button>
				<button class="btn btn-outline-tertiary">Tertiary</button> -->
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Ghost</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-ghost">Ghost</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Link</h3>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-link">Link</button>
			</div>
		</section>

		<section hidden class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Widths</h3>
			<di class="mt-6 flex gap-4">
				<button class="btn btn-primary w-full sm:w-auto">Full</button>
			</di>
			<div class="mt-6 flex gap-4">
				<button class="btn btn-primary w-full">Full</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Sizes</h3>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-xs">Button text</button>
				<button class="btn btn-primary btn-sm">Button text</button>
				<button class="btn btn-primary btn-md">Button text</button>
				<button class="btn btn-primary btn-lg">Button text</button>
				<button class="btn btn-primary btn-xl">Button text</button>
			</div>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-link btn-xs">Button text</button>
				<button class="btn btn-link btn-sm">Button text</button>
				<button class="btn btn-link btn-md">Button text</button>
				<button class="btn btn-link btn-lg">Button text</button>
				<button class="btn btn-link btn-xl">Button text</button>
			</div>
		</section>

		<section class="mb-12 space-y-6">
			<h3 class="text-xl font-semibold">Icons</h3>
			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-icon-right btn-md">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-secondary btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-tertiary btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-ghost btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-link btn-icon-right">
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
			</div>

			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-outline btn-icon-left btn-xs">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-sm">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-md">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-lg">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
				<button class="btn btn-outline btn-icon-left btn-xl">
					<!-- <svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M14.293 7.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L16.586 13H5a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path></svg> -->
					<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.293 12.707a1 1 0 0 1 0-1.414l7-7a1 1 0 1 1 1.414 1.414L9.414 12l6.293 6.293a1 1 0 0 1-1.414 1.414l-7-7Z" clip-rule="evenodd"></path></svg>
					Button text
				</button>
			</div>

			<div class="mt-6 flex items-center gap-4">
				<button class="btn btn-primary btn-icon-right btn-md">
					<!-- external link -->
					<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"></path></svg>
					<!-- arrow  -->
