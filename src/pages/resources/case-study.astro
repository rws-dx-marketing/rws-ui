						<div class="intersect-once grid place-content-center rounded-lg bg-background p-10 text-center text-foreground intersect:motion-preset-expand" style="--motion-delay: 500ms" data-theme="secondary">
							<p class="text-2xl font-bold text-balance">Improved handling of urgent cases</p>
						</div>
					</div>

					<!-- <div class="grid grid-cols-3 gap-8">
						<img src="/public/shapes/marker.svg" alt="Marker" class="size-full object-cover" />
						<img src="/public/shapes/bubble.svg" alt="Bubble" class="size-full object-cover" />
						<img src="/public/shapes/marker.svg" alt="Marker" class="size-full object-cover" />
					</div> -->
