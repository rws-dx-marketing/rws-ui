---
import Layout from '../../layouts/Layout.astro'
import CaseStudyHero from '../../blocks/CaseStudyHero.astro'

const cards = [1, 2, 3]
---

<Layout>
	<CaseStudyHero />

	<section class="bg-background pt-12 pb-12 text-foreground md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots-enhanced">
		<div class="mx-auto mb-8 max-w-screen-xl px-8 lg:px-12 xl:mb-12">
			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
				<div class="@container grid place-content-center rounded-lg bg-background p-6 text-center text-foreground" data-card>
					<h3 class="intersect-once mb-3 text-[min(32cqi,4.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 200ms" data-countup data-target="50" data-suffix="%">0%</h3>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 200ms">
						<p class="text-lg/tight font-bold">increase in revenue</p>
						<p>for new customers</p>
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg bg-background p-6 text-center text-foreground" data-card>
