					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 300ms">
						<p class="text-lg/tight font-bold">managed projects</p>
						<p>across multiple regions</p>
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg bg-background p-6 text-center text-foreground" data-card>
					<h3 class="intersect-once mb-3 text-[min(32cqi,4.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 400ms" data-countup data-target="123">0</h3>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 400ms">
						<p class="text-lg/tight font-bold">weeks</p>
						<p>of continual growth</p>
					</div>
				</div>

				<div class="@container grid place-content-center rounded-lg bg-background p-6 text-center text-foreground" data-card>
					<p class="intersect-once mb-3 text-[min(32cqi,4.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style="--motion-delay: 500ms" data-countup data-target="3" data-suffix="x">0x</p>

					<div class="intersect-once intersect:motion-preset-slide-up-sm" style="--motion-delay: 500ms">
						<p class="text-lg/tight font-bold">turnaround time</p>
						<p>compared to 2016</p>
					</div>
				</div>
			</div>
		</div>

		<div class="mx-auto grid max-w-screen-xl gap-8 px-8 lg:grid-cols-12 lg:px-12 xl:gap-12">
			<aside class="hidden lg:col-span-4 lg:block">
				<div class="sticky top-20 grid gap-8 xl:gap-12">
					<div class="relative rounded-lg bg-background p-10 text-foreground" data-card>
						<!-- <h4 class="mb-6 text-lg font-bold">Key details</h4> -->

						<ul class="grid gap-4">
							<li>
								<p class="font-bold">Client</p>
								<p>Alibaba Group</p>
							</li>

							<li>
								<p class="font-bold">Webite</p>
								<p><a href="https://www.alibaba.com" target="_blank">alibaba.com</a></p>
							</li>

							<li>
								<p class="font-bold">Industry</p>
								<p>Retail</p>
							</li>

							<li>
								<p class="font-bold">Established</p>
								<p>1999</p>
							</li>

							<li>
								<p class="font-bold">Headquarters</p>
								<p>Hangzhou, China</p>
							</li>
						</ul>
					</div>

					<div class="rounded-lg bg-background p-6 text-foreground" data-card>
						<div class="flex items-start gap-6">
							<div class="overflow-hidden- rounded- w-1/3 max-w-32 shrink-0">
								<img src="https://placehold.co/200" alt="Placeholder" class="aspect-square size-full rounded object-cover" />
							</div>
							<div>
								<h4 class="mb-2 text-lg font-semibold">Lorem ipsum dolor</h4>

								<div class="prose mb-4 text-sm/normal font-medium text-foreground/80">
