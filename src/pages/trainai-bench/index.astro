---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'

const stats = [
	{ value: '30', label: 'Languages', note: '' },
	{ value: '50+', label: 'Models tested', note: '' },
	{ value: '2M+', label: 'Tokens used', note: '' },
]

const gridColsByCount = {
	1: 'grid-cols-1',
	2: 'sm:grid-cols-2',
	3: 'sm:grid-cols-3',
	4: 'sm:grid-cols-2 lg:grid-cols-4',
	5: 'sm:grid-cols-2 lg:grid-cols-5',
	6: 'sm:grid-cols-2 lg:grid-cols-3',
}

const gridCols = gridColsByCount[stats.length] ?? gridColsByCount[3]

const languagesGrammar = [
	{ name: 'Portuguese (Brazil)', color: 'blue', model: 'Tood 2.0 Lite', score: '0.41' },
	{ name: 'German', color: 'green', model: 'Gemini 3 Flash', score: '0.38' },
	{ name: 'French', color: 'orangered', model: 'MiniMax M1', score: '0.35' },
	{ name: 'Arabic', color: 'purple', model: 'Claude Opus 4.6', score: '0.32' },
	{ name: 'Korean', color: 'purple', model: 'Claude Fable 5', score: '0.29' },
]

const languagesTranslation = [
	{ name: 'Spanish', color: 'green', model: 'Gemini 3.5 Flash', score: '94%' },
	{ name: 'Icelandic', color: 'green', model: 'Gemini 3.5 Flash', score: '94%' },
	{ name: 'Polish', color: 'blue', model: 'Tood 2.0 Lite', score: '93%' },
	{ name: 'Simplified Chinese', color: 'purple', model: 'Claude Fable 5', score: '92%' },
	{ name: 'Japanese', color: 'purple', model: 'Claude Fable 5', score: '89%' },
]
---

<Layout title="TrainAI Bench">
	<!-- Hero -->
	<section class="grid- min-h-[min(calc(100svh-16rem),48rem)]- place-items-center- pb-20- md:pb-24- lg:pb-32- pt-20 md:pt-24 lg:pt-32" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>By language experts</p>
			</div>

			<h1 class="mx-auto mb-6 max-w-[16ch] text-5xl font-bold tracking-tight md:text-6xl xl:text-7xl">
				<p>Does your AI actually <em>speak the language</em>?</p>
			</h1>

			<div hidden class="mx-auto mb-8 max-w-[56ch] text-xl text-pretty text-foreground-muted xl:text-2xl">
				<p>The first independent multilingual benchmark that tests grammar, meaning preservation, and tokenizer efficiency across 30 languages.</p>
			</div>

			<div class="mx-auto prose prose-xl mb-8 max-w-[56ch] text-foreground-muted md:prose-2xl">
				<p>The first independent multilingual benchmark that tests grammar, meaning preservation, and tokenizer efficiency across 30 languages.</p>
			</div>

			<div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="/trainai-bench/leaderboard" class="btn btn-primary btn-xl">View leaderboard</a>
				<a href="/trainai-bench/methodology" class="btn btn-outline btn-xl">Read methodology</a>
			</div>
		</div>
	</section>

	<!-- Stats -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class:list={['grid gap-8', gridCols]}>
				{
					stats.map((stat, index) => (
						<div class="@container grid place-content-center rounded-lg p-6 text-center" data-card>
							<p class="intersect-once mb-3 text-[min(23cqi,3.5rem)]/none font-extrabold text-accent tabular-nums intersect:motion-preset-focus" style={`--motion-delay: ${200 + index * 100}ms`} data-count-up>
								{stat.value}
							</p>

							<div class="intersect-once intersect:motion-preset-slide-up-sm" style={`--motion-delay: ${200 + index * 100}ms`}>
								<p class="text-lg/tight font-bold">{stat.label}</p>
								{stat.note && <p>{stat.note}</p>}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Split -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto grid max-w-screen-xl items-center gap-12 px-8 lg:grid-cols-12 lg:px-12 xl:gap-16">
			<div class="lg:col-span-6">
				<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
					<p>Consectetur adipiscing elit</p>
				</div>

				<h2 class="mb-6 text-3xl font-bold tracking-tight xl:text-4xl">
					<p>Lorem ipsum dolor sit amet</p>
				</h2>

				<div class="prose text-foreground-muted md:prose-lg">
					<p>Which model is best for my market? Donec ut cursus est. Lorem ipsum dolor sit amet, consectetur adipiscing elit suspendisse luctus tortor.</p>
					<p>How does this specific model perform across languages and tasks? Ut cursus est. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				</div>

				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a href="#" class="btn btn-secondary btn-icon-right btn-lg">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
						By language
					</a>
					<a href="#" class="btn btn-tertiary btn-icon-right btn-lg">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
						By model
					</a>
				</div>
			</div>

			<div class="lg:col-span-6">
				<div class="intersect-once h-full motion-delay-200 intersect:motion-preset-slide-left-sm">
					<img src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/hero/search-mockup.png" alt="Graphs" class="w-full rounded-lg object-cover" draggable="false" />
				</div>
			</div>
		</div>
	</section>

	<!-- Preview -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="text-center- *:mx-auto- mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>Consectetur adipiscing elit</p>
			</div>

			<h2 class="mb-6 max-w-[24ch] text-3xl font-bold tracking-tight text-pretty xl:text-4xl">
				<p>There is no single best AI for every language</p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				<p>The top model changes depending on what you need it to speak. Here is who leads where, and by how much. Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
			</div>

			<!-- Scores -->
			<div class="mt-12 lg:mt-16">
				<div class="grid items-start gap-8 md:grid-cols-2">
					<div class="grid gap-4">
						<div class="flex items-center justify-between gap-6 px-5">
							<span class="flex-1 text-lg font-bold">Grammar</span>
							<span class="font-semibold text-foreground-subtle">MCC</span>
						</div>

						{
							languagesGrammar.map((lang) => (
								<div class="flex items-center gap-6 rounded border px-5 py-4 font-semibold" data-card>
									<span class="flex-1">{lang.name}</span>
									<span class="flex items-center gap-2">
										<span class="mt-0.25 size-3 rounded-xs" style={`background-color: ${lang.color}`} />
										<span class="font-bold">{lang.model}</span>
									</span>
									<span class="text-foreground-muted tabular-nums">{lang.score}</span>
								</div>
							))
						}
					</div>

					<div class="grid gap-4">
						<div class="flex items-center justify-between gap-6 px-5">
							<span class="flex-1 text-lg font-bold">Translation</span>
							<span class="font-semibold text-foreground-subtle">Score %</span>
						</div>

						{
							languagesTranslation.map((lang) => (
								<div class="flex items-center gap-6 rounded border px-5 py-4 font-semibold" data-card>
									<span class="flex-1">{lang.name}</span>
									<span class="flex items-center gap-2">
										<span class="mt-0.25 size-3 rounded-xs" style={`background-color: ${lang.color}`} />
										<span class="font-bold">{lang.model}</span>
									</span>
									<span class="text-foreground-muted tabular-nums">{lang.score}</span>
								</div>
							))
						}
					</div>
				</div>

				<div class="mt-10 flex flex-col gap-x-6 gap-y-4 sm:flex-row sm:items-center">
					<div class="flex-1 text-pretty text-foreground-muted">
						<p>Best model per language &bull; grammar in MCC, translation in score %</p>
					</div>

					<div>
						<a href="/trainai-bench/leaderboard" class="btn btn-link btn-icon-right text-accent">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							See the full leaderboard
						</a>
					</div>
				</div>

				<div hidden class="grid aspect-2/1 place-items-center rounded-lg border bg-background-softest">
					<a href="/trainai-bench/register" class="btn btn-primary btn-icon-right btn-lg">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
						Register to explore full data
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
