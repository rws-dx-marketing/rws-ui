---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="By language – TrainAI Bench">
	<!-- Hero -->
	<section class="grid- min-h-[min(calc(100svh-16rem),48rem)]- place-items-center- pb-20- md:pb-24- lg:pb-32- pt-16 md:pt-20 lg:pt-24" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
			<div class="mb-3 font-bold text-foreground-muted xl:text-lg">
				<p>Consectetur adipiscing elit</p>
			</div>

			<h1 class="mx-auto mb-6 max-w-[16ch] text-4xl font-bold tracking-tight md:text-5xl xl:text-6xl">
				<p>By language</p>
			</h1>

			<div class="mx-auto prose prose-xl max-w-[56ch] text-foreground-muted md:prose-2xl">
				<p>Which model is best for my market across grammar, translation and tokenizer efficiency? Lorem ipsum dolor sit, amet consectetur adipisicing elit.</p>
			</div>

			<div hidden class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="#" class="btn btn-primary btn-xl">View leaderboard</a>
				<a href="#" class="btn btn-outline btn-xl">Read methodology</a>
			</div>
		</div>
	</section>

	<!-- Filters + charts -->
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Filters -->
			<div class="top-[calc(var(--content-top)+1rem)] z-999 rounded-lg border border-foreground-softer bg-background/75 backdrop-blur-sm transition-[top] duration-300 lg:sticky">
				<div class="flex flex-col items-center justify-between gap-4 p-4 md:flex-row">
					<div class="flex gap-8">
						<!-- Language -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" id="language-filter-button" popovertarget="language-filter-popover" popovertargetaction="toggle" type="button" style="anchor-name: --language-filter-anchor;">
								<span class="flex-1 text-left">Thai</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg class="ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							</button>

							<div id="language-filter-popover" popover="auto" role="menu" aria-labelledby="language-filter-button" class="dropdown z-10 mt-1 w-56 rounded border border-foreground-softer shadow-lg" style="position-anchor: --language-filter-anchor; position-area: bottom span-right;">
								<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-sm select-none" aria-labelledby="language-filter-button">
									{
										['Albanian', 'Arabic', 'Assamese', 'Basque', 'Czech', 'English', 'Fijian', 'Finnish', 'French', 'German', 'Greek', 'Hebrew', 'Hindi', 'Hungarian', 'Icelandic', 'Japanese', 'Khmer', 'Kinyarwanda', 'Korean', 'Kyrgyz', 'Nepali', 'Polish', 'Russian', 'Simplified Chinese', 'Spanish', 'Swahili', 'Tagalog', 'Tamil', 'Thai', 'Turkish', 'Vietnamese', 'Welsh', 'Zulu'].map((lang) => (
											<li>
												<label class="inline-flex w-full items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-foreground-softest has-checked:bg-accent-softer">
													<input data-filter-input type="radio" value={lang.toLowerCase().replace(/\s+/g, '-')} name="language" class="input input-radio" />
													{lang}
												</label>
											</li>
										))
									}
								</ul>
							</div>
						</div>

						<div class="flex items-center gap-8">
							<!-- <h3 class="text-3xl font-bold">Thai</h3> -->
							<div class="flex gap-3">
								<span>th</span>
								<span>&bull;</span>
								<span>Medium resource</span>
								<!-- <span>&bull;</span>
								<span>50+ models</span> -->
							</div>
						</div>
					</div>

					<div hidden class="-my-1.25 -ml-1.25 flex gap-0.5 rounded bg-foreground-softer p-1.25">
						<button class="btn btn-ghost rounded-sm text-foreground-muted data-[active]:bg-background data-[active]:text-foreground" data-active>Grammar</button>
						<button class="btn btn-ghost rounded-sm text-foreground-muted">Translation</button>
						<button class="btn btn-ghost rounded-sm text-foreground-muted">Tokenizer</button>
					</div>

					<div class="flex gap-4">
						<!-- Models -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" id="model-filter-button" popovertarget="model-filter-popover" popovertargetaction="toggle" type="button" style="anchor-name: --model-filter-anchor;">
								<span class="flex-1 text-left">Models</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg class="ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							</button>

							<div id="model-filter-popover" popover="auto" role="menu" aria-labelledby="model-filter-button" class="dropdown z-10 mt-1 w-60 rounded border border-foreground-softer shadow-lg" style="position-anchor: --model-filter-anchor; position-area: bottom span-left;">
								<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-sm select-none" aria-labelledby="model-filter-button">
									{
										['claude-opus-4.6', 'claude-sonnet-4.6', 'jamba-2', 'claude-haiku-4.6', 'deepseek-v3.2', 'grok-4.20', 'llama-4-scout', 'deepseek-r2', 'gpt-5-mini', 'gemini-3-flash-preview', 'yi-2-large', 'qwen-3-72b', 'gemini-3-pro-preview', 'mistral-medium-3', 'command-r-plus', 'gpt-5.4', 'gpt-5', 'llama-4-maverick', 'gpt-5-nano', 'phi-5', 'mistral-large-3', 'qwen-3-235b', 'gemini-3-pro', 'command-r', 'kimi-k2.6'].map((model) => (
											<li>
												<label class="inline-flex w-full items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-foreground-softest has-checked:bg-accent-softer">
													<input data-filter-input type="checkbox" value={model} name="model" class="input input-checkbox" />
													{model}
												</label>
											</li>
										))
									}
								</ul>
								<div data-filter-clear hidden class="mx-2 border-t border-foreground-softer pt-1 pb-2"><button type="button" class="px-2 py-1 text-left text-sm font-semibold text-foreground-subtle transition-colors hover:text-accent" disabled>Clear selected</button></div>
							</div>
						</div>

						<!-- Filters -->
						<div>
							<button class="btn btn-outline btn-icon-both w-full rounded bg-background" type="button">
								<span class="flex-1 text-left">Filters</span>
								<span class="ml-1 rounded-full bg-accent-softer px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="64" y1="136" x2="192" y2="136" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="24" y1="88" x2="232" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="104" y1="184" x2="152" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Stats -->
			<div class="mt-8 grid gap-8 sm:data-[count='3']:grid-cols-3 sm:data-[count='4']:grid-cols-2 sm:data-[count='5']:grid-cols-2 lg:data-[count='4']:grid-cols-4 lg:data-[count='5']:grid-cols-5" data-count="3">
				<div class="group flex flex-col rounded-lg p-5" data-card>
					<div class="flex items-start justify-between gap-3">
						<div>
							<h2 class="font-semibold">Gemini 3 Pro Preview</h2>
							<p class="text-sm text-foreground-muted">Google</p>
						</div>
						<span class="shrink-0 rounded-full bg-accent-softer px-2.5 py-1 text-xs font-semibold text-foreground-muted">Best grammar</span>
					</div>
					<div class="mt-4 flex items-end justify-between">
						<div>
							<p class="text-2xl font-bold text-accent tabular-nums">0.32</p>
							<p class="text-xs text-foreground-muted">MCC</p>
						</div>
						<p class="text-xs font-semibold text-foreground-muted">November 2025</p>
					</div>
				</div>

				<div class="group flex flex-col rounded-lg p-5" data-card>
					<div class="flex items-start justify-between gap-3">
						<div>
							<h2 class="font-semibold">GPT 5.4</h2>
							<p class="text-sm text-foreground-muted">OpenAI</p>
						</div>
						<span class="shrink-0 rounded-full bg-accent-softer px-2.5 py-1 text-xs font-semibold text-foreground-muted">Best translation</span>
					</div>
					<div class="mt-4 flex items-end justify-between">
						<div>
							<p class="text-2xl font-bold text-accent tabular-nums">78</p>
							<p class="text-xs text-foreground-muted">Score %</p>
						</div>
						<p class="text-xs font-semibold text-foreground-muted">March 2026</p>
					</div>
				</div>

				<div class="group flex flex-col rounded-lg p-5" data-card>
					<div class="flex items-start justify-between gap-3">
						<div>
							<h2 class="font-semibold">Gemini 3 Flash</h2>
							<p class="text-sm text-foreground-muted">Google</p>
						</div>
						<span class="shrink-0 rounded-full bg-accent-softer px-2.5 py-1 text-xs font-semibold text-foreground-muted">Best tokenizer</span>
					</div>
					<div class="mt-4 flex items-end justify-between">
						<div>
							<p class="text-2xl font-bold text-accent tabular-nums">2.11</p>
							<p class="text-xs text-foreground-muted">Chars / tokens</p>
						</div>
						<p class="text-xs font-semibold text-foreground-muted">December 2025</p>
					</div>
				</div>
			</div>

			<!-- Charts -->
			<div class="relative z-[1] mt-8 overflow-hidden rounded-lg border border-foreground-softer bg-background-softest text-foreground">
				<div class="flex flex-col gap-4 border-b border-foreground-softer px-6 py-4">
					<div>
						<h3 class="m-0 text-xl font-bold text-foreground-muted">Bar chart — all models ranked by grammar MCC for Thai</h3>
					</div>

					<div class="flex items-center justify-between gap-4">
						<div class="flex min-w-0 items-center gap-[18px]">
							<div class="inline-flex gap-0.5 rounded bg-foreground-softer p-1.25">
								<button type="button" class="btn btn-ghost rounded-sm bg-background text-foreground">Grammar</button>
								<button type="button" class="btn btn-ghost rounded-sm text-foreground-muted">Translation</button>
								<button type="button" class="btn btn-ghost rounded-sm text-foreground-muted">Tokenizer</button>
							</div>
							<div hidden class="min-w-0">
								<h3 class="m-0 text-xl font-bold text-foreground-muted">Bar chart — all models ranked by grammar MCC for Thai</h3>
								<p class="mt-0.5 mb-0 text-xs text-foreground-subtle">Horizontal bars · brand color-coded · sorted by score</p>
							</div>
						</div>
						<div class="flex flex-none flex-col items-end gap-2">
							<span class="inline-flex items-center rounded-full border border-accent-soft bg-accent-softer px-2.5 py-1 text-xs font-bold text-accent tabular-nums">11 of 34 models</span>
						</div>
					</div>
				</div>
				<div>
					<div class="relative px-6 pt-5 pb-2.5">
						<div class="relative">
							<div class="pointer-events-none absolute top-0 bottom-0" style="left: calc(184px); right: 40px;">
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 0%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 20%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 40%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 60%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 80%;"></span>
								<span class="absolute top-0 bottom-0 w-px -translate-x-1/2 bg-foreground/[0.06]" style="left: 100%;"></span>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Grok 4.20</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(17, 17, 17);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 43.6436%; background: rgb(17, 17, 17);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 83.6436%;">0.44</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemini 3.1 Pro Preview</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 22.7836%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 62.7836%;">0.23</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemini 3.5 Flash</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 5.48357%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 45.4836%;">0.05</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Mistral Medium 3.1</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(255, 112, 0);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 4.82805%; background: rgb(255, 112, 0);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 44.828%;">0.05</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemini 3 Flash Preview</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 4.45435%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 44.4544%;">0.04</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Claude Opus 4.5</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(217, 119, 87);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 2.54906%; background: rgb(217, 119, 87);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 42.5491%;">0.03</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Gemma 4 31B</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(66, 133, 244);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 2.37624%; background: rgb(66, 133, 244);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 42.3762%;">0.02</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Mistral Medium 3.5</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(255, 112, 0);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 40%; width: 1.2%; background: rgb(255, 112, 0);"></div>
									<span class="absolute top-1/2 -translate-y-1/2 pl-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 40%;">0.00</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">GPT-5</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(16, 163, 127);"></span>
								</div>
								<div class="relative mr-10 h-6 flex-1 cursor-default">
									<div data-bar-fill="" class="absolute top-0 h-full rounded-[5px] transition-[left,width,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[1.08] motion-reduce:transition-none" style="left: 35.9709%; width: 4.02911%; background: rgb(16, 163, 127);"></div>
									<span class="absolute top-1/2 -translate-x-full -translate-y-1/2 pr-1.5 text-[11px] font-semibold whitespace-nowrap text-foreground-muted" style="left: 35.9709%;">-0.04</span>
								</div>
							</div>
							<div class="group relative mb-1.5 flex items-center gap-3.5">
								<div class="flex w-[170px] flex-none items-center justify-end gap-1.5 overflow-hidden text-right text-xs text-foreground">
									<span class="overflow-hidden text-ellipsis whitespace-nowrap">Command A Translate</span>
									<span class="h-2 w-2 flex-none rounded-full" style="background: rgb(57, 89, 76);"></span>
