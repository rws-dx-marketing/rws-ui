---
import Layout from '../../layouts/Layout.astro'

const cards = [1, 2, 3, 4, 5, 6]
---

<Layout title="Insights – TrainAI Bench">
	<!-- Hero -->
	<section class="grid- min-h-[min(calc(100svh-16rem),48rem)]- place-items-center- bg-background pt-16 pb-12 text-foreground md:pt-20 md:pb-16 lg:pt-24 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 text-center lg:px-12">
			<div class="mb-3 font-bold text-foreground/80 xl:text-lg">
				<p>Consectetur adipiscing elit</p>
			</div>

			<h1 class="mx-auto mb-6 max-w-[16ch] text-4xl font-bold tracking-tight md:text-5xl xl:text-6xl">
				<p>Insights</p>
			</h1>

			<div class="mx-auto prose prose-xl max-w-[56ch] font-medium text-foreground/80 md:prose-2xl">
				<p>What happened when the latest model dropped? Lorem ipsum dolor sit, amet consectetur adipisicing elit vitae quo animi suspendisse luctus tortor.</p>
			</div>

			<div hidden class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="#" class="btn btn-primary btn-xl">View leaderboard</a>
				<a href="#" class="btn btn-outline btn-xl">Read methodology</a>
			</div>
		</div>
	</section>

	<section class="bg-background pt-12 pb-12 text-foreground md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div class="grid max-w-[80ch] gap-8 sm:grid-cols-2 lg:max-w-none lg:grid-cols-3">
				{
					cards.map((card) => (
						<>
							<article class="group relative overflow-clip rounded-lg border border-foreground/10 bg-background text-left text-foreground" data-card>
								<div class="flex h-full flex-col">
									<div class="p-4">
										<div class="mb-5 block overflow-hidden rounded">
											<img class="aspect-video object-cover transition-transform group-hover:scale-110" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png" alt="office laptop working" />
										</div>

										<span class="mb-3 inline-block rounded-full border border-foreground/10 bg-foreground/5 px-2 py-0.5 text-xs font-semibold text-foreground/80"> Article </span>

										<h2 class="mb-2 text-2xl font-bold">
											<p>
												<a href="/resources/blog-1/">
													This is an article title
													<span class="absolute inset-0" />
												</a>
											</p>
										</h2>

										<div class="prose line-clamp-3 font-medium text-pretty text-foreground/80">
											<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque.</p>
										</div>
									</div>

									<div class="mt-auto px-4 pb-4">
										<div class="flex items-center space-x-4">
											<img class="h-10 w-10 rounded-full" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/jese-leos.png" alt="Jese Leos avatar" />
											<div>
												<div class="font-semibold">Jese Leos</div>
												<div class="text-sm font-medium text-foreground/80">Aug 15, 2021 • 16 min read</div>
											</div>
										</div>
									</div>
								</div>
							</article>
						</>
					))
				}
			</div>
		</div>
	</section>

	<section hidden class="bg-background py-16 text-foreground" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<h1 class="text-3xl font-bold tracking-tight">Insights</h1>
			<p class="mt-3 max-w-2xl text-base font-medium text-foreground/70">Analysis, trends, and findings from the TrainAI Bench data.</p>

			<div class="mt-10 grid gap-6 lg:grid-cols-3">
				{
					[
						{
							date: 'Jun 2025',
							title: 'GPT-4o leads overall but Language Weaver dominates technical domains',
							summary: 'While general-purpose LLMs score highest in aggregate, specialised MT engines retain a significant edge in technical and legal content.',
							tag: 'Analysis',
						},
						{
							date: 'May 2025',
							title: 'The cost-quality frontier: where do open-source models sit?',
							summary: 'Self-hosted open-source models offer compelling economics at 85%+ COMET quality levels — but the gap closes quickly at scale.',
							tag: 'Economics',
						},
						{
							date: 'Apr 2025',
							title: 'Low-resource languages: a persistent gap in LLM translation',
							summary: 'For the 40+ low-resource language pairs in our benchmark, the quality gap between specialised MT and general LLMs narrows considerably.',
							tag: 'Languages',
						},
						{
							date: 'Apr 2025',
							title: 'Human eval vs. COMET: when the scores disagree',
							summary: 'We identified 12 language pairs where COMET rankings diverge meaningfully from human evaluations, and explore why.',
							tag: 'Methodology',
						},
						{
							date: 'Mar 2025',
							title: 'Q1 2025 benchmark update: new models, expanded language coverage',
							summary: 'This quarter adds 15 new language pairs and two new model families. Full notes on what changed and what it means.',
							tag: 'Update',
						},
						{
							date: 'Feb 2025',
							title: 'Does fine-tuning for translation actually help LLMs?',
							summary: 'We compare base vs. instruction-tuned vs. translation-fine-tuned variants across five model families.',
							tag: 'Research',
						},
					].map((item) => (
						<a href="#" class="group flex flex-col rounded-lg border border-foreground/10 p-6 transition-colors hover:border-foreground/20 hover:bg-foreground/2">
							<div class="flex items-center justify-between gap-3">
								<span class="text-xs font-medium text-foreground/50">{item.date}</span>
								<span class="rounded-full bg-foreground/6 px-2.5 py-1 text-xs font-semibold text-foreground/65">{item.tag}</span>
							</div>
							<h2 class="mt-3 leading-snug font-semibold group-hover:text-accent">{item.title}</h2>
							<p class="mt-2 flex-1 text-sm text-foreground/65">{item.summary}</p>
							<p class="mt-4 text-xs font-semibold text-accent">Read more →</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Layout>
