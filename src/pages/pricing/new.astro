</Layout>

<style>
	/* Segment-driven show/hide. Each `[data-segment]` element carries `data-segments`
	   tokens; anything that doesn't match the active segment is removed. */
	[data-pricing][data-active-segment='translate'] [data-segment]:not([data-segments~='translate']),
	[data-pricing][data-active-segment='sell'] [data-segment]:not([data-segments~='sell']),
	[data-pricing][data-active-segment='need'] [data-segment]:not([data-segments~='need']) {
		display: none !important;
	}
</style>

<style is:global>
	/* View-transition pseudo-elements live on the document root, so they can't be
	   component-scoped. Each card has a unique `view-transition-name`, plus a
	   per-transition `view-transition-class` set in script:
	     • card-morph — the plan exists in both the old and new segment (e.g. Team,
	       Business), so it smoothly morphs from its old slot to its new one.
	     • card-move  — the plan only exists on one side, so it slides in/out in the
	       direction of travel (`data-segment-direction` on <html>). */
	@media (prefers-reduced-motion: no-preference) {
		::view-transition-group(.card-morph),
		::view-transition-group(.card-move),
		::view-transition-old(.card-move),
		::view-transition-new(.card-move),
		::view-transition-group(segment-pill),
		::view-transition-group(.segment-option) {
			animation-duration: 0.45s;
			animation-timing-function: cubic-bezier(0.5, 0.05, 0.2, 1);
		}

		:root[data-segment-direction='forward']::view-transition-old(.card-move) {
			animation-name: card-exit-left;
		}
		:root[data-segment-direction='forward']::view-transition-new(.card-move) {
			animation-name: card-enter-right;
		}
		:root[data-segment-direction='back']::view-transition-old(.card-move) {
			animation-name: card-exit-right;
		}
		:root[data-segment-direction='back']::view-transition-new(.card-move) {
			animation-name: card-enter-left;
		}
	}

	@keyframes card-exit-left {
		to {
			transform: translateX(-160%);
			opacity: 0;
		}
	}
	@keyframes card-enter-right {
		from {
			transform: translateX(160%);
			opacity: 0;
		}
	}
	@keyframes card-exit-right {
		to {
			transform: translateX(160%);
			opacity: 0;
		}
	}
	@keyframes card-enter-left {
		from {
			transform: translateX(-160%);
			opacity: 0;
		}
	}
</style>

<script>
	// @ts-nocheck
	const root = document.querySelector('[data-pricing]')
	if (root) {
		const params = new URLSearchParams(location.search)
		const SEG_DEFAULT = root.getAttribute('data-active-segment') || 'sell'
		const segmentDefaults = { translate: 'freelance', sell: 'team', need: 'business' }
		// Default "most popular" card per segment. Overridable via ?popular=<productId>.
		const popularDefaults = { translate: 'freelance', sell: 'team', need: 'business' }
		const segmentLabel = { translate: 'I translate', sell: 'I sell translations', need: 'I need translation' }
		const segmentSubtitles = {
			translate: 'For individual translators. 14 day risk-free trial.',
			sell: 'Built for language service providers and translation teams who deliver for clients.',
			need: 'For businesses and enterprises managing translation at scale, securely.',
		}
		const canVT = typeof document.startViewTransition === 'function' && !matchMedia('(prefers-reduced-motion: reduce)').matches
		const radios = Array.from(root.querySelectorAll('input[name="segment"]'))

		// Shared billing/currency state (declared up here so the segment logic can
		// reposition the billing pills when priced cards become visible again).
		// `billing` is the contract length; `cadence` is how an annual contract is
		// paid (yearly up-front vs monthly instalments), set via the "yearly" dropdown.
		let currency = 'GBP'
		let billing = 'annual'
		let cadence = 'yearly'

		const activeSeg = () => root.getAttribute('data-active-segment') || SEG_DEFAULT

		// Slide the gradient pill to sit behind the active segment label. Measured
		// from the live label so it tracks gaps, padding and responsive sizing.
		const pill = root.querySelector('[data-segment-indicator]')
		function positionIndicator() {
			if (!pill) return
			const fs = pill.parentElement
			const input = fs.querySelector('input[name="segment"][value="' + activeSeg() + '"]')
			const label = input && input.closest('label')
			if (!label) return
			pill.style.width = label.offsetWidth + 'px'
			pill.style.transform = 'translateX(' + label.offsetLeft + 'px)'
		}

		function applyPopular() {
			const seg = activeSeg()
			const visible = Array.from(root.querySelectorAll('[data-product][data-segments~="' + seg + '"]')).map((c) => c.dataset.product)
			// ?popular= is a positional comma list mapped to segmentOrder [translate, sell, need].
			// A trailing segment with no value inherits the last value given (so two values
			// still cover all three), but an explicit value always supersedes that carry-over.
			// A value not visible in its segment falls back to the segment default.
			const list = (params.get('popular') || '').split(',').map((s) => s.trim())
			const idx = segmentOrder.indexOf(seg)
			const want = idx < list.length ? list[idx] : list[list.length - 1]
			const pop = want && visible.includes(want) ? want : popularDefaults[seg]
			root.querySelectorAll('[data-product]').forEach((wrap) => {
				const card = wrap.querySelector('[data-card]')
				if (card) card.toggleAttribute('data-popular', wrap.dataset.product === pop)
			})
		}

		function applySeg(seg) {
			root.setAttribute('data-active-segment', seg)
			const r = radios.find((r) => r.value === seg)
			if (r) r.checked = true
			root.querySelectorAll('[data-segment-subtitle]').forEach((sub) => {
				sub.textContent = segmentSubtitles[seg]
			})
			const cmp = root.querySelector('[data-comparison-subtitle]')
			if (cmp) cmp.textContent = 'See exactly what’s included across the “' + segmentLabel[seg] + '” plans.'
			applyPopular()
			positionIndicator()
		}

		const segmentOrder = ['translate', 'sell', 'need']

		// A card that's in both segments morphs between its slots; one that only
		// exists on one side slides in/out.
		function tagCards(cur, next) {
			root.querySelectorAll('[data-product][data-segments]').forEach((el) => {
				const segs = el.getAttribute('data-segments').split(' ')
				const persists = segs.includes(cur) && segs.includes(next)
				el.style.setProperty('view-transition-class', persists ? 'card-morph' : 'card-move')
			})
		}

		function setSeg(seg) {
			const cur = activeSeg()
			if (seg === cur || !segmentDefaults[seg]) return
			if (!canVT) {
				applySeg(seg)
				return
			}
			const el = document.documentElement
			el.dataset.segmentDirection = segmentOrder.indexOf(seg) > segmentOrder.indexOf(cur) ? 'forward' : 'back'
			tagCards(cur, seg)
			const t = document.startViewTransition(() => applySeg(seg))
			t.finished.finally(() => delete el.dataset.segmentDirection)
		}

		radios.forEach((radio) => {
			radio.addEventListener('click', (e) => {
				if (radio.value === activeSeg()) return
				e.preventDefault()
				setSeg(radio.value)
			})
			radio.addEventListener('keyup', () => {
				if (radio.checked) setSeg(radio.value)
			})
		})

		// Initial state from the URL (?segment=…), applied without a transition.
		// Suppress the pill's transition so it doesn't grow/slide in on first paint.
		if (pill) pill.style.transition = 'none'
		const initSeg = params.get('segment')
		applySeg(initSeg && segmentDefaults[initSeg] ? initSeg : activeSeg())
		requestAnimationFrame(() => {
			positionIndicator()
			if (pill) pill.style.transition = ''
		})
		// Keep the pill aligned on resize.
		addEventListener('resize', positionIndicator)

		// ── Billing + currency (priced plans only) ──────────────────────────────
		const rates = { GBP: { sym: '£', rate: 1 }, USD: { sym: '$', rate: 1.27 }, EUR: { sym: '€', rate: 1.17 } }
		const money = (gbp) => {
			const c = rates[currency]
			if (currency === 'GBP') return c.sym + (Number.isInteger(gbp) ? gbp : gbp.toFixed(2))
			return c.sym + Math.round(gbp * c.rate).toLocaleString('en-US')
		}
		// The effective per-month GBP price for an element, across the three states:
		// rolling monthly, annual billed yearly, annual billed monthly.
		function perMonthGbp(el) {
			if (billing !== 'annual') return parseFloat(el.dataset.monthlyGbp)
			return parseFloat(cadence === 'monthly' ? el.dataset.annualMonthlyGbp : el.dataset.annualGbp)
		}
		function refreshPrices() {
			root.querySelectorAll('[data-price]').forEach((el) => {
				const gbp = perMonthGbp(el)
				if (!isNaN(gbp)) el.textContent = money(gbp)
			})
			// Strikethrough reference: the "was" price on annual-yearly, or the rolling
			// monthly rate on annual-monthly (to show the instalment plan still beats it).
			root.querySelectorAll('[data-was]').forEach((el) => {
				let gbp = NaN
				if (billing === 'annual') gbp = parseFloat(cadence === 'monthly' ? el.dataset.wasMonthly : el.dataset.wasYearly)
				el.hidden = isNaN(gbp)
				if (!isNaN(gbp)) el.textContent = money(gbp)
			})
			root.querySelectorAll('[data-billing-note]').forEach((note) => {
				const annual = billing === 'annual'
				note.querySelector('[data-note-rolling]')?.toggleAttribute('hidden', annual)
				const ann = note.querySelector('[data-note-annual]')
				if (ann) ann.toggleAttribute('hidden', !annual)
				if (annual && ann) {
					const priceEl = note.closest('[data-product]')?.querySelector('[data-price]')
					const perMonth = priceEl ? perMonthGbp(priceEl) : NaN
					ann.querySelector('[data-year-total]').textContent = cadence === 'monthly' || isNaN(perMonth) ? '' : money(Math.round(perMonth * 12)) + ' '
					ann.querySelector('[data-cadence-label]').textContent = cadence === 'monthly' ? 'monthly' : 'yearly'
				}
			})
		}
		// Billing toggle: lives on each priced card but drives one shared state, so
		// changing it on any card updates every card's prices and toggle styling.
		// The active option switches instantly (no slide) — sliding looked jarring
		// here since the surrounding price/note elements just snap.
		function syncBilling() {
			root.querySelectorAll('[data-billing]').forEach((b) => {
				const on = b.dataset.billing === billing
				b.classList.toggle('bg-background', on)
				b.classList.toggle('shadow', on)
			})
			root.querySelectorAll('[data-annual-pill]').forEach((el) => el.toggleAttribute('hidden', billing !== 'annual'))
		}
		root.querySelectorAll('[data-billing]').forEach((btn) => {
			btn.addEventListener('click', () => {
				billing = btn.dataset.billing
				syncBilling()
				refreshPrices()
			})
		})

		// Currency dropdown: per-card popover, shared state. Selecting one syncs the
		// chosen currency across every card's radios + label and closes the popover.
		function syncCurrency() {
			root.querySelectorAll('[data-currency-option]').forEach((i) => {
				i.checked = i.value === currency
			})
			root.querySelectorAll('[data-currency-label]').forEach((el) => {
				el.textContent = currency
			})
		}
		root.querySelectorAll('[data-currency-option]').forEach((input) => {
			input.addEventListener('change', () => {
				if (!input.checked) return
				currency = input.value
				syncCurrency()
				refreshPrices()
				input.closest('[popover]')?.hidePopover()
			})
		})

		// Payment cadence (annual contract): "Billed yearly" vs "Billed monthly".
		// Triggered from the "yearly" word in each priced card's bill note; shared
		// state, closes its popover on select.
		function syncCadence() {
			root.querySelectorAll('[data-cadence-option]').forEach((i) => {
				i.checked = i.value === cadence
			})
		}
		root.querySelectorAll('[data-cadence-option]').forEach((input) => {
			input.addEventListener('change', () => {
				if (!input.checked) return
				cadence = input.value
				syncCadence()
				refreshPrices()
				input.closest('[popover]')?.hidePopover()
			})
		})

		syncBilling()
		syncCurrency()
		syncCadence()
		refreshPrices()
	}
</script>
