						<!-- Sections -->
						{
							matrix.map((sec) => (
								<>
									<div class="border-y border-foreground/10 bg-foreground/5 px-4 py-3">
										<h4 class="text-base font-semibold">{sec.title}</h4>
									</div>
									{sec.rows.map((r) => (
										<div data-comparison class="grid items-stretch border-b border-foreground/10 last:border-b-0 group-data-[active-segment=translate]:grid-cols-[16.5rem_repeat(2,minmax(6rem,1fr))] group-data-[active-segment=sell]:grid-cols-[16.5rem_repeat(3,minmax(6rem,1fr))] group-data-[active-segment=need]:grid-cols-[16.5rem_repeat(4,minmax(6rem,1fr))]">
											<div class="flex items-center px-4 py-4 text-sm font-medium">{r.label}</div>
											{order.map((id) => {
												const v = r.vals[id]
												return (
													<div data-segment data-segments={segmentTokens[id]} class="flex items-center justify-center border-l border-foreground/5 px-3 py-4 text-center">
														{v === true && (
