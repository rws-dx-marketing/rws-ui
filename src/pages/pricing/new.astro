											<span class="mt-1 text-xs text-foreground/60">
												{p.priceType === 'billing' && (
													<span data-price data-monthly-gbp={p.price.monthlyGbp} data-annual-gbp={p.price.annualGbp} data-annual-monthly-gbp={p.price.annualMonthlyGbp}>
