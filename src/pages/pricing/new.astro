						<!-- Column header -->
						<div data-comparison data-comparison-header class="sticky top-0 z-20 grid items-start border-b border-foreground/10 bg-background/95 backdrop-blur group-data-[active-segment=translate]:grid-cols-[16.5rem_repeat(2,minmax(6rem,1fr))] group-data-[active-segment=sell]:grid-cols-[16.5rem_repeat(3,minmax(6rem,1fr))] group-data-[active-segment=need]:grid-cols-[16.5rem_repeat(4,minmax(6rem,1fr))]">
							<div class="self-center px-4 py-5 text-xs font-bold tracking-wider text-foreground/50 uppercase">Features</div>
							{
								order.map((id) => {
									const p = products[id]
									const [brand, productName] = splitName(p.name)
									return (
										<div data-segment data-segments={segmentTokens[id]} class="flex flex-col items-center px-3 py-5 text-center">
