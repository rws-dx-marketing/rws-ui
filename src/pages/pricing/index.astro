---
import Layout from '../../layouts/Trados.astro'
---

<Layout title="Pricing – RWS UI">
	<!-- Introduction -->
	<section class="py-16" data-theme="default">
		<!-- Container -->
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Intro -->
			<div class="mx-auto max-w-screen-sm text-center">
				<!-- Heading -->
				<h2 class="mb-4 text-3xl font-bold tracking-tight xl:text-4xl">Pricing</h2>

				<!-- Copy -->
				<p class="text-lg/relaxed text-pretty text-foreground-muted xl:text-xl/relaxed">Used by more freelance translators than any other solution on the market, with Trados you can confidently plug into the localization supply chain and work on whatever comes your way.</p>

				<!-- Buttons -->
				<!-- <div class="mt-8 flex items-center justify-center gap-4">
					<a href="/pricing/" class="btn btn-secondary xl:btn-lg" aria-current="page">New customers</a>
					<a href="/pricing/existing" class="btn btn-outline xl:btn-lg">Existing customers</a>
				</div> -->
			</div>
		</div>
	</section>

	<!-- Pricing plans -->
	<section class="pt-0 pb-12 md:pb-16 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Pricing options and currency -->
			<div class="mb-12 flex flex-wrap items-baseline gap-10">
				<div hidden class="btn-group" role="group">
					<button type="button" class="btn btn-outline">Monthly</button>

					<button type="button" class="btn btn-primary relative">
						Annual
						<span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-55/100 -rotate-3 font-cursive text-lg/none font-semibold whitespace-nowrap text-accent">
							Best value
							<svg class="relative left-0.5 mx-auto mt-3 size-3.5 rotate-3" viewBox="0 0 97 182" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M39.9587 172.361C44.3791 171.771 47.3841 167.346 46.6995 163.023C46.7296 163.376 46.7597 163.72 46.7896 164.065C46.7755 164.393 46.7605 164.725 46.7385 165.052C53.5909 114.861 57.8637 64.5023 58.0993 13.8232C59.0143 9.16065 58.361 3.29881 53.6065 1.00491C48.6069 -1.82103 42.0165 1.63234 41.5449 7.38224C42.193 13.1849 41.749 18.9534 41.5613 24.8659C40.91 44.8302 40.9179 64.8018 39.5169 84.7291C38.0036 104.575 34.9065 124.253 32.9966 144.056C33.198 153.294 24.524 172.626 39.9587 172.361Z" fill="currentColor"></path>
