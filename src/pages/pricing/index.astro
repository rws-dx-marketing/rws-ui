<script>
	// @ts-nocheck
	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.querySelector('[data-billing-toggle]')
		if (!toggle) return

		const priceEls = document.querySelectorAll('[data-price]')
		const annualNoteEls = document.querySelectorAll('[data-billing-annual-note]')

		function updateBillingUI() {
			const yearly = toggle.checked

			priceEls.forEach((el) => {
				const monthly = el.dataset.priceMonthly
				const yearlyPrice = el.dataset.priceYearly

				el.textContent = yearly ? (yearlyPrice ?? monthly) : (monthly ?? yearlyPrice)
			})

			annualNoteEls.forEach((el) => {
				el.hidden = !yearly
			})
		}

		toggle.addEventListener('change', updateBillingUI)
		updateBillingUI()
	})
</script>
