							</svg>
						</span>
					</button>

					<button type="button" class="btn btn-outline">Annual Saver</button>
				</div>

				<!-- <div>
					<label class="inline-flex cursor-pointer items-center">
						<input type="checkbox" value="" class="peer sr-only" />
						<div class="peer relative h-5 w-9 rounded-full bg-foreground-soft transition-colors peer-checked:bg-accent peer-focus:ring-0 peer-focus:outline-none after:absolute after:start-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-buffer rtl:peer-checked:after:-translate-x-full"></div>
						<span class="ms-3 font-semibold select-none">Pay annually to <span class="font-semibold text-accent">save 20%</span></span>
					</label>
				</div> -->

				<div>
					<label class="inline-flex cursor-pointer items-center">
						<input type="checkbox" value="" class="peer sr-only" data-billing-toggle />
						<div class="peer relative h-5.5 w-10 rounded-full bg-foreground-soft transition-colors peer-checked:bg-accent peer-focus:ring-0 peer-focus:outline-none after:absolute after:start-0.5 after:top-0.5 after:size-4.5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-buffer rtl:peer-checked:after:-translate-x-full"></div>
						<span class="ms-3 text-lg font-semibold select-none">Pay annually to <span class="font-semibold text-accent">save 25%</span></span>
					</label>
				</div>

				<ul class="ml-auto flex items-center gap-4">
					<li>
						<div class="inline-flex items-center">
							<input id="currency-usd" type="radio" value="usd" name="currency" class="focus:ring-2- focus:ring-accent/50- size-4 appearance-none rounded-full border border-foreground-soft checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" checked />
							<label for="currency-usd" class="pl-2 font-semibold">USD</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-gbp" type="radio" value="gbp" name="currency" class="size-4 appearance-none rounded-full border border-foreground-soft checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-gbp" class="pl-2 font-semibold">GBP</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-eur" type="radio" value="eur" name="currency" class="size-4 appearance-none rounded-full border border-foreground-soft checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-eur" class="pl-2 font-semibold">EUR</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-jpy" type="radio" value="jpy" name="currency" class="size-4 appearance-none rounded-full border border-foreground-soft checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-jpy" class="pl-2 font-semibold">JPY</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-cad" type="radio" value="cad" name="currency" class="size-4 appearance-none rounded-full border border-foreground-soft checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-cad" class="pl-2 font-semibold">CAD</label>
						</div>
					</li>
				</ul>
			</div>

