						<span class="mb-6 inline-flex items-center justify-center text-5xl font-bold">
							<span class="text-[90%]">$</span>
							<span class="ml-1" data-price data-price-monthly="40" data-price-yearly="30">40</span>
							<span class="ml-3 text-lg text-foreground-subtle" data-billing-period>per month</span>
						</span>

						<div class="mb-5" data-billing-annual-note>
