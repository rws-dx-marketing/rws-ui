<script>
	// Tabs

	const tabList = document.getElementById('pricing-tabs')
	const tabButtons = tabList?.querySelectorAll('[data-plan-target]') ?? []

	function showPlanForButton(button) {
		const targetSelector = button.getAttribute('data-plan-target')
		if (!targetSelector) return

		tabButtons.forEach((tabButton) => {
			const planSelector = tabButton.getAttribute('data-plan-target')
			const planEl = planSelector ? document.querySelector(planSelector) : null
			planEl?.classList.add('hidden')
		})

		const targetEl = document.querySelector(targetSelector)
		targetEl?.classList.remove('hidden')
	}

	tabButtons.forEach((button) => {
		button.addEventListener('click', () => showPlanForButton(button))
	})

	const initialButton = tabList?.querySelector('[aria-selected="true"]')
	if (initialButton) showPlanForButton(initialButton)

	// Dialog

	const dialogTrigger = document.querySelector('#productButtonDialog')
	const dialogEl = document.querySelector('#productDialog')
	const dialogClose = dialogEl?.querySelector('[data-dialog-close]')

	const lockBodyScroll = () => {
		const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth
		document.body.style.overflow = 'hidden'
		document.body.style.paddingRight = scrollbarWidth ? `${scrollbarWidth}px` : ''
	}

	const unlockBodyScroll = () => {
		document.body.style.overflow = ''
		document.body.style.paddingRight = ''
	}

	if (dialogTrigger && dialogEl instanceof HTMLDialogElement) {
		dialogTrigger.addEventListener('click', () => {
			dialogEl.showModal()
			lockBodyScroll()
		})

		dialogClose?.addEventListener('click', () => dialogEl.close())

		dialogEl.addEventListener('click', (event) => {
			if (event.target === dialogEl) {
				dialogEl.close()
			}
		})

		// Ensure body is restored on all close paths (ESC, close(), backdrop)
		dialogEl.addEventListener('close', unlockBodyScroll)
		dialogEl.addEventListener('cancel', unlockBodyScroll)
	}

	// Total

	const qtyGroups = document.querySelectorAll('[data-qty-group]')
	qtyGroups.forEach((group) => {
		const qtyInput = group.querySelector('[data-qty-input]')
		const decBtn = group.querySelector('[data-qty-dec]')
		const incBtn = group.querySelector('[data-qty-inc]')
		const totalEl = group.querySelector('[data-qty-total]')

		if (!(qtyInput instanceof HTMLInputElement) || !(decBtn instanceof HTMLButtonElement) || !(incBtn instanceof HTMLButtonElement) || !(totalEl instanceof HTMLElement)) {
			return
		}

		const unitPrice = Number(totalEl.dataset.unitPrice) || 0
		const min = Number(qtyInput.min) || 1
		const max = Number(qtyInput.max) || Infinity
		const step = Number(qtyInput.step) || 1

		const updateTotal = () => {
			const qty = Math.max(min, Math.min(max, Number(qtyInput.value) || min))
			qtyInput.value = String(qty)
			totalEl.textContent = String((qty * unitPrice).toFixed(0))
		}

		decBtn.addEventListener('click', () => {
			qtyInput.value = String((Number(qtyInput.value) || min) - step)
			updateTotal()
		})

		incBtn.addEventListener('click', () => {
			qtyInput.value = String((Number(qtyInput.value) || min) + step)
			updateTotal()
		})

		qtyInput.addEventListener('input', updateTotal)
		updateTotal()
	})
</script>
