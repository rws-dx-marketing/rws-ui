---
import Layout from '../../layouts/Trados.astro'
---

<Layout title="Pricing alt custom – RWS UI">
	<!-- Introduction -->
	<section class="pricing-intro">
		<div class="pricing-intro__inner">
			<div class="pricing-intro__header">
				<h2 class="pricing-intro__title">Pricing</h2>
				<p class="pricing-intro__description">Used by more freelance translators than any other solution on the market, with Trados you can confidently plug into the localization supply chain and work on whatever comes your way.</p>
			</div>
		</div>
	</section>

	<!-- Pricing plans -->
	<section class="pricing-plans">
		<div class="pricing-plans__inner">
			<div class="pricing-plans__controls">
				<div class="pricing-plans__billing-toggle" role="group">
					<button type="button" class="pricing-plans__billing-toggle-button" data-billing-option="monthly">Monthly</button>

					<button type="button" class="pricing-plans__billing-toggle-button pricing-plans__billing-toggle-button--active" data-billing-option="annual">
						Annual
						<span class="pricing-plans__badge">
							Most popular
							<svg class="pricing-plans__badge-icon" viewBox="0 0 97 182" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M39.9587 172.361C44.3791 171.771 47.3841 167.346 46.6995 163.023C46.7296 163.376 46.7597 163.72 46.7896 164.065C46.7755 164.393 46.7605 164.725 46.7385 165.052C53.5909 114.861 57.8637 64.5023 58.0993 13.8232C59.0143 9.16065 58.361 3.29881 53.6065 1.00491C48.6069 -1.82103 42.0165 1.63234 41.5449 7.38224C42.193 13.1849 41.749 18.9534 41.5613 24.8659C40.91 44.8302 40.9179 64.8018 39.5169 84.7291C38.0036 104.575 34.9065 124.253 32.9966 144.056C33.198 153.294 24.524 172.626 39.9587 172.361Z" fill="currentColor"></path>
								<path d="M44.4736 181.994C61.4374 176.52 72.4714 159.417 83.0168 145.85C87.7103 138.239 95.6013 131.473 96.7739 122.296C96.7644 115.181 87.5745 111.286 82.6854 116.55C72.5714 134.234 60.2906 152.283 43.7251 164.825C34.0609 150.446 25.8995 135.007 14.4468 121.838C7.7852 113.696 -4.67948 123.618 1.82514 131.941C5.70286 136.807 9.42418 141.786 13.1328 146.783C22.8354 157.746 27.5705 181.399 44.4736 181.994Z" fill="currentColor"></path>
							</svg>
						</span>
					</button>

					<button type="button" class="pricing-plans__billing-toggle-button" data-billing-option="annual-saver">Annual Saver</button>
				</div>

				<ul class="pricing-plans__currency-toggle">
					<li class="pricing-plans__currency-item">
						<div class="pricing-plans__currency-control">
							<input id="currency-usd" type="radio" value="usd" name="currency" class="pricing-plans__currency-radio" checked />
							<label for="currency-usd" class="pricing-plans__currency-label">USD</label>
						</div>
					</li>

					<li class="pricing-plans__currency-item">
						<div class="pricing-plans__currency-control">
							<input id="currency-gbp" type="radio" value="gbp" name="currency" class="pricing-plans__currency-radio" />
							<label for="currency-gbp" class="pricing-plans__currency-label">GBP</label>
						</div>
					</li>

					<li class="pricing-plans__currency-item">
						<div class="pricing-plans__currency-control">
							<input id="currency-eur" type="radio" value="eur" name="currency" class="pricing-plans__currency-radio" />
							<label for="currency-eur" class="pricing-plans__currency-label">EUR</label>
						</div>
					</li>

					<li class="pricing-plans__currency-item">
						<div class="pricing-plans__currency-control">
							<input id="currency-jpy" type="radio" value="jpy" name="currency" class="pricing-plans__currency-radio" />
							<label for="currency-jpy" class="pricing-plans__currency-label">JPY</label>
						</div>
					</li>

					<li class="pricing-plans__currency-item">
						<div class="pricing-plans__currency-control">
							<input id="currency-cad" type="radio" value="cad" name="currency" class="pricing-plans__currency-radio" />
							<label for="currency-cad" class="pricing-plans__currency-label">CAD</label>
						</div>
					</li>
				</ul>
			</div>

			<div class="pricing-plans__cards">
				<div class="pricing-plans__card">
					<div class="pricing-plans__card-header">
						<h3 class="pricing-plans__card-title">Trados Go</h3>

						<span class="pricing-plans__card-price">
							<span class="pricing-plans__card-price-currency">$</span>
							<span class="pricing-plans__card-price-value" data-price data-price-monthly="40" data-price-annual="34" data-price-annual-saver="30">34</span>
							<span class="pricing-plans__card-price-unit">per month</span>
						</span>

						<div class="pricing-plans__card-billing">
							<span class="pricing-plans__card-billing-note" data-billing-note>
								<span data-note="monthly">Monthly contract — monthly payment</span>
								<span data-note="annual">Annual contract — monthly payment</span>
								<span data-note="annual-saver" class="pricing-plans__card-billing-note-accent">$360 billed annually</span>
								<span data-note="annual-saver">Annual contract — annual payment</span>
								<span data-note="annual-saver" class="pricing-plans__card-billing-note-extra"> Includes freelance support agreement </span>
							</span>
						</div>

						<div class="pricing-plans__card-description">
							<p>Get translating fast with our browser-based CAT tool - quick to set up, easy to access, and packed with the features you need to stay productive from anywhere.</p>
						</div>
					</div>

					<div class="pricing-plans__card-cta">
						<a href="#" class="pricing-plans__card-cta-button">Start your free trial</a>
					</div>

					<div class="pricing-plans__card-features">
						<ul role="list" class="pricing-plans__card-features-list">
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="240 216 184 104 128 216" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="144" y1="184" x2="224" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="96" y1="32" x2="96" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="56" x2="160" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><path d="M128,56a96,96,0,0,1-96,96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M72.7,96A96,96,0,0,0,160,152" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="pricing-plans__card-features-item-label">Unlimited languages</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M100,208H72A56,56,0,1,1,85.92,97.74" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="124 160 156 128 188 160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="156" y1="208" x2="156" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><path d="M80,128a80,80,0,1,1,156,25.05" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="pricing-plans__card-features-item-label">Cloud projects only</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polygon points="160 16 148 96 208 120 96 240 108 160 48 136 160 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polygon></svg>
								<span class="pricing-plans__card-features-item-label">Throughput of 1 million target words per year</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><rect x="28" y="84" width="160" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect><path d="M68,84V52a8,8,0,0,1,8-8H220a8,8,0,0,1,8,8V164a8,8,0,0,1-8,8H188" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="28" y1="124" x2="188" y2="124" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="pricing-plans__card-features-item-label">Online editor</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="168" y1="92" x2="232" y2="92" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="168" y1="132" x2="232" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="172" x2="232" y2="172" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="212" x2="232" y2="212" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="128 72 128 56 32 56 32 72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="64" y1="132" x2="96" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="56" x2="80" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="pricing-plans__card-features-item-label">Translation engines</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M32,56H224a0,0,0,0,1,0,0V192a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V56A0,0,0,0,1,32,56Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="32" y1="104" x2="224" y2="104" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="152" x2="224" y2="152" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="88" y1="104" x2="88" y2="200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="pricing-plans__card-features-item-label">Terminology management</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M216,112V56a8,8,0,0,0-8-8H48a8,8,0,0,0-8,8v56c0,96,88,120,88,120S216,208,216,112Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="88 136 112 160 168 104" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								<span class="pricing-plans__card-features-item-label">Quality assurance</span>
							</li>
						</ul>
					</div>
				</div>

				<div class="pricing-plans__card pricing-plans__card--highlight">
					<div class="pricing-plans__card-header">
						<h3 class="pricing-plans__card-title">Trados Studio Freelance</h3>

						<span class="pricing-plans__card-price">
							<span class="pricing-plans__card-price-currency">$</span>
							<span class="pricing-plans__card-price-value" data-price data-price-monthly="54" data-price-annual="47" data-price-annual-saver="40">47</span>
							<span class="pricing-plans__card-price-unit">per month</span>
						</span>

						<div class="pricing-plans__card-billing">
							<span class="pricing-plans__card-billing-note" data-billing-note>
								<span data-note="monthly">Monthly contract — monthly payment</span>
								<span data-note="annual">Annual contract — monthly payment</span>
								<span data-note="annual-saver" class="pricing-plans__card-billing-note-accent">$480 billed annually</span>
								<span data-note="annual-saver">Annual contract — annual payment</span>
								<span data-note="annual-saver" class="pricing-plans__card-billing-note-extra"> Includes freelance support agreement </span>
							</span>
						</div>

						<div class="pricing-plans__card-description">
							<p>A powerful CAT tool combining desktop power and browser convenience - designed for a more comprehensive translation experience with advanced features, flexibility, and control.</p>
						</div>
					</div>

					<div class="pricing-plans__card-cta">
						<a href="#" class="pricing-plans__card-cta-button">Start your free trial</a>
					</div>

					<div class="pricing-plans__card-features">
						<ul role="list" class="pricing-plans__card-features-list">
							<li class="pricing-plans__card-features-item pricing-plans__card-features-item--muted">
								<span class="pricing-plans__card-features-item-label">The same features as Trados Go plus:</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><rect x="32" y="48" width="192" height="140" rx="16" transform="translate(256 236) rotate(180)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect><line x1="160" y1="224" x2="96" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="148" x2="224" y2="148" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="128" y1="192" x2="128" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="pricing-plans__card-features-item-label">Desktop editor</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><ellipse cx="128" cy="80" rx="88" ry="48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></ellipse><path d="M40,80v48c0,26.51,39.4,48,88,48s88-21.49,88-48V80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M40,128v48c0,26.51,39.4,48,88,48s88-21.49,88-48V128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="pricing-plans__card-features-item-label">Local, server and cloud projects</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polygon points="160 16 148 96 208 120 96 240 108 160 48 136 160 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polygon></svg>
								<span class="pricing-plans__card-features-item-label">Unlimited desktop throughput</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="120" r="40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M63.8,199.37a72,72,0,0,1,128.4,0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M222.67,112A95.92,95.92,0,1,1,144,33.33" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="184 56 200 72 232 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								<span class="pricing-plans__card-features-item-label">Reviewer mode</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="32.7 76.92 128 129.08 223.3 76.92" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="128" y1="129.09" x2="128" y2="231.97" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><path d="M219.84,182.84l-88,48.18a8,8,0,0,1-7.68,0l-88-48.18a8,8,0,0,1-4.16-7V80.18a8,8,0,0,1,4.16-7l88-48.18a8,8,0,0,1,7.68,0l88,48.18a8,8,0,0,1,4.16,7v95.64A8,8,0,0,1,219.84,182.84Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="81.56 48.31 176 100 176 152" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								<span class="pricing-plans__card-features-item-label">Open project packages</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M124,100a24,24,0,1,1,24-24A24,24,0,0,1,124,100Z"></path><path d="M144,160a24,24,0,1,1,24-24A24,24,0,0,1,144,160Z"></path><path d="M120,216H72a8,8,0,0,1-8-8V171.81L36.42,159.18a8,8,0,0,1-3.77-10.3L56,104a80,80,0,1,1,128,64l8,64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="214.38 88 184 88 144 136" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="124" y1="76" x2="124" y2="24.89" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="pricing-plans__card-features-item-label">3rd party large language models</span>
							</li>
							<li class="pricing-plans__card-features-item">
								<svg class="pricing-plans__card-features-item-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M71.58,144,32,176V48a8,8,0,0,1,8-8H168a8,8,0,0,1,8,8v88a8,8,0,0,1-8,8Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M80,144v40a8,8,0,0,0,8,8h96.42L224,224V96a8,8,0,0,0-8-8H176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="pricing-plans__card-features-item-label">AI assistant</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Comparison table -->
	<section class="pricing-compare">
		<div class="pricing-compare__inner">
			<div class="pricing-compare__header">
				<h2 class="pricing-compare__title">Choose the right option</h2>
				<p class="pricing-compare__description">Compare the features and capabilities to decide which is the right solution for you.</p>
			</div>

			<div class="pricing-compare__scroll" role="region" aria-label="Comparison table">
				<table class="pricing-compare__table">
					<thead>
						<tr class="pricing-compare__header-row">
							<th scope="col" class="pricing-compare__th"></th>
							<th scope="col" class="pricing-compare__th pricing-compare__th--plan">
								<h3 class="pricing-compare__plan-title">Trados Go</h3>
							</th>
							<th scope="col" class="pricing-compare__th pricing-compare__th--plan">
								<h3 class="pricing-compare__plan-title">Trados Studio Freelance</h3>
							</th>
						</tr>
					</thead>

					<tbody>
						<tr class="pricing-compare__row pricing-compare__row--section">
							<td colspan="3" class="pricing-compare__section-cell">
								<h4 class="pricing-compare__section-title">Capacity</h4>
							</td>
						</tr>
						<tr class="pricing-compare__row">
							<td class="pricing-compare__cell pricing-compare__cell--feature">Languages</td>
							<td class="pricing-compare__cell pricing-compare__cell--value">Unlimited</td>
							<td class="pricing-compare__cell pricing-compare__cell--value">Unlimited</td>
						</tr>
						<tr class="pricing-compare__row">
							<td class="pricing-compare__cell pricing-compare__cell--feature">Projects</td>
							<td class="pricing-compare__cell pricing-compare__cell--value">Cloud</td>
							<td class="pricing-compare__cell pricing-compare__cell--value">
