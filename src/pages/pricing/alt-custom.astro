<script>
	// @ts-nocheck
	document.addEventListener('DOMContentLoaded', () => {
		const buttons = document.querySelectorAll('[data-billing-option]')
		if (!buttons.length) return

		const priceEls = document.querySelectorAll('[data-price]')
		const noteEls = document.querySelectorAll('[data-billing-note]')

		let currentMode = 'annual'

		function updateBillingMode(mode) {
			currentMode = mode

			buttons.forEach((btn) => {
				const isActive = btn.dataset.billingOption === mode
				btn.classList.toggle('pricing-plans__billing-toggle-button--active', isActive)
				// btn.classList.toggle('btn-outline', !isActive)
			})

			priceEls.forEach((el) => {
				const monthly = el.dataset.priceMonthly
				const annual = el.dataset.priceAnnual
				const annualSaver = el.dataset.priceAnnualSaver

				let value = monthly

				if (mode === 'annual') {
					value = annual ?? monthly ?? annualSaver
				} else if (mode === 'annual-saver') {
					value = annualSaver ?? annual ?? monthly
				}

				el.textContent = value ?? ''
			})

			noteEls.forEach((noteEl) => {
				const noteSpans = noteEl.querySelectorAll('[data-note]')

				noteSpans.forEach((span) => {
					const spanMode = span.dataset.note
					const shouldShow = spanMode === mode
					span.hidden = !shouldShow
				})
			})
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const mode = btn.dataset.billingOption
				if (!mode) return
				updateBillingMode(mode)
			})
		})

		const primary = Array.from(buttons).find((btn) => btn.classList.contains('btn-primary'))

		if (primary && primary.dataset.billingOption) {
			updateBillingMode(primary.dataset.billingOption)
		} else {
			updateBillingMode(currentMode)
		}
	})
</script>

