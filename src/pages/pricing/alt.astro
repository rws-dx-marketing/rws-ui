<script>
	// @ts-nocheck
	const BILLING_MODES = {
		MONTHLY: 'monthly',
		ANNUAL: 'annual',
		ANNUAL_SAVER: 'annual-saver',
	}
	const DEFAULT_MODE = BILLING_MODES.ANNUAL

	document.addEventListener('DOMContentLoaded', () => {
		const buttons = document.querySelectorAll('[data-billing-option]')
		if (!buttons.length) return

		const prices = document.querySelectorAll('[data-price]')
		const notes = document.querySelectorAll('[data-note]')
		const ribbons = document.querySelectorAll('[data-ribbon]')
		const conditions = document.querySelectorAll('[data-conditions]')
		const offerEnds = document.querySelectorAll('[data-offer-ends-monthly],[data-offer-ends-annual],[data-offer-ends-annual-saver]')
		const offerOnlyEls = document.querySelectorAll('[data-offer-only]')
		const basePriceEls = document.querySelectorAll('[data-base-price]')
		const offerPriceEls = document.querySelectorAll('[data-offer-price]')
		const ctaLinks = document.querySelectorAll('[data-url-monthly],[data-url-annual],[data-url-annual-saver]')

		const offerModes = new Set(
			Array.from(buttons)
				.filter((btn) => btn.hasAttribute('data-billing-offer'))
				.map((btn) => btn.dataset.billingOption),
		)

		function getPriceForMode(el, mode) {
			const { priceMonthly, priceAnnual, priceAnnualSaver } = el.dataset
			let value

			switch (mode) {
				case BILLING_MODES.ANNUAL:
					value = priceAnnual
					break
				case BILLING_MODES.ANNUAL_SAVER:
					value = priceAnnualSaver
					break
				case BILLING_MODES.MONTHLY:
					value = priceMonthly
					break
				default:
					console.error(`Invalid mode: ${mode}`)
					return ''
			}

			if (!value) {
				console.error(`Missing data-price-${mode} for element:`, el)
				return ''
			}
			return value
		}

		function getUrlForMode(el, mode) {
			const { urlMonthly, urlAnnual, urlAnnualSaver } = el.dataset
			let value

			switch (mode) {
				case BILLING_MODES.ANNUAL:
					value = urlAnnual
					break
				case BILLING_MODES.ANNUAL_SAVER:
					value = urlAnnualSaver
					break
				case BILLING_MODES.MONTHLY:
					value = urlMonthly
					break
				default:
					console.error(`Invalid mode for URL: ${mode}`)
					return el.getAttribute('href') ?? ''
			}

			if (!value) {
				console.error(`Missing data-url-${mode} for element:`, el)
				return el.getAttribute('href') ?? ''
			}
			return value
		}

		function getRibbonForMode(el, mode) {
			const { ribbonMonthly, ribbonAnnual, ribbonAnnualSaver } = el.dataset
			let value

			switch (mode) {
				case BILLING_MODES.ANNUAL:
					value = ribbonAnnual
					break
				case BILLING_MODES.ANNUAL_SAVER:
					value = ribbonAnnualSaver
					break
				case BILLING_MODES.MONTHLY:
					value = ribbonMonthly
					break
				default:
					console.error(`Invalid mode for ribbon: ${mode}`)
					return el.textContent ?? ''
			}

			return value || (el.textContent ?? '')
		}

		function getConditionsForMode(el, mode) {
			const { conditionsMonthly, conditionsAnnual, conditionsAnnualSaver } = el.dataset
			let value

			switch (mode) {
				case BILLING_MODES.ANNUAL:
					value = conditionsAnnual
					break
				case BILLING_MODES.ANNUAL_SAVER:
					value = conditionsAnnualSaver
					break
				case BILLING_MODES.MONTHLY:
					value = conditionsMonthly
					break
				default:
					console.error(`Invalid mode for conditions: ${mode}`)
					return el.textContent ?? ''
			}

			return value || (el.textContent ?? '')
		}

		function getOfferEndsForMode(el, mode) {
			const { offerEndsMonthly, offerEndsAnnual, offerEndsAnnualSaver } = el.dataset
			let value

			switch (mode) {
				case BILLING_MODES.ANNUAL:
					value = offerEndsAnnual
					break
				case BILLING_MODES.ANNUAL_SAVER:
					value = offerEndsAnnualSaver
					break
				case BILLING_MODES.MONTHLY:
					value = offerEndsMonthly
					break
				default:
					console.error(`Invalid mode for offer end date: ${mode}`)
					return el.textContent ?? ''
			}

			return value || (el.textContent ?? '')
		}

		function updateBillingMode(mode) {
			buttons.forEach((btn) => {
				const isActive = btn.dataset.billingOption === mode

				btn.classList.toggle('btn-primary', isActive)
				btn.classList.toggle('btn-outline', !isActive)

				btn.toggleAttribute('data-billing-active', isActive)
			})

			prices.forEach((el) => {
				el.textContent = getPriceForMode(el, mode)
			})

			notes.forEach((note) => {
				note.hidden = note.dataset.note !== mode
			})

			ribbons.forEach((el) => {
				el.textContent = getRibbonForMode(el, mode)
			})

			conditions.forEach((el) => {
				el.textContent = getConditionsForMode(el, mode)
			})

			offerEnds.forEach((el) => {
				el.textContent = getOfferEndsForMode(el, mode)
			})

			const isOfferMode = offerModes.has(mode)

			offerOnlyEls.forEach((el) => {
				el.hidden = !isOfferMode
			})

			basePriceEls.forEach((el) => {
				el.hidden = isOfferMode
			})

			offerPriceEls.forEach((el) => {
				el.hidden = !isOfferMode
			})

			ctaLinks.forEach((link) => {
				link.href = getUrlForMode(link, mode)
			})
		}

		const buttonGroup = buttons[0]?.closest('[role="group"]') ?? document

		buttonGroup.addEventListener('click', (e) => {
			const btn = e.target.closest('[data-billing-option]')
			if (!btn?.dataset.billingOption) return
			updateBillingMode(btn.dataset.billingOption)
		})

		const hasButtonForRequested = Array.from(buttons).some((btn) => btn.dataset.billingOption === DEFAULT_MODE)
		const markupActiveButton = document.querySelector('[data-billing-option][data-billing-active]')
		const initialMode = hasButtonForRequested ? DEFAULT_MODE : (markupActiveButton?.dataset.billingOption ?? BILLING_MODES.ANNUAL)
		updateBillingMode(initialMode)
	})
</script>
