---
import Layout from '../../layouts/Trados.astro'
---

<Layout>
	<!-- Introduction -->
	<section class="bg-background py-16 text-foreground" data-theme="default">
		<!-- Container -->
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Intro -->
			<div class="mx-auto max-w-screen-sm text-center">
				<!-- Heading -->
				<h2 class="mb-4 text-3xl font-bold tracking-tight xl:text-4xl">Pricing</h2>

				<!-- Copy -->
				<p class="text-lg/relaxed font-medium text-pretty text-foreground/80 xl:text-xl/relaxed">Used by more freelance translators than any other solution on the market, with Trados you can confidently plug into the localization supply chain and work on whatever comes your way.</p>
			</div>
		</div>
	</section>

	<!-- Pricing plans -->
	<section class="bg-background pt-20 pb-12 text-foreground md:pb-16 lg:pb-20" data-theme="dots">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<!-- Plan controls -->
			<div class="mb-12 flex flex-col flex-wrap items-center gap-10 lg:flex-row">
				<!-- Billing options -->
				<div class="btn-group rounded-full bg-card" role="group">
					<button type="button" class="btn btn-outline btn-sm flex flex-col sm:btn-md" data-billing-option="monthly">
						<span>Monthly contract</span>
						<span class="block text-[0.875em] opacity-80">paid monthly</span>
					</button>

					<button type="button" class="btn btn-primary relative btn-sm flex flex-col sm:btn-md" data-billing-option="annual" data-billing-offer data-billing-active>
						<span>Annual contract</span>
						<span class="block text-[0.875em] opacity-80">paid monthly</span>

						<span class="pointer-events-none absolute -top-11.5 left-[calc(50%-0.25rem)] -translate-x-1/2 -rotate-3 font-cursive text-lg/none font-semibold whitespace-nowrap text-accent">
							Most popular
							<svg class="relative left-0.5 mx-auto mt-1 size-3.5 rotate-3" viewBox="0 0 97 182" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M39.9587 172.361C44.3791 171.771 47.3841 167.346 46.6995 163.023C46.7296 163.376 46.7597 163.72 46.7896 164.065C46.7755 164.393 46.7605 164.725 46.7385 165.052C53.5909 114.861 57.8637 64.5023 58.0993 13.8232C59.0143 9.16065 58.361 3.29881 53.6065 1.00491C48.6069 -1.82103 42.0165 1.63234 41.5449 7.38224C42.193 13.1849 41.749 18.9534 41.5613 24.8659C40.91 44.8302 40.9179 64.8018 39.5169 84.7291C38.0036 104.575 34.9065 124.253 32.9966 144.056C33.198 153.294 24.524 172.626 39.9587 172.361Z" fill="currentColor"></path><path d="M44.4736 181.994C61.4374 176.52 72.4714 159.417 83.0168 145.85C87.7103 138.239 95.6013 131.473 96.7739 122.296C96.7644 115.181 87.5745 111.286 82.6854 116.55C72.5714 134.234 60.2906 152.283 43.7251 164.825C34.0609 150.446 25.8995 135.007 14.4468 121.838C7.7852 113.696 -4.67948 123.618 1.82514 131.941C5.70286 136.807 9.42418 141.786 13.1328 146.783C22.8354 157.746 27.5705 181.399 44.4736 181.994Z" fill="currentColor"></path> </svg>
						</span>
					</button>

					<button type="button" class="btn btn-outline btn-sm flex flex-col sm:btn-md" data-billing-option="annual-saver" data-billing-offer>
						<span>Annual contract</span>
						<span class="block text-[0.875em] opacity-80">paid yearly</span>
					</button>
				</div>

				<!-- Currency -->
				<ul class="flex items-center gap-4 uppercase lg:ml-auto">
					<li>
						<div class="inline-flex items-center">
							<input id="currency-usd" type="radio" value="usd" name="currency" class="focus:ring-2- focus:ring-accent/50- size-4 appearance-none rounded-full border border-foreground/15 checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" checked />
							<label for="currency-usd" class="font-semibold">USD</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-gbp" type="radio" value="gbp" name="currency" class="size-4 appearance-none rounded-full border border-foreground/15 checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-gbp" class="font-semibold">GBP</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-eur" type="radio" value="eur" name="currency" class="size-4 appearance-none rounded-full border border-foreground/15 checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-eur" class="font-semibold">EUR</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-jpy" type="radio" value="jpy" name="currency" class="size-4 appearance-none rounded-full border border-foreground/15 checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-jpy" class="font-semibold">JPY</label>
						</div>
					</li>

					<li>
						<div class="inline-flex items-center">
							<input id="currency-cad" type="radio" value="cad" name="currency" class="size-4 appearance-none rounded-full border border-foreground/15 checked:border-accent checked:before:bg-accent focus:ring-0 focus:outline-none" />
							<label for="currency-cad" class="font-semibold">CAD</label>
						</div>
					</li>
				</ul>
			</div>

			<!-- Cards -->
			<div class="grid items-center gap-6 md:grid-cols-2 xl:gap-10">
				<!-- Card -->
				<div class="relative flex flex-col gap-8 overflow-hidden rounded-lg border border-foreground/10 bg-background/90 p-8 text-center xl:p-10" data-card>
					<!-- Offer label -->
					<!-- <span class="absolute top-2.5 right-2.25 rounded-full bg-linear-to-r from-tertiary/5 via-primary/5 to-secondary/5 px-2 pt-1 pb-1.25 text-sm font-bold select-none" data-offer-only>Save 25%</span> -->

					<div>
						<span class="relative -top-3 mb-3 inline-flex self-center rounded-full bg-linear-to-br from-secondary to-secondary-dark px-3 pt-1 pb-1.25 text-sm font-bold text-white select-none" data-offer-only data-ribbon data-ribbon-monthly="Save 25% (1)" data-ribbon-annual="Save 25% (2)" data-ribbon-annual-saver="Save 25% (3)">Save 25%</span>

						<!-- Name -->
						<h3 class="mb-6 text-2xl font-semibold xl:text-3xl">Trados Go</h3>

						<!-- Price -->
						<span class="mb-6 inline-flex items-center justify-center text-5xl font-bold">
							<span class="text-[0.9em]">$</span>
							<span class="ml-1" data-price data-base-price data-price-monthly="40" data-price-annual="34" data-price-annual-saver="30">40</span>
							<span class="ml-1 line-through" data-price data-offer-price data-price-monthly="40" data-price-annual="34" data-price-annual-saver="30">34</span>
							<span class="ml-1.5 text-accent" data-price data-offer-price data-price-monthly="30" data-price-annual="25" data-price-annual-saver="22">25</span>
							<span class="ml-3 flex flex-col items-start text-lg text-foreground/50">
								per month
								<span class="block text-left text-xs font-semibold text-foreground/50" data-offer-only data-offer-ends-monthly="Offer ends on 30/12/2026* (1)" data-offer-ends-annual="Offer ends on 30/12/2026* (2)" data-offer-ends-annual-saver="Offer ends on 30/12/2026* (3)">Offer ends on 30/12/2026*</span>
							</span>
						</span>

						<!-- Notes -->
						<div class="mb-5">
							<span class="text-lg font-bold text-foreground/80">
								<span data-note="monthly">Monthly contract — monthly payment</span>
								<span data-note="annual">Annual contract — monthly payment</span>
								<span data-note="annual-saver" class="block -translate-y-2.5 text-sm text-accent">$360 billed annually</span>
								<span data-note="annual-saver">Annual contract — annual payment</span>
								<span data-note="annual-saver" class="block text-base font-semibold text-foreground/80">Includes freelance support agreement</span>
							</span>
						</div>

						<!-- Description -->
						<div class="prose font-medium text-foreground/80 md:prose-lg">
							<p>Get translating fast with our browser-based CAT tool - quick to set up, easy to access, and packed with the features you need to stay productive from anywhere.</p>
						</div>
					</div>

					<!-- Call to action -->
					<div>
						<a href="/product/go/subscribe/annual/" class="btn btn-tertiary btn-lg w-full" data-url-monthly="/product/go/subscribe/monthly/" data-url-annual="/product/go/subscribe/annual/" data-url-annual-saver="/product/go/subscribe/annual-saver/"> Start your free trial </a>
					</div>

					<!-- Features -->
					<div>
						<ul role="list" class="grid gap-4 text-left">
							<!-- Feature -->
							<li class="flex items-center gap-3">
								<!-- Icon -->
								<div class="svg-current size-4.5 shrink-0" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="240 216 184 104 128 216" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="144" y1="184" x2="224" y2="184" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="96" y1="32" x2="96" y2="56" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="56" x2="160" y2="56" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><path d="M128,56a96,96,0,0,1-96,96" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M72.7,96A96,96,0,0,0,160,152" fill="none" stroke="red" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								</div>

								<!-- Label -->
								<span class="font-medium">Unlimited languages</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M100,208H72A56,56,0,1,1,85.92,97.74" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="124 160 156 128 188 160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="156" y1="208" x2="156" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><path d="M80,128a80,80,0,1,1,156,25.05" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="font-medium">Cloud projects only</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polygon points="160 16 148 96 208 120 96 240 108 160 48 136 160 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polygon></svg>
								<span class="font-medium">Throughput of 1 million target words per year</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><rect x="28" y="84" width="160" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect><path d="M68,84V52a8,8,0,0,1,8-8H220a8,8,0,0,1,8,8V164a8,8,0,0,1-8,8H188" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="28" y1="124" x2="188" y2="124" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="font-medium">Online editor</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="168" y1="92" x2="232" y2="92" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="168" y1="132" x2="232" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="172" x2="232" y2="172" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="212" x2="232" y2="212" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="128 72 128 56 32 56 32 72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline><line x1="64" y1="132" x2="96" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="80" y1="56" x2="80" y2="132" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="font-medium">Translation engines</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M32,56H224a0,0,0,0,1,0,0V192a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V56A0,0,0,0,1,32,56Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="32" y1="104" x2="224" y2="104" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="152" x2="224" y2="152" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="88" y1="104" x2="88" y2="200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="font-medium">Terminology management</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path d="M216,112V56a8,8,0,0,0-8-8H48a8,8,0,0,0-8,8v56c0,96,88,120,88,120S216,208,216,112Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="88 136 112 160 168 104" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								<span class="font-medium">Quality assurance</span>
							</li>
						</ul>
					</div>

					<span class="absolute right-6 bottom-6 text-xs font-semibold text-foreground/50 xl:right-10 xl:bottom-10" data-offer-only data-conditions data-conditions-monthly="*Conditions apply (1)" data-conditions-annual="*Conditions apply (2)" data-conditions-annual-saver="*Conditions apply (3)">*Conditions apply</span>
				</div>

				<!-- Card -->
				<div class="glow-animate relative order-first flex flex-col gap-8 rounded-lg border border-accent/33 bg-background p-8 text-center md:order-0 xl:p-10" data-card>
					<!-- <span class="absolute top-1.5 right-1.25 rounded-full bg-linear-to-r from-tertiary via-primary to-secondary px-3 pt-1 pb-1.25 text-sm font-bold text-white select-none" data-offer-only>Save 25%</span> -->

					<div>
						<span class="relative -top-3 mb-3 inline-flex self-center rounded-full bg-linear-to-br from-secondary to-secondary-dark px-3 pt-1 pb-1.25 text-sm font-bold text-white select-none" data-offer-only data-ribbon data-ribbon-monthly="Save 25% (1)" data-ribbon-annual="Save 25% (2)" data-ribbon-annual-saver="Save 25% (3)">Save 25%</span>
						<!-- <span class="relative -top-3 mb-3 inline-flex self-center rounded-full bg-linear-to-r from-tertiary/5 via-primary/5 to-secondary/5 px-2.5 pt-1 pb-1.25 text-xs font-bold text-accent/80 select-none">Most popular</span> -->

						<h3 class="mb-6 text-2xl font-semibold xl:mt-2 xl:mb-8 xl:text-3xl">Trados Studio Freelance</h3>

						<span class="mb-6 inline-flex items-center justify-center text-5xl font-bold">
							<span class="text-[90%]">$</span>
							<span class="ml-1" data-price data-base-price data-price-monthly="54" data-price-annual="54" data-price-annual-saver="54">54</span>
							<span class="ml-1 line-through" data-price data-offer-price data-price-monthly="54" data-price-annual="54" data-price-annual-saver="54">54</span>
							<span class="ml-1.5 text-accent" data-price data-offer-price data-price-monthly="47" data-price-annual="47" data-price-annual-saver="40">47</span>
							<span class="ml-3 flex flex-col items-start text-lg text-foreground/50">
								per month
								<span class="block text-left text-xs font-semibold text-foreground/50" data-offer-only data-offer-ends-monthly="Offer ends on 30/12/2026* (1)" data-offer-ends-annual="Offer ends on 30/12/2026* (2)" data-offer-ends-annual-saver="Offer ends on 30/12/2026* (3)">Offer ends on 30/12/2026*</span>
							</span>
						</span>

						<div class="mb-5 xl:mb-8">
							<span class="text-lg font-bold text-foreground/80">
								<span data-note="monthly">Monthly contract — monthly payment</span>
								<span data-note="annual">Annual contract — monthly payment</span>
								<span data-note="annual-saver" class="block -translate-y-2.5 text-sm text-accent">$480 billed annually</span>
								<span data-note="annual-saver">Annual contract — annual payment</span>
								<span data-note="annual-saver" class="block text-base font-semibold text-foreground/80">Includes freelance support agreement</span>
							</span>
						</div>

						<div class="prose font-medium text-foreground/80 md:prose-lg">
							<p>A powerful CAT tool combining desktop power and browser convenience - designed for a more comprehensive translation experience with advanced features, flexibility, and control.</p>
						</div>
					</div>

					<div class="xl:mt-3">
						<a href="/product/studio/subscribe/freelance-annual/" class="btn btn-tertiary btn-lg w-full" data-url-monthly="/product/studio/subscribe/freelance-monthly/" data-url-annual="/product/studio/subscribe/freelance-annual/" data-url-annual-saver="/product/studio/subscribe/freelance-annual-saver/"> Start your free trial </a>
					</div>

					<div>
						<ul role="list" class="grid gap-4 text-left">
							<li class="text-foreground/66">
								<span class="font-medium">The same features as Trados Go plus:</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><rect x="32" y="48" width="192" height="140" rx="16" transform="translate(256 236) rotate(180)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect><line x1="160" y1="224" x2="96" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="32" y1="148" x2="224" y2="148" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="128" y1="192" x2="128" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
								<span class="font-medium">Desktop editor</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><ellipse cx="128" cy="80" rx="88" ry="48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></ellipse><path d="M40,80v48c0,26.51,39.4,48,88,48s88-21.49,88-48V80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M40,128v48c0,26.51,39.4,48,88,48s88-21.49,88-48V128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path></svg>
								<span class="font-medium">Local, server and cloud projects</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polygon points="160 16 148 96 208 120 96 240 108 160 48 136 160 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polygon></svg>
								<span class="font-medium">Unlimited desktop throughput</span>
							</li>

							<li class="flex items-center gap-3">
								<svg class="size-4.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="120" r="40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M63.8,199.37a72,72,0,0,1,128.4,0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><path d="M222.67,112A95.92,95.92,0,1,1,144,33.33" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><polyline points="184 56 200 72 232 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								<span class="font-medium">Reviewer mode</span>
