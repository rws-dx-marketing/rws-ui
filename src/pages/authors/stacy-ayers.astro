---
// @ts-nocheck
// Author detail page. One hand-authored prototype page — the archive links every
// author here in the real build this gets a [slug] route.
//
// The articles grid reuses card-filters.js purely for "Load more": the script
// needs a [data-filters] root and a [data-card-page-size] select to initialise,
// so both are present but hidden — there is no filtering UI on this page.
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/Section.astro'
import Heading from '../../components/Heading.astro'
import { articles, getAuthor } from '../../data/authors'
import Image from '../../components/Image.astro'

const author = getAuthor('stacy-ayers')
---

<Layout title={`${author.name} – Authors – RWS UI`}>
	<Section theme="default">
		<div class="grid max-w-4xl gap-8 sm:grid-cols-[auto_1fr] sm:items-start sm:gap-12">
			<div class="size-28 shrink-0 overflow-hidden rounded-full lg:size-40">
				<Image class="size-full object-cover" src={author.avatar} alt={author.name} draggable="false" />
			</div>

			<div class="min-w-0">
				<div class="mb-3 flex items-center gap-6 font-bold text-foreground-subtle">
					<p><a href="/authors/" class="transition-colors hover:text-accent">Author</a></p>
				</div>

				<Heading as="h1" size="md" class="mb-4 font-bold tracking-tight text-balance">{author.name}</Heading>

				<div class="mb-6 text-lg font-semibold text-foreground-muted md:text-2xl xl:text-3xl">
					<p>{author.role}</p>
				</div>

				<div class="prose text-pretty text-foreground-muted md:prose-lg">
					{author.bio.map((paragraph) => <p>{paragraph}</p>)}
				</div>

				{
					author.social && (
						<div class="mt-8 flex items-center gap-2">
							{author.social.linkedin && (
								<a href={author.social.linkedin} class="svg-current size-6 text-foreground-soft transition-colors hover:text-accent">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
										<path fill="currentColor" fill-rule="evenodd" d="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4zm1.205 6.91a1.705 1.705 0 1 0 0-3.41a1.705 1.705 0 0 0 0 3.41M7.909 19.5V9.273H4.5V19.5h3.41Zm4.432-10.227H9.273V19.5h3.068v-6.17c.395-.642 1.077-1.33 2.045-1.33c1.364 0 1.705 1.364 1.705 2.046V19.5H19.5v-5.454c0-1.828-.797-4.773-3.75-4.773c-1.878 0-2.92.685-3.41 1.327z" clip-rule="evenodd" />
									</svg>
									<span class="sr-only">{author.name} on LinkedIn</span>
								</a>
							)}

							{author.social.x && (
								<a href={author.social.x} class="svg-current size-6 text-foreground-soft transition-colors hover:text-accent">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
										<path fill="currentColor" fill-rule="evenodd" d="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4zm-.334 3.5a.75.75 0 0 0-.338 1.154l5.614 7.45l-5.915 6.345l-.044.051H6.03l4.83-5.179l3.712 4.928a.75.75 0 0 0 .337.251h4.422a.75.75 0 0 0 .336-1.154l-5.614-7.45L20.017 4.5h-2.05l-4.83 5.18l-3.714-4.928a.75.75 0 0 0-.337-.252zm10.88 13.548L6.431 5.952H8.45l9.114 12.095z" clip-rule="evenodd" />
									</svg>
									<span class="sr-only">{author.name} on X</span>
								</a>
							)}

							{/*{author.social.email && (
								<a href={author.social.email} class="svg-current size-6 text-foreground-soft transition-colors hover:text-accent">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
										<rect width="256" height="256" fill="none" />
										<path fill="currentColor" d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,50,45.15H60.55ZM157.29,128,216,74.18V181.82Z" />
									</svg>
									<span class="sr-only">Email {author.name}</span>
								</a>
							)}*/}
						</div>
					)
				}
			</div>
		</div>
	</Section>

	<Section theme="dots" container={false}>
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<div hidden class="flex flex-wrap items-baseline justify-between gap-4">
				<Heading as="h2" size="xs" class="font-bold tracking-tight text-pretty">
					<p>Articles by <em>{author.name}</em></p>
				</Heading>

				<div class="text-sm text-foreground-subtle" data-card-results-count>{articles.length} results</div>
			</div>

			{/* cardFilters() needs a filters root to initialise — this page has no filter UI. */}
			<div hidden data-filters></div>
			<select hidden data-card-page-size>
				<option value="6" selected>6</option>
			</select>

			<div class="mt-12- grid max-w-[80ch] gap-8 sm:grid-cols-2 lg:max-w-none lg:grid-cols-3">
				{
					articles.map((article, index) => (
						<article class="group relative rounded-lg border text-left" data-card data-card-filters="{}" style={`view-transition-name:author-article-${index};view-transition-class:card-move`}>
							<div class="flex h-full flex-col">
								<div class="p-4">
									<div class="mb-5 block overflow-hidden rounded">
										<Image class="aspect-video w-full object-cover transition-transform group-hover:scale-110" src={article.image} alt={article.title} />
									</div>

									<span class="mb-3 inline-block rounded-full border bg-foreground-softest px-2 py-0.5 text-xs font-semibold text-foreground-muted">{article.type}</span>

									<h3 class="mb-2 text-2xl font-bold">
										<p>
											<a href={article.href}>
												{article.title}
												<span class="absolute inset-0" />
											</a>
										</p>
									</h3>

									<div class="mb-3 flex items-center gap-1.5 text-sm font-semibold text-foreground-muted">
										<span>
											{article.date} · {article.readTime}
										</span>
									</div>

									<div class="prose line-clamp-3 text-pretty text-foreground-muted">
										<p>{article.excerpt}</p>
									</div>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<div class="mt-12 text-center">
				<button type="button" class="btn btn-secondary" data-card-load-more hidden>Load more</button>
			</div>

			<div class="mt-12 pt-12 pb-24 text-center" data-card-empty-state hidden>
				<p class="text-2xl font-bold">No articles found</p>
				<p class="mt-2 text-xl text-foreground-muted">This author hasn’t published anything yet.</p>
			</div>
		</div>
	</Section>
</Layout>
