---
import Layout from '../../../layouts/Layout.astro'
---

<Layout title="Localization services – RWS UI">
	<section class="bg-background pt-12 pb-12 text-foreground md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<h1 class="text-3xl font-bold tracking-tight xl:text-4xl">Localization services</h1>
		</div>
	</section>

	<section class="bg-background pb-12 text-foreground md:pb-16 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<ul class="font-semibold">
				{Array.from({ length: 100 }, (_, i) => <li>{i + 1}</li>)}
			</ul>
		</div>
	</section>
</Layout>
