---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/Section.astro'
import Heading from '../../components/Heading.astro'
import { faqs, categories, categoryLabel } from '../../data/faqs'

// One question per page, matching the live FAQDetails template. The full answer
// is authored here; the archive and the related accordion below read the short
// `summary` from the shared data file.
const faq = faqs[0]

// Other questions in the same category, rendered as an accordion so a visitor
// can scan neighbouring answers without leaving the page.
const relatedFaqs = faqs.filter((item) => item.category === faq.category && item.question !== faq.question).slice(0, 4)

const keyPoints = [
	{ title: 'Protected A', copy: 'Can be stored in the cloud as needed.' },
	{ title: 'Protected B', copy: 'Check your IT policy before uploading.' },
	{ title: 'Protected C', copy: 'Should never be placed in the cloud.' },
	{ title: 'Encryption', copy: 'Bring your own keys for Protected B work.' },
]

const resources = [
	{
		type: 'Guide',
		title: 'Data residency and where your content lives',
		description: 'A plain-English walkthrough of the regions we operate in, what is stored where, and how to pick the right one when your account is provisioned.',
		image: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png',
		href: '/resources/blog-1/',
	},
	{
		type: 'Case study',
		title: 'How a federal department kept Protected B work in Canada',
		description: 'Splitting projects by protection level, restricting linguist pools by region, and proving it all to an internal security review.',
		image: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png',
		href: '/resources/case-study/',
	},
	{
		type: 'Whitepaper',
		title: 'Encryption keys, and who should be holding them',
		description: 'Why customer-managed keys matter for regulated work, what changes operationally when you bring your own, and the questions to put to any vendor.',
		image: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png',
		href: '/resources/blog-2/',
	},
]
---

<Layout title={`${faq.question} – FAQ – RWS UI`}>
	<Section top="lg" bottom="md" theme="default">
		<div class="max-w-3xl">
			<div class="mb-3 flex flex-wrap items-center gap-x-2 font-bold text-foreground-muted xl:text-lg">
				<a href="/faqs/" class="transition-colors hover:text-accent">FAQ</a>
				<span class="text-foreground-subtle" aria-hidden="true">·</span>
				<a href={`/faqs/#${faq.category}`} class="transition-colors hover:text-accent">{categoryLabel(faq.category)}</a>
			</div>

			<Heading as="h1" size="sm" class="mb-6 font-bold tracking-tight text-balance">{faq.question}</Heading>

			<div class="prose text-pretty text-foreground-muted md:prose-lg">
				<p>{faq.summary}</p>
			</div>
		</div>
	</Section>

	<Section container={false} theme="dots">
		<div class="mx-auto grid max-w-screen-xl gap-8 px-8 lg:grid-cols-12 lg:px-12 xl:gap-12">
			<aside class="order-2 lg:order-none lg:col-span-4">
				<div class="grid gap-8 transition-[top] duration-300 lg:sticky lg:top-[calc(var(--content-top)+4rem)] xl:gap-12">
					<div hidden class="rounded-lg p-6" data-card>
						<h2 class="mb-4 text-lg font-semibold">Browse by category</h2>

						<ul class="grid gap-2">
							{
								categories.map((category) => (
									<li>
										<a href={`/faqs/#${category.value}`} class:list={['font-semibold transition-colors hover:text-accent', category.value === faq.category && 'text-accent']}>
											{category.label}
										</a>
									</li>
								))
							}
						</ul>

						<div class="mt-6 border-t pt-6">
							<a href="/faqs/" class="btn btn-secondary btn-sm">See all questions</a>
						</div>
					</div>

					<div class="rounded-lg p-6" data-card>
						<div class="flex items-start gap-6">
							<div class="w-1/3 max-w-24 shrink-0">
								<img src="https://placehold.co/200" alt="Placeholder" class="aspect-square size-full rounded object-cover" />
							</div>
							<div>
								<h2 class="mb-2 text-lg font-semibold">Still need an answer?</h2>

								<div class="prose mb-4 text-sm/normal text-foreground-muted">
									<p>Our team can walk you through how your data is handled in your region.</p>
								</div>

								<a href="/contact/" class="btn btn-primary btn-sm">Talk to us</a>
							</div>
						</div>
					</div>
				</div>
			</aside>

			<article class="order-1 col-span-full grid items-start gap-8 lg:order-none lg:col-span-8 xl:gap-12">
				<div class="rounded-lg p-6 lg:p-10" data-card>
					<div class="prose max-w-none text-pretty lg:text-lg">
						<p>For this question we looked at how the Government of Canada classifies sensitive information. As a Trados user you can protect that data in several ways.</p>

						<h2>Ensure only the proper data is stored in the cloud</h2>
						<ul>
							<li>Put Protected A data in the cloud as needed.</li>
							<li>Check your IT policies before putting Protected B data in the cloud.</li>
							<li>Do not put Protected C data in the cloud.</li>
						</ul>

						<h2>Proper encryption</h2>
						<p>Protected B certification requires the ability to use customer-provided encryption keys, so that your organization — not your vendor — controls access to the material at rest.</p>

						<h2>Contract clauses</h2>
						<p>Enforce proper rules and regulations around adding or assigning tasks to users outside of Canada. Trados allows you to organize your data according to your own criteria; make sure Protected level is one criterion.</p>
						<p>Do not allow your employees or linguists to work on Protected B data outside of Canada — for holidays, remote work or any other reason — without validating with your security team first.</p>
					</div>

					<div class="mt-8 flex flex-wrap items-center gap-4">
						<a href="#" class="btn btn-tertiary btn-icon-right">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
							Read the security overview
						</a>
					</div>
				</div>

				<div>
					<h2 class="mb-6 text-2xl font-bold tracking-tight lg:text-3xl">At a glance</h2>

					<div class="grid gap-8 sm:grid-cols-2">
						{
							keyPoints.map((point, index) => (
								<div class="intersect-once grid place-content-center rounded-lg p-6 text-center lg:p-10 intersect:motion-preset-expand" style={`--motion-delay: ${200 + index * 100}ms`} data-theme="secondary">
									<p class="text-2xl font-bold text-balance">{point.title}</p>
									<p class="mt-1 text-pretty">{point.copy}</p>
								</div>
							))
						}
					</div>
				</div>
			</article>
		</div>
	</Section>

	{/* More questions in this category */}
	<Section theme="default">
		<div class="mx-auto max-w-screen-md">
			<Heading as="h2" size="xs" class="mb-12 text-center font-bold tracking-tight text-balance">More questions about {categoryLabel(faq.category).toLowerCase()}</Heading>

			<div class="rounded-lg border px-5.5 pt-5 pb-0" data-card>
				<div class="divide-y" data-accordion>
					{
						relatedFaqs.map((related) => (
							<details class="group">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-left font-semibold group-first:pt-0 in-data-[accordion-locked]:cursor-default md:text-lg">
									<span class="text-pretty transition-colors group-hover:text-accent in-data-open:text-accent">{related.question}</span>
									<svg class="size-5 shrink-0 transition-[color,rotate] group-hover:text-accent group-data-[open]:rotate-180 in-data-open:text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
										<rect width="256" height="256" fill="none" />
										<polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
									</svg>
								</summary>
								<div>
									<div class="border-t py-5">
										<div class="prose text-foreground-muted md:prose-lg">
											<p>{related.summary}</p>
										</div>

										<div class="mt-5">
											<a href={related.href ?? '/faqs/faq-1/'} class="btn btn-tertiary btn-icon-right btn-sm">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
													<>
														<rect width="256" height="256" fill="none" />
														<line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
														<polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
													</>
												</svg>
												Read the full answer
											</a>
										</div>
									</div>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</Section>

	{/* Related resources */}
	<Section theme="pale">
		<div hidden class="mb-3 font-bold text-foreground-muted xl:text-lg">
			<p>This is the subheading</p>
		</div>

		<Heading as="h2" size="sm" class="mb-6 max-w-[24ch] font-bold tracking-tight text-pretty">Related <em>resources</em></Heading>

		<div class="prose text-foreground-muted md:prose-lg">
			<p>Guidance on how your content is stored, encrypted and kept inside the borders you need it to stay within.</p>
		</div>

		<div class="mt-12 grid max-w-[80ch] gap-8 sm:grid-cols-2 lg:mt-16 lg:max-w-none lg:grid-cols-3">
			{
				resources.map((resource) => (
					<article class="group relative rounded-lg border text-left" data-card>
						<div class="flex h-full flex-col">
							<div class="p-4">
								<div class="mb-5 block overflow-hidden rounded">
									<img class="aspect-video w-full object-cover transition-transform group-hover:scale-110" src={resource.image} alt="" />
								</div>

								<span class="mb-3 inline-block rounded-full border bg-foreground-softest px-2 py-0.5 text-xs font-semibold text-foreground-muted">{resource.type}</span>

								<h3 class="mb-2 text-2xl font-bold text-pretty">
									<p>
										<a href={resource.href}>
											{resource.title}
											<span class="absolute inset-0" />
										</a>
									</p>
								</h3>

								<div class="prose line-clamp-3 text-pretty text-foreground-muted">
									<p>{resource.description}</p>
								</div>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</Section>
</Layout>
