---

<Layout title="Reference – RWS UI">
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			{
				/* <div class="mb-3 font-bold text-foreground-muted xl:text-lg">
  			<p>This is the subheading</p>
  		</div> */
			}

			<h2 class="mb-6 max-w-[24ch] text-4xl font-bold tracking-tight text-pretty xl:text-5xl">
				<p>Reference</p>
			</h2>

			<div class="prose text-foreground-muted md:prose-lg">
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elitera. Suspendisse luctus tortor placerat erat consequat, pellentesque venenatis felis posuere. Nullam lectus orci, maximus vel nibh vel, congue sodales ex. Integer auctor nulla vel leo.</p>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a href="/guide" class="btn btn-outline btn-icon-right">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
					Style guide
				</a>
				<!-- <a href="#blocks" class="btn btn-outline">Blocks</a> -->
				<!-- <a href="#templates" class="btn btn-outline">Templates</a> -->
			</div>
		</div>
	</section>

	<section id="blocks" class="scroll-mt-24 pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<header class="mb-10 space-y-2">
				<h1 class="text-3xl font-bold">Blocks</h1>
				<p class="text-foreground-muted">Showcase pages stack each variant across every theme.</p>
			</header>

			<ul class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
				<li hidden>
					<a href="/blocks/tester" class="block rounded-xl border border-gray-200 bg-white p-6 transition-colors hover:border-accent">
						<div class="text-lg font-semibold">Tester</div>
						{/* <div class="mt-1 text-sm text-foreground-muted">{block.variants}</div> */}
					</a>
				</li>
				{
					blocks.map((block) => (
						<li>
							<a href={block.href} class="block rounded-xl border border-gray-200 bg-white px-6 py-5 transition-colors hover:border-accent">
								<div class="text-lg font-semibold">{block.name}</div>
								{/* <div class="mt-1 text-sm text-foreground-muted">{block.variants}</div> */}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="templates" class="scroll-mt-24 pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
			<header class="mb-10 space-y-2">
				<h1 class="text-3xl font-bold">Templates</h1>
				<p class="text-foreground-muted">Full page layouts — archives and their detail pages, grouped by section.</p>
			</header>

			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					templates.map((group) => (
						<li class="rounded-xl border px-6 py-5" data-card>
							<div class="text-lg font-semibold">{group.name}</div>
							<ul class="mt-3 space-y-1">
								{group.pages.map((page) => (
									<li>
										<a href={page.href} class="text-sm text-foreground-muted transition-colors hover:text-accent">
											{page.name}
										</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
