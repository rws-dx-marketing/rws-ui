---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro'
import ResourceHero from '../../blocks/ResourceHero.astro'
import Speakers from '../../components/Speakers.astro'
import { timezones } from '../../data/timezones.js'
import { wallToUTC, FORMATTERS } from '../../lib/event-time.js'
import Image from '../../components/Image.astro'

const recommendations = [
	{
		type: 'Event',
		title: 'IP Service World 2027',
		meta: '22 April 2027 · London, UK',
		description: 'Meet the RWS IP team in London to talk through filing, translation and portfolio support.',
		href: '/events/event/',
		image: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/blog/office-laptops.png',
	},
	{
		type: 'Blog',
		title: 'Behind AI hallucinations: when model errors are really training data problems',
		meta: '10 min read',
		description: 'Many outputs labeled as AI hallucinations are predictable responses to how tasks were defined and data was labeled.',
		href: '/resources/blog-1/',
		image: 'https://www.rws.com/media/dynamic/images/hallucinations_tcm228-295285.webp?original=.png&v=20260402100433',
	},
	{
		type: 'Whitepaper',
		title: 'Modernizing multilingual COAs and eCOA operations in the digital era',
		description: 'How sponsors can modernize COA and eCOA operations with stronger governance, better visibility and more connected delivery.',
		href: '/resources/download/',
		image: 'https://www.rws.com/media/fallback/images/beyond-translation-whitepaper-thumbnail-640x320_tcm228-300593.png',
	},
]

// One authored event object is the whole source of truth. Every displayed time is
// derived from it — the default string shown on load and the UTC instants the
// picker reconverts from — so there's no precomputed per-timezone data to keep in
// sync. Maps onto the CMS Event model: `timezone` from the event location, the
// wall-clock schedule from Date/EndDate, and each field's derived UTC instant +
// default string from DateUtc/EndDateUtc + DateRangeField/TimeRangeField.
const event = {
	timezone: { label: 'EDT', offset: -240 }, // null → defaults to GMT
	start: '2026-09-14T09:00', // full span → Date row
	end: '2026-09-16T18:30',
	dailyStart: '2026-09-14T09:00', // daily hours → Time row
	dailyEnd: '2026-09-14T18:30',
}

const tzOffset = event.timezone?.offset ?? 0
const tzLabel = event.timezone?.label ?? 'GMT'

// Wall-clock range (in the event's zone) → a convertible field: the default string
// to show, plus the UTC instants (ISO) the client reconverts from. The runtime only
// ever sees UTC, so it never needs to know the event's own offset.
const convertible = (startWall, endWall, format) => {
	const startUTC = wallToUTC(startWall, tzOffset)
	const endUTC = wallToUTC(endWall, tzOffset)
	return {
		format,
		value: FORMATTERS[format](startUTC, endUTC, tzOffset, tzLabel),
		start: new Date(startUTC).toISOString(),
		end: new Date(endUTC).toISOString(),
	}
}

const details = {
	date: convertible(event.start, event.end, 'date'),
	time: convertible(event.dailyStart, event.dailyEnd, 'time'),
	venue: 'The Royal Sonesta Boston, 40 Edwin Land Boulevard, Cambridge, MA 02142',
	role: 'Solutions sponsor',
	booth: 'Booth 3',
}

const chip = 'inline-flex items-center gap-2 rounded-[1.25rem] border bg-foreground-softest text-sm font-semibold text-foreground-muted'

const agenda = [
	{
		start: '2026-09-14T09:00',
		end: '2026-09-14T09:30',
		title: 'Registration & networking breakfast',
		description: 'Collect your badge, grab a coffee and connect with fellow attendees before the opening sessions.',
	},
	{
		start: '2026-09-14T09:30',
		end: '2026-09-14T10:15',
		title: 'Opening keynote: The state of IP litigation',
		description: 'A forward look at the trends shaping patent disputes across pharma, biotech and technology.',
		speaker: 'Dr. Elena Marsh',
	},
	{
		start: '2026-09-14T10:30',
		end: '2026-09-14T11:30',
		title: 'Panel: High-stakes disputes in pharma & biotech',
		description: 'Leading litigators share strategies for managing complex, multi-party proceedings.',
		speaker: 'James Okoro, Priya Nair',
	},
	{
		start: '2026-09-15T10:00',
		end: '2026-09-15T11:00',
		title: 'Track: Trade secrets & emerging technology',
		description: 'Protecting confidential information and IP assets as technology moves faster than the law.',
		speaker: 'Thomas Reeve',
	},
	{
		start: '2026-09-15T16:40',
		end: '2026-09-15T18:15',
		title: 'Second-Wave Entrants: Litigation Strategy After the First Generic or Biosimilar Launch',
		description: 'Join RWS for a session on how second-wave entrants can shape litigation strategy following the first generic or biosimilar launch. Further information to follow shortly.',
		speaker: 'Christian Hartmann',
		highlight: true,
	},
	{
		start: '2026-09-16T09:30',
		end: '2026-09-16T10:30',
		title: 'Fireside chat: The in-house perspective',
		description: 'IP leaders discuss building resilient portfolios and working effectively with outside counsel.',
		speaker: 'Priya Nair',
	},
	{
		start: '2026-09-16T11:00',
		end: '2026-09-16T12:00',
		title: 'Closing roundtable & networking',
		description: 'Key takeaways from the summit and an open discussion before the event wraps.',
	},
]

const speakers = [
	{
		name: 'Christian Hartmann',
		role: 'Senior Director of IP Solutions',
		company: 'RWS',
		avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/michael-gouch.png',
		bio: 'Christian partners with in-house IP counsel and law firms across the Western U.S. and Canada on patent search and analytics, foreign filing, IP translations, and portfolio support — including the prior-art and invalidity work that underpins contentious proceedings.',
		href: '#',
	},
]

const speakersThree = [
	{ name: 'Dr. Elena Marsh', role: 'Head of IP Strategy', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/bonnie-green.png', bio: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', href: '#' },
	{ name: 'James Okoro', role: 'Senior Litigation Counsel', company: 'Meridian Legal', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/jese-leos.png', bio: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
	{ name: 'Priya Nair', role: 'Director of Renewals', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/roberta-casas.png', bio: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', href: '#' },
]

// Internal hrefs go to the author page; LinkedIn ones open externally.
const attendees = [
	{ name: 'Stacy Ayers', role: 'Head of Quality, TrainAI', company: 'RWS', avatar: 'https://www.rws.com/media/dynamic/images/stacy-ayers_tcm228-286310.webp?original=.png&v=20260402100433', href: '/authors/stacy-ayers/' },
	{ name: 'Christian Hartmann', role: 'Senior Director of IP Solutions', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/michael-gouch.png', href: 'https://www.linkedin.com/in/placeholder/' },
	{ name: 'Dr. Elena Marsh', role: 'Head of IP Strategy', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/bonnie-green.png', href: '/authors/stacy-ayers/' },
	{ name: 'Thomas Reeve', role: 'IP Account Director', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/neil-sims.png', href: 'https://www.linkedin.com/in/placeholder/' },
	{ name: 'Sofia Almeida', role: 'Patent Search Specialist', company: 'RWS', avatar: 'https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/helene-engels.png', href: 'https://www.linkedin.com/in/placeholder/' },
]
---

<Layout title="Event – RWS UI">
	<ResourceHero layout="wide-text" title="IP North American Litigation Summit" cta={{ href: '#form', text: 'Register', external: false }} share={true} image={{ src: 'https://www.rws.com/media/dynamic/images/hallucinations_tcm228-295285.webp?original=.png&v=20260402100433', alt: 'Placeholder' }}>
		<div slot="details" class="mt-10">
			<ul class="flex flex-wrap gap-3">
				<li class={`${chip} px-4 py-2`}>
					<svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><rect x="40" y="40" width="176" height="176" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></rect><line x1="176" y1="24" x2="176" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></line><line x1="80" y1="24" x2="80" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></line><line x1="40" y1="88" x2="216" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></line></svg>
					<span data-tz data-tz-start={details.date.start} data-tz-end={details.date.end} data-tz-format={details.date.format}>{details.date.value}</span>
				</li>

				<li class={`${chip} pl-4`}>
					<svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></circle><polyline points="128 72 128 128 184 128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></polyline></svg>
					<span class="py-2" data-tz data-tz-start={details.time.start} data-tz-end={details.time.end} data-tz-format={details.time.format}>{details.time.value}</span>

					<div class="flex self-stretch" data-tz-picker>
						<button type="button" class="flex items-center gap-1 rounded-r-[1.25rem] border-l pr-4 pl-3 transition-colors hover:bg-foreground-softer hover:text-foreground" popovertarget="tz-popover" popovertargetaction="toggle" style="anchor-name: --tz-anchor;" aria-label="Change timezone">
							<span data-tz-label>{tzLabel}</span>
							<svg class="size-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
						</button>

						<div id="tz-popover" popover="auto" role="menu" class="dropdown z-10 mt-1 w-max rounded border shadow-lg" style="position-anchor: --tz-anchor; position-area: bottom span-right;">
							<ul class="grid max-h-72 gap-px overflow-y-auto p-2 text-sm font-normal select-none">
								{
									timezones.map((tz) => (
										<li>
											<button type="button" class="w-full truncate rounded px-2 py-1.5 text-left transition-colors hover:bg-tertiary-softer" data-tz-option data-offset={tz.offset} data-label={tz.label} title={tz.label}>
												{tz.label}
											</button>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</li>
			</ul>

			<div class="mt-8 flex items-start gap-2 text-sm font-semibold text-foreground-muted">
				<svg class="mt-0.5 size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="104" r="32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></circle><path d="M208,104c0,72-80,128-80,128S48,176,48,104a80,80,0,0,1,160,0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></path></svg>
				<p>{details.venue}</p>
			</div>

			<p class="mt-4 text-sm text-foreground-muted">{details.role} · Find us at {details.booth}</p>
		</div>
	</ResourceHero>

	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="dots">
		<div class="mx-auto grid max-w-screen-xl gap-8 px-8 lg:grid-cols-12 lg:px-12 xl:gap-12">
			<aside class="hidden lg:col-span-4 lg:block">
				<div class="grid gap-8 transition-[top] duration-300 lg:sticky lg:top-[calc(var(--content-top)+4rem)] xl:gap-12">
					<div class="relative rounded-lg border p-10" data-card hidden>
						<h4 class="mb-6 text-lg font-bold">Table of contents</h4>

						<nav class="relative flex flex-col gap-3 pl-6" data-scrollspy-nav>
							<span aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-full w-1 bg-foreground-softer"></span>
							<span aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-(--post-nav-active-height) w-1 bg-accent transition-[height] duration-1000" data-scrollspy-rail></span>
							<a href="#" class="hidden text-pretty text-foreground-subtle transition-colors hover:text-foreground data-[nav-active=true]:text-foreground" data-scrollspy-link-template aria-hidden="true">Template nav link</a>

							<div class="relative" data-scrollspy-end>
								<div class="absolute -left-5.5 -translate-x-1/2 rounded-full bg-background outline-2 outline-background">
									<svg class="size-6 text-foreground-soft delay-350 data-[nav-active=true]:text-accent" data-scrollspy-end-icon data-nav-active="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><path fill="currentColor" d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
								</div>

								<span class="text-foreground-subtle transition-colors data-[nav-active=true]:text-foreground" data-scrollspy-end-label>You’ve reached the end</span>
							</div>
						</nav>

						<canvas aria-hidden="true" class="pointer-events-none absolute inset-0 size-full rounded-lg" data-scrollspy-confetti-canvas></canvas>
					</div>

					{/* Host contact */}
					<div class="rounded-lg border p-6" data-card>
						<div class="flex items-start gap-6">
							<div class="w-1/3 max-w-24 shrink-0">
								<Image src="https://placehold.co/200" alt="Placeholder" class="aspect-square size-full rounded object-cover" />
							</div>
							<div>
								<h4 class="mb-2 text-lg/tight font-semibold">Lorem ipsum dolor</h4>

								<div class="prose mb-4 text-sm/normal text-foreground-muted">
									<p>Tenetur et nesciunt neque, asperiores dolorem repudian, tempora provident fugit?</p>
								</div>

								<a href="#form" class="btn btn-secondary btn-icon-right btn-sm">
									Register
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
								</a>
							</div>
						</div>
					</div>

					<!-- <div>
						<button class="btn btn-outline btn-icon-right w-full">
							Add to calendar
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="80" y1="40" x2="80" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="176" y1="40" x2="176" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><rect x="40" y="88" width="176" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
						</button>
					</div> -->
				</div>
			</aside>

			<article class="col-span-full grid gap-8 lg:col-span-8 xl:gap-12 [&_h2[id]]:scroll-mt-20">
				<div class="rounded-lg border p-6 lg:p-10" data-card data-scrollspy-content>
					<div class="prose max-w-none text-pretty lg:text-lg">
						<h2>About the event</h2>
						<p>The IP North American Litigation Summit brings together more than 500 in-house counsel, patent litigators and IP strategists to tackle complex challenges across pharma and biotech, technology and trade secrets.</p>
						<p>RWS is proud to be a Solutions sponsor. Find us at booth 3 to talk through your IP needs and see our latest innovations, tools and services designed to optimize every stage of the IP lifecycle.</p>
						<h2>Why attend</h2>
						<ul>
							<li>Tackle the toughest questions in pharma, biotech, technology and trade secrets</li>
							<li>Meet the RWS specialists at booth 3</li>
							<li>See our latest innovations and services across the IP lifecycle</li>
							<li>Network with peers managing high-stakes litigation and portfolios, lorem ipsum dolor sit amet consectetur adipisicing elit est, atque tempore voluptatibus</li>
						</ul>
					</div>
				</div>

				<div>
					<Image src="https://placehold.co/1024x768" alt="Placeholder" class="aspect-video size-full rounded object-cover" />
				</div>

				{/* Agenda timeline */}
				<div class="rounded-lg border p-6 lg:p-10" data-card data-scrollspy-content>
					<div class="mb-8">
						<h2 class="text-3xl font-bold tracking-tight">RWS on the agenda</h2>
						<p class="mt-2 text-foreground-muted">Where to catch our team during the summit.</p>
					</div>

					<ol class="relative ml-2 grid gap-8 border-l border-accent-softer pl-8">
						{
							agenda.map((item, i) => {
								const time = convertible(item.start, item.end, 'agenda')
								return (
									<li class="intersect-once relative intersect:motion-preset-slide-right-sm" style={`--motion-delay: ${200 + i * 75}ms`}>
										{/* Dot */}
										<span class={`absolute -left-[calc(2rem+1px)] -translate-x-1/2 rounded-full ring-4 ring-background ${item.highlight ? 'top-0.5 size-4 bg-accent' : 'top-1 size-3 bg-accent-soft'}`} />

										<p class="tracking-wide- tabular-nums- mb-1 text-sm font-bold text-accent" data-tz data-tz-start={time.start} data-tz-end={time.end} data-tz-format={time.format}>
											{time.value}
										</p>

										<div class={item.highlight ? 'mt-3 rounded-lg border border-accent-soft bg-accent-softest p-5' : ''}>
											{/* {item.highlight && <span class="mb-2 inline-block rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-on-accent">RWS session</span>} */}

											<h3 class="text-lg font-bold text-pretty">{item.title}</h3>
											<p class="mt-1 text-foreground-muted">{item.description}</p>

											{item.speaker && (
												<div class="mt-2 flex items-center gap-1.5 text-sm font-semibold text-foreground-muted">
													<div class="svg-current size-3 shrink-0">
														{/* <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
														<rect width="256" height="256" fill="none" />
														<circle cx="128" cy="96" r="64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
														<path d="M31,216a112,112,0,0,1,194,0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
													</svg> */}
														<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" fill="none" />
															<circle cx="12" cy="7" r="4" fill="none" />
														</svg>
													</div>
													<span>{item.speaker}</span>
												</div>
											)}
										</div>
									</li>
								)
							})
						}
					</ol>
				</div>

				{/* Speakers — this event has a single speaker */}
				<div data-scrollspy-content>
					<Speakers title="Speaker" subtitle="Meet the RWS specialist presenting at the summit." speakers={speakers} />
				</div>

				{/* Demo variants: how the Speakers grid adapts to more people */}
				<Speakers title="Speakers" subtitle="Layout variant — small group on a single row." speakers={speakersThree} />

				<div data-scrollspy-content>
					<Speakers title="RWS attendees" subtitle="Meet the RWS team at the summit." speakers={attendees} />
				</div>

				{/* Highlight quote */}
				<div class="overflow-hidden rounded-lg" data-theme="tertiary">
					<figure class="mx-auto max-w-3xl px-8 py-12 text-center lg:px-12">
						<div class="svg-current mx-auto mb-5 size-12 text-accent">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 393 285">
								<g fill="currentColor" fill-opacity=".5" clip-path="url(#a)">
									<path d="M392.995 118.048C392.995 52.851 339.942 0 274.497 0S156 52.85 156 118.048c0 65.196 53.052 118.047 118.497 118.047v48.823l81.26-80.952c22.926-21.525 37.235-52.057 37.235-85.918z"></path>
									<path d="M236.995 118.506C236.995 53.31 183.942.459 118.497.459S0 53.309 0 118.506s53.052 118.048 118.497 118.048v48.823l81.26-80.952c22.926-21.525 37.235-52.057 37.235-85.919z"></path>
								</g>
								<defs>
									<clipPath id="a">
										<path fill="#fff" d="M0 0h393v285H0z"></path>
									</clipPath>
								</defs>
							</svg>
						</div>
						<blockquote class="space-y-[0.5em] text-center text-2xl text-pretty *:first:before:content-['“'] *:last:after:content-['”']">
							<p>Come and find us at booth 3 to talk through your IP needs and see the latest tools and services designed to optimize every stage of the IP lifecycle.</p>
						</blockquote>
						<figcaption class="mt-6 flex items-center justify-center">
							<Image class="size-6 rounded-full" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/michael-gouch.png" alt="" />
							<div class="flex items-center divide-x divide-foreground-subtle">
								<div class="px-3 font-semibold">Christian Hartmann</div>
								<div class="px-3 text-foreground-muted">Senior Director of IP Solutions, RWS</div>
							</div>
						</figcaption>
					</figure>
				</div>
			</article>
		</div>
	</section>

	{/* Recommendations */}
	<section class="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20 lg:pb-20" data-theme="default">
		<div class="mx-auto max-w-screen-xl px-8 lg:px-12">
