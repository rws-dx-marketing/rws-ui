		type: 'Conference',
		href: '/events/event/',
		date: '21–22 October 2026',
		location: 'London, UK',
		name: 'Trados LIVE Content Summit',
		description: '<p>Two days of practical sessions, product deep-dives and networking for localization and content teams scaling with AI.</p>',
