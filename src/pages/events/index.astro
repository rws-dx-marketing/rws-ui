		type: 'Virtual event',
		href: '/events/webinar/',
		date: '5 November 2026',
		location: 'Online',
		name: 'The future of regulated content in Life Sciences',
		description: '<p>A virtual session exploring how life sciences teams keep regulated content compliant, accurate and on time across markets.</p>',
		filters: {
			'event-type': ['virtual-event', 'webinar'],
			'product': ['tridion'],
			'solution': ['ip-services'],
			'industry': ['life-sciences'],
			'region': ['germany'],
		},
	},
	{
		image: 'https://www.rws.com/media/dynamic/images/hallucinations_tcm228-295285.webp?original=.png&v=20260402100433',
		type: 'Trade show',
		href: '/events/event/',
		date: '18–20 November 2026',
		location: 'Tokyo, Japan',
		name: 'Global Localization Expo APAC',
		description: '<p>Meet the RWS team on the show floor to explore AI-powered language and content solutions built for the APAC market.</p>',
