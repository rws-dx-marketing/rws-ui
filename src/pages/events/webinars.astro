---
import Layout from '../../layouts/Layout.astro'
import EventsFeed from '../../blocks/EventsFeed.astro'

const cards = [
	{
		image: '/images/placeholder-1.png',
		type: 'Webinar',
		href: '/events/webinar/',
		date: '2 October 2026',
		location: 'Online',
		name: 'Accelerating the content lifecycle with GenAI',
		description: '<p>See how RWS and Congree turn GenAI from a one-off experiment into a repeatable, measurable part of content operations.</p>',
		filters: {
			product: ['language-weaver'],
			solution: ['language-platforms'],
			industry: ['technology-software'],
		},
	},
	{
		image: '/images/placeholder-1.png',
		type: 'Webinar',
		href: '/events/webinar/',
		date: '3 December 2026',
		location: 'Online',
		name: 'Building a multilingual AI knowledge base',
		description: '<p>An on-demand webinar on structuring, translating and maintaining knowledge so your AI answers correctly in every language.</p>',
		filters: {
			product: ['fonto'],
			solution: ['ai-data-services'],
			industry: ['telecommunications-it-infrastructure'],
		},
	},
	{
		image: '/images/placeholder-1.png',
		type: 'Webinar',
		href: '/events/webinar/',
		date: '28 January 2027',
		location: 'Online',
		name: 'Post-editing at scale: measuring MT quality',
		description: '<p>Practical metrics and workflows for managing machine translation post-editing across high-volume, multilingual programmes.</p>',
		filters: {
			product: ['language-weaver'],
			solution: ['language-platforms'],
			industry: ['professional-services'],
		},
	},
]
---

<Layout title="Webinars – RWS UI">
	<EventsFeed title="Webinars" description="Join us online. Register for our upcoming webinars and virtual events to see the latest in AI-powered language, content and IP solutions. Put your questions to the experts, live." active="webinars" cards={cards} filterIds={['product', 'solution', 'industry']} />
</Layout>
