---
import '../assets/styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const { title = 'RWS UI' } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<script>
			if (localStorage.getItem('color-theme') === 'dark') {
				document.documentElement.classList.add('dark')
			} else {
				document.documentElement.classList.remove('dark')
			}
		</script>
	</head>
	<body>
		<Header />

		<div id="page-shell" class="isolate origin-right bg-white transition-[translate,scale,height,width,border-radius] motion-reduce:transition-none">
			<slot />
		</div>

		<!-- <Footer /> -->

		<script src="../assets/scripts/init.client.js"></script>
		<script src="../assets/scripts/theme.client.js"></script>
		<script src="../assets/scripts/btn-magnet.js"></script>
	</body>
</html>
