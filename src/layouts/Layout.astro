---
import '../assets/styles/global.css'
import Header from '../components/Header.astro'
import SecondaryNav from '../components/SecondaryNav.astro'
import { resolveSecondaryNav } from '../utils/secondary-nav'

const { title = 'RWS UI', mode = 'light' } = Astro.props
const forcedDark = mode === 'dark'
const pathname = Astro.url.pathname
const secondaryNav = resolveSecondaryNav(pathname)
---

<!doctype html>
<html lang="en" class:list={[forcedDark && 'dark']} data-mode={forcedDark ? 'dark' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<title>{title}</title>
		<script is:inline>
			if (!document.documentElement.dataset.mode) {
				document.documentElement.classList.toggle('dark', localStorage.getItem('rws:mode') === 'dark')
			}
		</script>
	</head>
	<body>
		<Header />

		<div id="page-shell" class="isolate origin-right bg-background transition-[translate,scale,height] after:pointer-events-none after:absolute after:inset-[var(--shell-clip-top,0px)_0_var(--shell-clip-bottom,0px)] after:z-999 after:rounded-lg after:border after:border-black/10 after:opacity-0 after:transition-opacity data-menu-open:after:opacity-100 motion-reduce:transition-none motion-reduce:after:transition-none lg:transition-none dark:after:border-white/10">
			{secondaryNav ? <SecondaryNav icon={secondaryNav.icon} labelClass={secondaryNav.labelClass} breadcrumbs={secondaryNav.breadcrumbs} links={secondaryNav.links} current={secondaryNav.current} parent={secondaryNav.parent} pathname={pathname} /> : null}
			<script is:inline>
				;(function () {
					var h = document.getElementById('site-header')
					var g = document.getElementById('growler')
					var n = document.getElementById('secondary-nav')
					document.documentElement.style.setProperty('--chrome-height', (g && !g.hidden ? g.offsetHeight : 0) + (h ? h.offsetHeight : 0) + (n ? n.offsetHeight : 0) + 'px')
				})()
			</script>
			<slot />
		</div>

		<script src="../assets/scripts/init.client.js"></script>
		<script src="../assets/scripts/mode.client.js"></script>
	</body>
</html>
