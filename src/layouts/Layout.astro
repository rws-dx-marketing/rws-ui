---
import '../assets/styles/global.css'
import Header from '../components/Header.astro'
import SecondaryNav from '../components/SecondaryNav.astro'
import { resolveSecondaryNav } from '../utils/secondary-nav'

const { title = 'RWS UI' } = Astro.props
const pathname = Astro.url.pathname
const secondaryNav = resolveSecondaryNav(pathname)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script>
			if (localStorage.getItem('color-theme') === 'dark') {
				document.documentElement.classList.add('dark')
			} else {
				document.documentElement.classList.remove('dark')
			}
		</script>
	</head>
	<body>
		<Header />

		<div id="page-shell" class="isolate origin-right bg-white transition-[translate,scale,height] motion-reduce:transition-none lg:transition-none">
			{secondaryNav ? <SecondaryNav breadcrumbs={secondaryNav.breadcrumbs} links={secondaryNav.links} current={secondaryNav.current} parent={secondaryNav.parent} pathname={pathname} /> : null}
			<script is:inline>
				;(function () {
					var h = document.getElementById('site-header')
					var g = document.getElementById('growler')
					var n = document.getElementById('secondary-nav')
					document.documentElement.style.setProperty('--chrome-height', (g && !g.hidden ? g.offsetHeight : 0) + (h ? h.offsetHeight : 0) + (n ? n.offsetHeight : 0) + 'px')
				})()
			</script>
			<slot />
		</div>

		<script src="../assets/scripts/init.client.js"></script>
		<script src="../assets/scripts/theme.client.js"></script>
	</body>
</html>
