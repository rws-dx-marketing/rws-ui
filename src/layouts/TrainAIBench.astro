						<svg id="theme-toggle-light-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
					</button>

					<div class="hidden items-center gap-x-4.5 lg:flex">
						<div>
							<button id="desktop-my-rws-menu-button" type="button" class="flex items-center gap-1 text-sm font-semibold transition-colors hover:text-foreground-subtle aria-expanded:text-foreground-subtle" popovertarget="desktop-my-rws-menu" popovertargetaction="toggle" aria-haspopup="menu" aria-controls="desktop-my-rws-menu" style="anchor-name: --desktop-my-rws-anchor;">
								<span>My RWS</span>
								<svg class="mt-0.25 size-3 text-foreground-subtle" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="30"></polyline></svg>
							</button>

							<div id="desktop-my-rws-menu" popover="auto" role="menu" aria-labelledby="desktop-my-rws-menu-button" class="dropdown z-20 mt-2 w-60 overflow-clip rounded-lg bg-tertiary-softest p-3 shadow-lg" style="position-anchor: --desktop-my-rws-anchor; top: anchor(--site-header-anchor bottom); right: anchor(right); left: auto; position-area: unset; position-try: none;">
								<div class="rounded border border-tertiary-subtle bg-background p-3 text-foreground">
									<a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">
										<span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true"><svg class="size-4 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M168,128c0,64-40,96-40,96s-40-32-40-96,40-96,40-96S168,64,168,128Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="37.46" y1="96" x2="218.54" y2="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="37.46" y1="160" x2="218.54" y2="160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg></span>
										<span>My Account</span>
									</a>
									<a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">
										<span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true"><svg class="size-4 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M168,128c0,64-40,96-40,96s-40-32-40-96,40-96,40-96S168,64,168,128Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="37.46" y1="96" x2="218.54" y2="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="37.46" y1="160" x2="218.54" y2="160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg></span>
										<span>Technical support</span>
									</a>
									<a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">
										<span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true"><svg class="size-4 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M168,128c0,64-40,96-40,96s-40-32-40-96,40-96,40-96S168,64,168,128Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="37.46" y1="96" x2="218.54" y2="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="37.46" y1="160" x2="218.54" y2="160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg></span>
										<span>Training &amp; certification</span>
									</a>
									<a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">
										<span class="inline-flex size-4 shrink-0 items-center justify-center" aria-hidden="true"><svg class="size-4 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></circle><path d="M168,128c0,64-40,96-40,96s-40-32-40-96,40-96,40-96S168,64,168,128Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path><line x1="37.46" y1="96" x2="218.54" y2="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="37.46" y1="160" x2="218.54" y2="160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg></span>
										<span>Professional services</span>
									</a>
								</div>
							</div>
						</div>

						<div>
							<button id="desktop-language-menu-button" type="button" class="flex items-center gap-1 text-sm font-semibold transition-colors hover:text-foreground-subtle aria-expanded:text-foreground-subtle" popovertarget="desktop-language-menu" popovertargetaction="toggle" aria-haspopup="menu" aria-controls="desktop-language-menu" style="anchor-name: --desktop-language-anchor;">
								<span class="sr-only">Language</span>
								<span>EN</span>
								<svg class="mt-0.25 size-3 text-foreground-subtle" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="30"></polyline></svg>
							</button>

							<div id="desktop-language-menu" popover="auto" role="menu" aria-labelledby="desktop-language-menu-button" class="dropdown z-20 mt-2 w-32 overflow-clip rounded-lg bg-tertiary-softest p-3 shadow-lg" style="position-anchor: --desktop-language-anchor; top: anchor(--site-header-anchor bottom); right: anchor(right); left: auto; position-area: unset; position-try: none;">
								<div class="rounded border border-tertiary-subtle bg-background p-3 text-foreground">
									<a href="#" role="menuitem" aria-label="English" lang="en-gb" class="block rounded-md bg-tertiary-softer px-2 py-1.5 text-sm font-semibold transition-colors hover:bg-tertiary-soft">English</a>
									<a href="#" role="menuitem" aria-label="Deutsch" lang="de-de" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">Deutsch</a>
									<a href="#" role="menuitem" aria-label="Français" lang="fr-fr" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">Français</a>
									<a href="#" role="menuitem" aria-label="Español" lang="es-ES" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">Español</a>
									<a href="#" role="menuitem" aria-label="Italiano" lang="it-it" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">Italiano</a>
									<a href="#" role="menuitem" aria-label="简体中文" lang="zh-CN" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">简体中文</a>
									<a href="#" role="menuitem" aria-label="繁體中文" lang="zh-TW" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">繁體中文</a>
									<a href="#" role="menuitem" aria-label="日本語" lang="ja-JP" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">日本語</a>
									<a href="#" role="menuitem" aria-label="한국어" lang="ko-KR" class="block rounded-md px-2 py-1.5 text-sm transition-colors hover:bg-tertiary-soft">한국어</a>
								</div>
							</div>
						</div>
					</div>

					<button id="search-toggle" type="button" class="btn btn-ghost stars group btn-sm size-8.75 hover:bg-gray-100">
						<span class="sr-only">Search</span>
						<svg class="size-5 lg:size-4.5" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 18">
							<path d="M11.256 11.256a.844.844 0 0 1 1.193 0l3.898 3.897a.844.844 0 0 1-1.194 1.194l-3.897-3.898a.844.844 0 0 1 0-1.193"></path>
							<path d="M12.656 7.875a4.781 4.781 0 1 0-9.562 0 4.781 4.781 0 0 0 9.562 0m1.688 0a6.469 6.469 0 1 1-12.938 0 6.469 6.469 0 0 1 12.938 0"></path>
							<path class="fill-primary stroke-white stroke-4 transition-colors group-hover:stroke-gray-100" d="M10.33 0c.27 0 .518.158.633.403l.373.8c.264.566.718 1.02 1.283 1.283l.8.374a.699.699 0 0 1 0 1.266l-.8.374a2.65 2.65 0 0 0-1.283 1.283l-.373.8a.699.699 0 0 1-1.266 0l-.374-.8A2.65 2.65 0 0 0 8.04 4.5l-.8-.374a.699.699 0 0 1 0-1.266l.8-.374a2.65 2.65 0 0 0 1.283-1.283l.374-.8A.7.7 0 0 1 10.33 0"></path>
							<path class="fill-secondary stroke-white stroke-4 transition-colors group-hover:stroke-gray-100" d="M15.737 3.493a.45.45 0 0 1 .409.26l.24.516c.17.365.464.658.829.828l.516.241a.451.451 0 0 1 0 .817l-.517.241c-.364.17-.657.463-.827.828l-.241.516a.45.45 0 0 1-.817 0l-.241-.516a1.7 1.7 0 0 0-.828-.828l-.516-.241a.451.451 0 0 1 0-.817l.516-.241c.365-.17.658-.463.828-.828l.241-.516a.45.45 0 0 1 .408-.26"></path>
						</svg>
					</button>

					<a href="/trainai-bench/register" class="btn btn-tertiary btn-sm hidden lg:block">Register</a>
				</div>
			</div>

			<div id="mobile-menu-panel" class="fixed inset-x-auto top-(--mobile-menu-top) bottom-0 left-0 z-999 w-(--mobile-menu-width) -translate-x-full overflow-clip bg-black/95 px-5 text-white lg:hidden" aria-hidden="true">
				<div class="relative h-full">
					<section data-mobile-menu-view="root" class="absolute inset-0 flex translate-x-0 scrollbar-none flex-col overflow-y-auto py-16 transition-transform">
						<nav aria-label="Mobile main navigation">
							<ul class="grid gap-y-6">
								{
									navItems.map((item) => (
										<li>
											<a href={item.href} data-mobile-focus class:list={['block text-2xl/none', isActive(item.href) ? 'text-white' : 'text-white/80']} aria-current={isActive(item.href) ? 'page' : undefined}>
												{item.label}
											</a>
										</li>
									))
								}
							</ul>
						</nav>

						<div class="mt-auto space-y-4 pt-12">
							<div class="flex items-center gap-6">
								<button type="button" data-mobile-menu-target="my-rws" class="flex items-center gap-1.5 text-base font-semibold text-white/80 transition-colors hover:text-white">
									My RWS
									<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="96 48 176 128 96 208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="22"></polyline></svg>
