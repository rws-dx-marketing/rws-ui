---
import '../assets/styles/global.css'

const { title = 'TrainAI Bench – RWS' } = Astro.props
const pathname = Astro.url.pathname

const navItems = [
	// { label: 'Home', href: '/trainai-bench' },
	{ label: 'Leaderboard', href: '/trainai-bench/leaderboard' },
	{ label: 'By language', href: '/trainai-bench/by-language' },
	{ label: 'By model', href: '/trainai-bench/by-model' },
	{ label: 'Economics', href: '/trainai-bench/economics' },
	{ label: 'Methodology', href: '/trainai-bench/methodology' },
	{ label: 'Insights', href: '/trainai-bench/insights' },
]

function isActive(href: string) {
	if (href === '/trainai-bench') return pathname === '/trainai-bench' || pathname === '/trainai-bench/'
	return pathname.startsWith(href)
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<script>
			if (localStorage.getItem('color-theme') === 'dark') {
				document.documentElement.classList.add('dark')
			} else {
				document.documentElement.classList.remove('dark')
			}
		</script>
	</head>
	<body>
		<header id="site-header" class="sticky top-(--header-top) z-50 border-b border-foreground-softest py-2.5 transition-[top] duration-300" data-theme="default" style="anchor-name: --site-header-anchor;">
			<div class="mx-auto flex max-w-screen-2xl items-center gap-x-6 px-2.5 lg:px-4.5">
				<button id="mobile-menu-toggle" type="button" class="btn btn-ghost btn-sm size-8.75 lg:hidden" aria-expanded="false" aria-controls="mobile-menu-panel" aria-label="Toggle main menu">
					<span class="sr-only">Open main menu</span>
					<span data-icon-closed>
						<svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="40" y1="64" x2="216" y2="64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="40" y1="192" x2="216" y2="192" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
					</span>
					<span data-icon-open hidden>
						<svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="200" y1="56" x2="56" y2="200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="200" y1="200" x2="56" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
					</span>
				</button>

				<div class="mx-auto flex items-center gap-3 lg:mx-0">
					<a href="/trainai-bench" class="-mt-1.25">
						<img src="https://www.rws.com/media/images/logo-rws_tcm228-236815.svg" alt="RWS" class="h-7.5" draggable="false" loading="eager" />
					</a>

					<div class="-mt-0.5 border-l-2 py-1.5 pl-3">
						<a href="/trainai-bench" class="block text-xl/none font-bold">TrainAi Bench</a>
					</div>
				</div>

				<nav class="hidden lg:block">
					<ul class="flex gap-x-4.5">
						{
							navItems.map((item) => (
								<li>
									<a href={item.href} class:list={['block text-sm font-extrabold transition-colors', isActive(item.href) ? 'text-foreground' : 'hover:text-foreground-subtle']} aria-current={isActive(item.href) ? 'page' : undefined}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="flex items-center gap-x-2 lg:ml-auto">
					<button hidden id="theme-toggle" type="button" class="btn btn-ghost btn-sm mr-2">
