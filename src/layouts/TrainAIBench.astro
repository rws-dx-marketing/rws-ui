								</button>
							</div>
							<a href="/trainai-bench/register" class="btn btn-tertiary btn-md w-full">Get started</a>
						</div>
					</section>

					<section data-mobile-menu-view="my-rws" class="pointer-events-none absolute inset-0 translate-x-[calc(100%+2rem)] scrollbar-none overflow-y-auto py-16 transition-transform">
						<div class="mb-8 flex items-center gap-3">
							<button type="button" data-mobile-menu-back class="inline-flex size-8 items-center justify-center rounded-full border border-white/15">
								<span class="sr-only">Back</span>
								<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="160 208 80 128 160 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="22"></polyline></svg>
							</button>
							<h2 class="text-2xl/none font-semibold">My RWS</h2>
