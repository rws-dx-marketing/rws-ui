---
// @ts-nocheck
import { normalizePath } from '../utils/secondary-nav'

const { breadcrumbs = [], links = [], pathname = '/', current = null, parent = null } = Astro.props
const currentPath = normalizePath(pathname)
const mobileLinksPopoverId = `secondary-nav-links-${
	currentPath
		.replace(/[^a-z0-9]+/gi, '-')
		.replace(/^-|-$/g, '')
		.toLowerCase() || 'root'
}`
const currentLabel = current?.label ?? breadcrumbs.at(-1)?.label ?? ''
const shouldRenderCurrentAsPill = Boolean(current?.href && normalizePath(breadcrumbs[0]?.href) === normalizePath(current.href))
const isLinkActive = (href) => normalizePath(href) === currentPath
---

<section id="secondary-nav" class="sticky top-(--secondary-nav-top) z-40 bg-primary text-white transition-[top] duration-300" style="anchor-name: --secondary-nav-mobile-anchor;" data-theme="primary">
	<div class="py-2.5- mx-auto max-w-screen-2xl px-4.5">
		<div class="lg:hidden">
			<div class="flex h-11 items-center justify-between gap-3">
				<div class="flex min-w-0 items-center gap-1">
					{
						parent ? (
							<a href={parent.href} class="btn btn-ghost btn-sm -ml-2 size-8 rounded-md p-0" aria-label={`Go back to ${parent.label}`}>
								<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
									<>
										<rect width="256" height="256" fill="none" />
										<polyline points="136 96 88 48 40 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
										<polyline points="232 192 88 192 88 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
									</>
								</svg>
							</a>
						) : null
					}
					{
						shouldRenderCurrentAsPill ? (
							<span class="flex w-fit items-center gap-2 rounded-md bg-primary-dark px-2 py-1 text-sm font-semibold">
								<span class="inline-flex size-4 shrink-0 items-center justify-center [&>svg]:size-full" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16">
										<path fill="#8353fd" d="M7.127 12.483h2.165a5.4 5.4 0 0 1-3.122.983A5.46 5.46 0 0 1 .9 9.416v-.002a5.5 5.5 0 0 1-.182-1.411 5.463 5.463 0 0 1 7.798-4.944q.073.034.14.07c.006 0 .012.006.017.009l.105.057q.059.028.117.065c.062.035.127.076.189.114q.114.068.219.146H7.135a.796.796 0 0 0-.792.794v7.378c0 .436.357.793.792.793z" />
										<path fill="#3e016f" d="m13.882 8-3.744 3.751q-.386.41-.849.731H7.124a.796.796 0 0 1-.792-.793V4.31c0-.436.357-.793.792-.793h2.168c.081.054.162.116.24.178q.07.055.139.114a5 5 0 0 1 .465.439L13.879 8z" />
										<path fill="#ffc700" d="M15.282 4.313v7.379a.796.796 0 0 1-.792.793h-5.2q.463-.323.848-.731l3.744-3.752-3.744-3.751q-.054-.058-.113-.117a6 6 0 0 0-.352-.322l-.137-.114a5 5 0 0 0-.241-.178h5.195c.435 0 .792.357.792.793" />
									</svg>
								</span>
								<span>{currentLabel}</span>
							</span>
						) : (
							<p class="truncate text-sm font-semibold">{currentLabel}</p>
						)
					}
				</div>

				{
					links.length ? (
						<button type="button" class="btn btn-ghost btn-sm -mr-2 size-8 rounded-md p-0" popovertarget={mobileLinksPopoverId} popovertargetaction="toggle" aria-label="Open section page links">
							<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
								<>
									<rect width="256" height="256" fill="none" />
									<polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
								</>
							</svg>
						</button>
					) : null
				}
			</div>

			{
				links.length ? (
					<div id={mobileLinksPopoverId} popover="auto" role="menu" class="dropdown px-5- z-20 w-full transform-none! overflow-clip bg-primary-darker py-3 shadow-lg sm:m-1.5 sm:w-80 sm:rounded" style="position-anchor: --secondary-nav-mobile-anchor; top: anchor(bottom); right: 0; left: auto;">
						<ul>
							{links.map((link) => {
								const isActive = isLinkActive(link.href)
								return (
									<li>
										<a href={link.href} role="menuitem" aria-current={isActive ? 'page' : undefined} class:list={['block px-5 py-2 text-sm text-white transition-colors', isActive ? 'font-semibold' : 'font-medium hover:text-primary-lighter']}>
											{link.label}
										</a>
									</li>
								)
							})}
						</ul>
					</div>
				) : null
			}
		</div>

		<div class="hidden lg:flex lg:h-11 lg:items-stretch lg:justify-between lg:gap-3">
			<nav aria-label="Breadcrumb" class="min-w-0 self-center">
				<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium">
					{
						breadcrumbs.map((item, index) => (
							<>
								<li class="min-w-0">
									{index === 0 ? (
										item.href ? (
											<a href={item.href} class="flex w-fit items-center gap-2 rounded-md px-2 py-1 text-sm font-semibold transition-colors ">
											<!-- bg-primary-dark hover:bg-primary-darker -->
												<span class="inline-flex size-4 shrink-0 items-center justify-center [&>svg]:size-full" aria-hidden="true">
													<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16">
														<path fill="#8353fd" d="M7.127 12.483h2.165a5.4 5.4 0 0 1-3.122.983A5.46 5.46 0 0 1 .9 9.416v-.002a5.5 5.5 0 0 1-.182-1.411 5.463 5.463 0 0 1 7.798-4.944q.073.034.14.07c.006 0 .012.006.017.009l.105.057q.059.028.117.065c.062.035.127.076.189.114q.114.068.219.146H7.135a.796.796 0 0 0-.792.794v7.378c0 .436.357.793.792.793z" />
														<path fill="#3e016f" d="m13.882 8-3.744 3.751q-.386.41-.849.731H7.124a.796.796 0 0 1-.792-.793V4.31c0-.436.357-.793.792-.793h2.168c.081.054.162.116.24.178q.07.055.139.114a5 5 0 0 1 .465.439L13.879 8z" />
														<path fill="#ffc700" d="M15.282 4.313v7.379a.796.796 0 0 1-.792.793h-5.2q.463-.323.848-.731l3.744-3.752-3.744-3.751q-.054-.058-.113-.117a6 6 0 0 0-.352-.322l-.137-.114a5 5 0 0 0-.241-.178h5.195c.435 0 .792.357.792.793" />
													</svg>
												</span>
												<span>{item.label}</span>
											</a>
										) : (
											<span class="flex w-fit items-center gap-2 rounded-md bg-primary-dark px-2 py-1 text-sm font-semibold">
												<span class="inline-flex size-4 shrink-0 items-center justify-center [&>svg]:size-full" aria-hidden="true">
													<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16">
														<path fill="#8353fd" d="M7.127 12.483h2.165a5.4 5.4 0 0 1-3.122.983A5.46 5.46 0 0 1 .9 9.416v-.002a5.5 5.5 0 0 1-.182-1.411 5.463 5.463 0 0 1 7.798-4.944q.073.034.14.07c.006 0 .012.006.017.009l.105.057q.059.028.117.065c.062.035.127.076.189.114q.114.068.219.146H7.135a.796.796 0 0 0-.792.794v7.378c0 .436.357.793.792.793z" />
														<path fill="#3e016f" d="m13.882 8-3.744 3.751q-.386.41-.849.731H7.124a.796.796 0 0 1-.792-.793V4.31c0-.436.357-.793.792-.793h2.168c.081.054.162.116.24.178q.07.055.139.114a5 5 0 0 1 .465.439L13.879 8z" />
														<path fill="#ffc700" d="M15.282 4.313v7.379a.796.796 0 0 1-.792.793h-5.2q.463-.323.848-.731l3.744-3.752-3.744-3.751q-.054-.058-.113-.117a6 6 0 0 0-.352-.322l-.137-.114a5 5 0 0 0-.241-.178h5.195c.435 0 .792.357.792.793" />
													</svg>
												</span>
												<span>{item.label}</span>
											</span>
										)
									) : item.href && !item.isCurrent ? (
										<a href={item.href} class="transition-colors hover:text-primary-lightest">
											{item.label}
										</a>
									) : (
										<span aria-current={item.isCurrent ? 'page' : undefined} class:list={['aria-[current=page]:font-semibold']}>
											{item.label}
										</span>
									)}
								</li>
								{index < breadcrumbs.length - 1 ? (
									<li aria-hidden="true" class="text-white/50">
										/
									</li>
								) : null}
							</>
						))
					}
				</ol>
			</nav>

			{
				links.length ? (
					<nav aria-label="Section pages" class="self-stretch">
						<ul class="flex h-full flex-wrap items-stretch gap-px">
							{links.map((link) => {
								const isActive = isLinkActive(link.href)
								return (
									<li class="flex h-full">
										<a href={link.href} aria-current={isActive ? 'page' : undefined} class:list={['py-3- flex h-full items-center px-2 text-sm font-semibold transition-colors']}>
										<!-- hover:bg-primary-dark aria-[current=page]:bg-primary-dark -->
											{link.label}
										</a>
									</li>
								)
							})}
						</ul>
					</nav>
				) : null
			}
		</div>
	</div>
</section>
