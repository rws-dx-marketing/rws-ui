---
// Section — the shared full-width marketing section wrapper.
// Centralises the vertical rhythm (spacing util) and the centred content
// container that nearly every block re-declared inline.
//
// Props:
//   theme      — visual variant passed to data-theme (default 'default')
//   top/bottom — vertical padding preset keys from utils/spacing (default 'md')
//   width      — max width of the inner container (default 'xl')
//   container  — wrap the slot in the centred container (default true)
import { spacing } from '../utils/spacing'

const { theme = 'default', top = 'md', bottom = 'md', width = 'xl', container = true, class: className, ...rest } = Astro.props

const widths = {
	sm: 'max-w-screen-sm',
	md: 'max-w-screen-md',
	lg: 'max-w-screen-lg',
	xl: 'max-w-screen-xl',
	'2xl': 'max-w-screen-2xl',
	full: 'max-w-none',
}
---

<section class:list={[spacing[top]?.top, spacing[bottom]?.bottom, className]} data-theme={theme} {...rest}>
	{
		container ? (
			<div class:list={['mx-auto px-8 lg:px-12', widths[width]]}>
				<slot />
			</div>
		) : (
			<slot />
		)
	}
</section>
