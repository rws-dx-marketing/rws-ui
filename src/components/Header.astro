<script is:inline>
	if (typeof window !== 'undefined') {
		const root = document.documentElement
		const growler = document.getElementById('growler') // or the id/class you’re using

		const updateGrowlerHeight = () => {
			if (!root || !growler) return

			// const isHidden = growler.style.display === 'none' || getComputedStyle(growler).display === 'none' || growler.hidden

			// const value = isHidden ? 0 : growler.offsetHeight
			root.style.setProperty('--popup-link', `${growler.offsetHeight}px`)
		}

		window.addEventListener('load', updateGrowlerHeight)
		window.addEventListener('resize', updateGrowlerHeight)

		// const closeBtn = growler?.querySelector('button[type="button"]')
		// closeBtn?.addEventListener('click', () => {
		// 	growler.style.display = 'none'
		// 	updateGrowlerHeight()
		// })

		if ('ResizeObserver' in window && growler) {
			const ro = new ResizeObserver(updateGrowlerHeight)
			ro.observe(growler)
		}
	}
</script>
