	<div class="max-w-screen-xl- mx-auto pr-12 pl-3 sm:pl-4 lg:px-16">
		<p class="text-sm font-medium lg:text-center">
			<!-- Text -->
			<span class="mr-2">We have launched Flowbite Blocks including over 120+ website sections!</span>

			<!-- Link -->
