//@ts-nocheck
// Raw SVG, no classes — mirrors how the markup arrives from the CMS. The
// consuming card sizes it from the wrapper via `[&_svg]:...` utilities.
//
// preserveAspectRatio isn't a CSS property, so it can't be forced from the
// wrapper — it must live on the <svg>. The CMS can't be relied on to include
// it (or the right value), so we set it here per card size: the large hero
// biases to the top-left where the chart's focal content sits; everything
// else centre-covers. (Server-side, strip any CMS-supplied value and inject
// this one the same way.)
const { name, size = 'small' } = Astro.props
const par = size === 'large' ? 'xMinYMin slice' : 'xMidYMid slice'
