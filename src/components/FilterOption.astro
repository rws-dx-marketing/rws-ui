---
const { id, type = 'checkbox', value, label, name } = Astro.props
---

<li>
	<label class="inline-flex w-full items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-accent-softer has-checked:bg-accent-softest hover:has-checked:bg-accent-softer">
		<input id={id} data-filter-input type={type} value={value} name={name} class={type === 'radio' ? 'input input-radio' : 'input input-checkbox'} />
		{label}
	</label>
</li>
