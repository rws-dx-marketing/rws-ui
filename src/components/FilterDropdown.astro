---
const { filterId, label, buttonId = `${filterId}-button`, popoverId = `${filterId}-popover` } = Astro.props
---

<div data-filter data-filter-id={filterId}>
	<button class="btn btn-outline btn-icon-right w-full rounded bg-input font-medium" id={buttonId} popovertarget={popoverId} popovertargetaction="toggle" type="button">
		<span class="flex-1 text-left">{label}</span>
		<span class="ml-1 rounded-full bg-accent/10 px-2 py-1 text-xs leading-none font-bold text-accent tabular-nums" data-filter-count hidden>0</span>
		<svg class="ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><polyline points="208 96 128 176 48 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></polyline></svg>
	</button>

	<div data-card id={popoverId} popover="auto" role="menu" aria-labelledby={buttonId} class="dropdown z-10 w-65 rounded border border-foreground/10 shadow-lg">
		<ul class="grid max-h-62 gap-px overflow-y-auto p-2 text-sm font-medium select-none" aria-labelledby={buttonId}>
			<slot />
		</ul>
		<div data-filter-clear hidden class="mx-2 border-t border-foreground/10 pt-1 pb-2">
			<button type="button" class="px-2 py-1 text-left text-sm font-semibold text-foreground/66 transition-colors hover:text-accent">Clear selected</button>
		</div>
	</div>
</div>
