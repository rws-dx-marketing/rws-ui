---
//@ts-nocheck
import Image from './Image.astro'
interface Speaker {
	name: string
	role: string
	company: string
	avatar: string
	bio?: string
	href?: string
}

interface Props {
	title?: string
	subtitle?: string
	speakers: Speaker[]
}

const { title, subtitle, speakers } = Astro.props

const count = speakers.length

// Grid adapts to the number of speakers: a single speaker gets a wide
// featured card, small groups sit on one row, larger groups wrap.
let gridClass
if (count === 1) gridClass = 'grid-cols-1'
else if (count === 2) gridClass = 'sm:grid-cols-2'
else if (count === 3) gridClass = 'sm:grid-cols-2 lg:grid-cols-3'
else if (count === 4) gridClass = 'sm:grid-cols-2 lg:grid-cols-4'
else gridClass = 'sm:grid-cols-2 lg:grid-cols-3'

const featured = count === 1
---

<div class="rounded-lg border p-6 lg:p-10" data-card>
	{
		(title || subtitle) && (
			<div class="mb-8">
				{title && <h2 class="text-3xl font-bold tracking-tight">{title}</h2>}
				{subtitle && (
					<div class="prose mt-2 text-foreground-muted">
						<p>{subtitle}</p>
					</div>
				)}
			</div>
		)
	}

	<div class={`grid gap-6 ${gridClass}`}>
		{
			speakers.map((speaker, i) => {
				// A speaker with an href becomes a fully-clickable card: the name is a
				// stretched link (span covers the whole card) and the avatar zooms on hover.
				const linked = Boolean(speaker.href)
				// Absolute hrefs are LinkedIn profiles; relative ones are internal author pages.
				const external = linked && /^https?:/.test(speaker.href)
				const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {}
				return featured ? (
					// Single speaker — wide card with bio
					<div class={`intersect-once flex flex-col gap-6 rounded-lg border p-6 sm:flex-row lg:p-8 intersect:motion-preset-slide-up-sm ${linked ? 'group relative' : ''}`} style={`--motion-delay: ${200 + i * 100}ms`}>
						<div class="size-20 shrink-0 overflow-hidden rounded-full">
							<Image src={speaker.avatar} alt={speaker.name} class={`size-20 rounded-full object-cover ${linked ? 'transition-transform duration-300 group-hover:scale-110' : ''}`} />
						</div>
						<div class="min-w-0">
							<p class="text-xl font-bold text-pretty">
								{linked ? (
									<a href={speaker.href} {...linkAttrs}>
										{speaker.name}
										{external && (
											<svg class="absolute top-4 right-4 size-5 text-foreground-soft transition-colors group-hover:text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
												{' '}
												<path fill="currentColor" fill-rule="evenodd" d="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4zm1.205 6.91a1.705 1.705 0 1 0 0-3.41a1.705 1.705 0 0 0 0 3.41M7.909 19.5V9.273H4.5V19.5h3.41Zm4.432-10.227H9.273V19.5h3.068v-6.17c.395-.642 1.077-1.33 2.045-1.33c1.364 0 1.705 1.364 1.705 2.046V19.5H19.5v-5.454c0-1.828-.797-4.773-3.75-4.773c-1.878 0-2.92.685-3.41 1.327z" clip-rule="evenodd" />{' '}
											</svg>
										)}{' '}
										{external && <span class="sr-only"> (LinkedIn, opens in a new tab)</span>}
										<span class="absolute inset-0" />
									</a>
								) : (
									speaker.name
								)}
							</p>
							<p class="text-foreground-muted">{speaker.role}</p>
							{/* <p class="font-semibold text-accent">{speaker.company}</p> */}
							{speaker.bio && <p class="mt-3 text-sm/normal text-foreground-muted">{speaker.bio}</p>}
						</div>
					</div>
				) : (
					// Group — compact centred card
					<div class={`intersect-once flex flex-col items-center rounded-lg border p-6 text-center intersect:motion-preset-slide-up-sm ${linked ? 'group relative' : ''}`} style={`--motion-delay: ${200 + i * 100}ms`}>
						<div class="mb-4 overflow-hidden rounded-full">
							<Image src={speaker.avatar} alt={speaker.name} class={`size-20 rounded-full object-cover ${linked ? 'transition-transform duration-300 group-hover:scale-110' : ''}`} />
						</div>
						<p class="text-lg font-bold text-pretty">
							{linked ? (
								<a href={speaker.href} {...linkAttrs}>
									{speaker.name}
									{external && (
										<svg class="absolute top-4 right-4 size-5 text-foreground-soft transition-colors group-hover:text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
											<path fill="currentColor" fill-rule="evenodd" d="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4zm1.205 6.91a1.705 1.705 0 1 0 0-3.41a1.705 1.705 0 0 0 0 3.41M7.909 19.5V9.273H4.5V19.5h3.41Zm4.432-10.227H9.273V19.5h3.068v-6.17c.395-.642 1.077-1.33 2.045-1.33c1.364 0 1.705 1.364 1.705 2.046V19.5H19.5v-5.454c0-1.828-.797-4.773-3.75-4.773c-1.878 0-2.92.685-3.41 1.327z" clip-rule="evenodd" />
										</svg>
									)}
									{external && <span class="sr-only"> (LinkedIn, opens in a new tab)</span>}
									<span class="absolute inset-0" />
								</a>
							) : (
								speaker.name
							)}
						</p>
						<p class="text-sm text-pretty text-foreground-muted">{speaker.role}</p>
						{/* <p class="text-sm font-semibold text-accent">{speaker.company}</p> */}
						{speaker.bio && <p class="mt-3 text-sm/normal text-foreground-muted">{speaker.bio}</p>}
					</div>
				)
			})
		}
	</div>
</div>
