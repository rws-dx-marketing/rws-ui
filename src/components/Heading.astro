---
// Heading — section/page heading with responsive size presets.
// Size keys map to utils/heading-size so headings stay consistent rather
// than hardcoding text-4xl/xl:text-5xl in every block.
//
// Props:
//   as   — heading tag (default 'h2')
//   size — preset key from utils/heading-size (default 'sm')
import { headingSize } from '../utils/heading-size'

const { as: Tag = 'h2', size = 'sm', class: className, ...rest } = Astro.props
---

<Tag class:list={['font-bold tracking-tight text-pretty', headingSize[size], className]} {...rest}>
	<slot />
</Tag>
