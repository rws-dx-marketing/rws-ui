---
// Heading — maps a size key to the responsive type scale in utils/heading-size
// so every section heading shares one source of truth. Deliberately
// unopinionated about weight/tracking/wrap/margins — pass those via `class`.
//
// Props:
//   as   — heading tag (default 'h2')
//   size — preset key from utils/heading-size (default 'sm')
import { headingSize } from '../utils/heading-size'

const { as: Tag = 'h2', size = 'sm', class: className, ...rest } = Astro.props
---

<Tag class:list={[headingSize[size], className]} {...rest}>
	<slot />
</Tag>
