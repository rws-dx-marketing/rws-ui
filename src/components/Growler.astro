---
// @ts-nocheck
const { id, message, cta, theme = 'secondary' } = Astro.props
---

<section id="growler" class="flex min-h-12 w-full items-center justify-between border-b border-foreground-softest py-2" role="region" aria-label="Announcement" data-theme={theme} data-growler-id={id}>
	<div class="mx-auto grid w-full max-w-screen-2xl grid-cols-[minmax(2.1875rem,1fr)_auto_minmax(2.1875rem,1fr)] items-center px-2.5 lg:px-4.5">
		<div class="col-start-2 flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
			<div class="text-center text-sm text-pretty">
				<p>{message}</p>
			</div>

			{
				cta && (
					<a href={cta.href} class="btn btn-secondary btn-icon-right btn-xs">
						{cta.label}
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
							<rect width="256" height="256" fill="none" />
							<line x1="40" y1="128" x2="216" y2="128" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
							<polyline points="168 80 216 128 168 176" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="24" />
						</svg>
					</a>
				)
			}
		</div>

		<button type="button" class="btn btn-ghost col-start-3 -my-2 btn-sm size-8.75 justify-self-end text-foreground-subtle hover:text-foreground xl:-mr-2.5" aria-label="Dismiss" data-growler-close>
			<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"></rect><line x1="200" y1="56" x2="56" y2="200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line><line x1="200" y1="200" x2="56" y2="56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></line></svg>
		</button>
	</div>
</section>
<!-- Runs before first paint so a dismissed growler never flashes; the chrome-height script in Layout already respects `hidden`. -->
<script is:inline>
	;(function () {
		var g = document.getElementById('growler')
		if (g && localStorage.getItem('rws:growler:' + g.dataset.growlerId)) g.hidden = true
	})()
</script>
